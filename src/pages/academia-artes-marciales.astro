---
import AcademyLandingLayout from '../components/sections/AcademyLandingLayout.astro';
---
<AcademyLandingLayout
  heroImage="/screenshots/hero-artes-marciales.jpg"
  badge="ARTES MARCIALES"
  title="Tu dojo, tu academia, tu control total"
  subtitle="Gestiona alumnos, cinturones, exámenes de grado, cobros y comunicación con padres desde un solo lugar."
  whatsappText="Hola, tengo una academia de artes marciales y quiero saber más"
  seoTitle="Software para Academia de Artes Marciales | AKDEMIApp"
  seoDescription="Gestiona tu dojo con AKDEMIApp. Cinturones, exámenes de grado, torneos, cobros y portal para alumnos. Prueba gratis."
  benefitsTitle="Beneficios Especializados para Artes Marciales"
  benefits={[
    { icon: "Award", title: "Sistema de rangos y cinturones", description: "Configura la progresión de cinturones de tu arte marcial (blanco → amarillo → negro) con requisitos por grado." },
    { icon: "FileText", title: "Control de exámenes de grado", description: "Programa exámenes, registra resultados y actualiza el rango del alumno automáticamente al aprobar." },
    { icon: "🏆", title: "Gestión de torneos y competencias", description: "Organiza torneos internos, inscribe competidores por categoría de peso y cinturón, registra resultados. (En Desarrollo)" },
    { icon: "CheckSquare", title: "Asistencia con Check-in QR", description: "Cada alumno escanea su código al entrar al dojo. Historial de asistencia automático para requisitos de examen." }
  ]}
  featuresTitle="Funcionalidades Especializadas"
  featuresSubtitle="Herramientas diseñadas por expertos que conocen el día a día de un dojo."
  features={[
    { icon: "TrendingUp", title: "Progresión de cinturones visual", description: "Cada alumno ve su cinturón actual y qué le falta para el siguiente grado. Requisitos configurables por arte marcial." },
    { icon: "Calendar", title: "Clases por arte marcial", description: "Karate, taekwondo, jiu-jitsu, judo, MMA: cada disciplina con su horario, profesor y nivel requerido." },
    { icon: "FileText", title: "Exámenes y evaluaciones", description: "Crea exámenes de grado con criterios específicos (kata, combate, técnica). Registra calificaciones con firma." },
    { icon: "Users", title: "Gestión de alumnos", description: "Ficha completa: datos personales, cinturón actual, historial de exámenes, asistencia y contacto de emergencia." },
    { icon: "DollarSign", title: "Cobros y membresías", description: "Mensualidades, paquetes trimestrales, cobro de exámenes de grado y cuotas de torneo. Recibos automáticos." },
    { icon: "🏆", title: "Eventos y torneos", description: "Calendario de competencias, inscripción por categoría, brackets y resultados. Boletos QR para espectadores." }
  ]}
  finalCtaTitle="Lleva tu Academia de Artes Marciales al Siguiente Nivel"
/>
