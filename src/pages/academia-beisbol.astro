---
import AcademyLandingLayout from '../components/sections/AcademyLandingLayout.astro';
---
<AcademyLandingLayout
  heroImage="/images/hero-mockup.png"
  badge="BÉISBOL"
  title="Tu academia de béisbol, profesional desde el día uno"
  subtitle="Gestiona jugadores, categorías, horarios, cobros y comunicación con padres desde un solo lugar."
  whatsappText="Hola, tengo una academia de béisbol y quiero saber más"
  seoTitle="Software para Academia de Béisbol | AKDEMIApp"
  seoDescription="Gestiona tu academia de béisbol con AKDEMIApp. Categorías, prácticas, torneos, cobros y portal para padres. Prueba gratis."
  benefitsTitle="Beneficios para tu Academia de Béisbol"
  benefits={[
    { icon: "Users", title: "Categorías por edad", description: "T-ball, infantil, pre-juvenil, juvenil, adulto: cada categoría con su horario, campo y entrenador." },
    { icon: "FileText", title: "Ficha completa del jugador", description: "Posición, brazo de lanzar, bateo, datos médicos, lesiones y contacto de emergencia." },
    { icon: "🏆", title: "Torneos y temporadas", description: "Inscribe equipos, lleva standings, resultados por juego y estadísticas individuales." },
    { icon: "CheckSquare", title: "Asistencia a prácticas", description: "Check-in por QR o manual. Reportes de asistencia por jugador y por equipo." }
  ]}
  featuresTitle="Funcionalidades Especializadas para Béisbol"
  featuresSubtitle="Herramientas diseñadas por expertos que conocen el día a día de una academia de béisbol."
  features={[
    { icon: "Clock", title: "Prácticas por categoría", description: "Planifica entrenamientos semanales: bateo, fildeo, pitcheo. Por grupo de edad con horario y campo." },
    { icon: "Calendar", title: "Calendario de juegos", description: "Vista mensual con prácticas, juegos amistosos y torneos. Notificaciones a jugadores y padres." },
    { icon: "Users", title: "Gestión de jugadores", description: "Ficha 360°: datos personales, posición, brazo dominante, ficha médica y evaluaciones." },
    { icon: "CheckSquare", title: "Control de equipamiento", description: "Guantes, bates, cascos, uniformes. Inventario por jugador y por equipo." },
    { icon: "DollarSign", title: "Cobros e inscripciones", description: "Mensualidades, inscripción a torneos, cuota de uniforme y equipamiento. Recibos automáticos." },
    { icon: "TrendingUp", title: "Evaluaciones deportivas", description: "Evalúa bateo, fildeo, velocidad, pitcheo y actitud. Progreso visible para padres y jugadores." }
  ]}
  finalCtaTitle="Lleva tu Academia de Béisbol al Siguiente Nivel"
/>
