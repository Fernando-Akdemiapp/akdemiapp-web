---
import AcademyLandingLayout from '../components/sections/AcademyLandingLayout.astro';
---
<AcademyLandingLayout
  heroImage="/screenshots/hero-arte.jpg"
  badge="ARTES PLÁSTICAS"
  title="Tu taller de arte, organizado para crear"
  subtitle="Gestiona alumnos, talleres, horarios, cobros y exposiciones desde un solo lugar."
  whatsappText="Hola, tengo un taller de arte y quiero saber más"
  seoTitle="Software para Academia de Arte | AKDEMIApp"
  seoDescription="Gestiona tu academia de arte con AKDEMIApp. Talleres, materiales, portafolios, cobros y exposiciones. Prueba gratis."
  benefitsTitle="Beneficios para tu Academia de Arte"
  benefits={[
    { icon: "Palette", title: "Talleres por técnica artística", description: "Pintura al óleo, acuarela, escultura, dibujo, cerámica: cada taller con materiales requeridos, horario y cupo." },
    { icon: "CheckSquare", title: "Control de materiales", description: "Inventario de materiales incluidos en la matrícula vs. materiales que el alumno debe traer. Tienda integrada." },
    { icon: "Image", title: "Portafolio digital del alumno", description: "Sube fotos de las obras de cada alumno como registro de progreso y portafolio digital." },
    { icon: "Award", title: "Exposiciones y ventas", description: "Organiza exposiciones de fin de curso, registra ventas de obras y gestiona comisiones." }
  ]}
  featuresTitle="Funcionalidades Especializadas para Arte"
  featuresSubtitle="Herramientas diseñadas por expertos que conocen el día a día de un taller de arte."
  features={[
    { icon: "Palette", title: "Talleres por técnica y nivel", description: "Talleres de 4-12 semanas organizados por técnica y nivel (iniciación, intermedio, avanzado)." },
    { icon: "Calendar", title: "Agenda de talleres", description: "Vista semanal de todos los talleres activos con horario, sala/atelier y profesor." },
    { icon: "Users", title: "Gestión de alumnos", description: "Ficha con técnicas aprendidas, nivel actual, portafolio de obras y evaluaciones del profesor." },
    { icon: "CheckSquare", title: "Inventario de materiales", description: "Pinturas, lienzos, arcilla, herramientas: control de stock y consumo por taller." },
    { icon: "DollarSign", title: "Cobros por taller", description: "Matrícula por taller individual o paquete mensual. Cobro de materiales adicionales. Recibos automáticos." },
    { icon: "Image", title: "Exposiciones", description: "Organiza muestras de fin de curso con catálogo digital de obras y registro de asistentes." }
  ]}
  finalCtaTitle="Lleva tu Academia de Arte al Siguiente Nivel"
/>
