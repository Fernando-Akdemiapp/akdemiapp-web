---
import AcademyLandingLayout from '../components/sections/AcademyLandingLayout.astro';
---
<AcademyLandingLayout
  heroImage="/images/hero-mockup.png"
  badge="BALONCESTO"
  title="Tu academia de basketball, organizada al máximo"
  subtitle="Gestiona jugadores, categorías, horarios, cobros y comunicación con padres desde un solo lugar."
  whatsappText="Hola, tengo una academia de basketball y quiero saber más"
  seoTitle="Software para Academia de Baloncesto | AKDEMIApp"
  seoDescription="Gestiona tu escuela de baloncesto con AKDEMIApp. Categorías, entrenamientos, torneos, cobros y portal para padres. Prueba gratis."
  benefitsTitle="Beneficios para tu Academia de Baloncesto"
  benefits={[
    { icon: "Users", title: "Categorías por edad y nivel", description: "Mini, infantil, juvenil, adulto: cada categoría con su horario, cancha y entrenador asignado." },
    { icon: "FileText", title: "Ficha médica y deportiva", description: "Registra datos médicos, posición de juego, estatura, lesiones y contacto de emergencia de cada jugador." },
    { icon: "🏆", title: "Torneos y ligas", description: "Inscribe equipos por categoría, lleva tabla de posiciones, resultados y estadísticas por jugador." },
    { icon: "CheckSquare", title: "Asistencia a entrenamientos", description: "Check-in por QR o manual. Reportes de asistencia por jugador y por categoría para evaluaciones." }
  ]}
  featuresTitle="Funcionalidades Especializadas para Baloncesto"
  featuresSubtitle="Herramientas diseñadas por expertos que conocen el día a día de una escuela de basketball."
  features={[
    { icon: "Clock", title: "Entrenamientos por categoría", description: "Planifica entrenamientos semanales por grupo de edad con horario, cancha y entrenador." },
    { icon: "Calendar", title: "Calendario de partidos", description: "Vista mensual con entrenamientos, partidos amistosos y torneos. Notificaciones automáticas." },
    { icon: "Users", title: "Gestión de jugadores", description: "Ficha 360°: datos personales, categoría, posición, estatura, ficha médica y asistencia." },
    { icon: "CheckSquare", title: "Control de uniformes y equipos", description: "Tallas de uniformes, balones, equipamiento. Inventario deportivo completo." },
    { icon: "DollarSign", title: "Cobros e inscripciones", description: "Mensualidades por categoría, inscripción a torneos, cuota de uniforme. Descuentos por hermanos." },
    { icon: "TrendingUp", title: "Evaluaciones deportivas", description: "Evalúa técnica, tiro, dribling, defensa y trabajo en equipo. Progreso visible para padres." }
  ]}
  finalCtaTitle="Lleva tu Academia de Baloncesto al Siguiente Nivel"
/>
