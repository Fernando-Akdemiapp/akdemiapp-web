---
import AcademyLandingLayout from '../components/sections/AcademyLandingLayout.astro';
---
<AcademyLandingLayout
  heroImage="/screenshots/hero-idiomas.jpg"
  badge="IDIOMAS Y FORMACIÓN"
  title="Software de Gestión para Academias de Formación"
  subtitle="Niveles A1-C2, clases grupales e individuales, exámenes de nivelación y certificaciones: tu centro de idiomas o formación profesionalizado."
  whatsappText="Hola, tengo una academia de idiomas y quiero saber más"
  seoTitle="Software para Academia de Formación e Idiomas | AKDEMIApp"
  seoDescription="Gestiona tu academia de Formación e idiomas con AKDEMIApp. Niveles A1-C2, exámenes, certificados, cobros y portal para alumnos. Prueba gratis."
  benefitsTitle="Beneficios para tu Academia de Idiomas o Formación"
  benefits={[
    { icon: "BookOpen", title: "Niveles estandarizados", description: "Estructura por Marco Europeo (A1, A2, B1, B2, C1, C2) o niveles propios. Exámenes de nivelación al ingreso." },
    { icon: "Users", title: "Clases grupales e individuales", description: "Gestiona grupos por nivel e idioma + clases particulares con horarios flexibles." },
    { icon: "TrendingUp", title: "Seguimiento de progreso", description: "Cada alumno ve su nivel actual, evaluaciones parciales, tareas pendientes y próximo examen." },
    { icon: "Award", title: "Certificados por nivel", description: "Emite certificados de nivel completado con horas de estudio y calificación automáticamente." }
  ]}
  featuresTitle="Funcionalidades Especializadas para Formación e Idiomas"
  featuresSubtitle="Herramientas diseñadas por expertos que conocen el día a día de un centro de idiomas y formación."
  features={[
    { icon: "Globe", title: "Clases por idioma y nivel", description: "Inglés, francés, portugués, mandarín: cada idioma con niveles, horarios y profesor asignado." },
    { icon: "FileText", title: "Exámenes de nivelación", description: "Test de ingreso para ubicar al alumno en el nivel correcto. Resultados automáticos." },
    { icon: "Users", title: "Gestión de alumnos", description: "Ficha con nivel actual, evaluaciones, asistencia y progreso por habilidad (lectura, escritura, oral)." },
    { icon: "Calendar", title: "Agenda flexible", description: "Clases grupales fijas + individuales por cita. Vista semanal por profesor y por aula." },
    { icon: "DollarSign", title: "Cobros por nivel y ciclo", description: "Mensualidad por nivel, inscripción, material didáctico, examen de certificación. Recibos automáticos." },
    { icon: "BookOpen", title: "Material y recursos", description: "Registro de libros de texto por nivel, material complementario digital y control de entrega." }
  ]}
  finalCtaTitle="Lleva tu Academia de Idiomas al Siguiente Nivel"
/>
