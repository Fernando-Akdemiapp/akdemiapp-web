---
import AcademyLandingLayout from '../components/sections/AcademyLandingLayout.astro';
---
<AcademyLandingLayout
  heroImage="/screenshots/hero-danzas.jpg"
  badge="BAILE Y DANZA"
  title="Tu academia de danza, organizada y profesional"
  subtitle="Gestiona bailarines, horarios por disciplina, recitales, cobros y comunicación con padres desde un solo lugar."
  whatsappText="Hola, tengo una academia de danza y quiero saber más"
  seoTitle="Software para Academia de Danza | AKDEMIApp"
  seoDescription="Gestiona tu academia de danza con AKDEMIApp. Clases por estilo, recitales, cobros, portal para padres y alumnos. Prueba gratis."
  benefitsTitle="Beneficios para tu Academia de Danza"
  benefits={[
    { icon: "Calendar", title: "Organiza clases por estilo de danza", description: "Ballet, contemporáneo, hip-hop, folclor, jazz: cada disciplina con su horario, profesor y sala asignada." },
    { icon: "Award", title: "Gestiona recitales y presentaciones", description: "Planifica eventos desde la venta de boletos hasta la logística de ensayos, vestuario y grupos participantes." },
    { icon: "TrendingUp", title: "Progresión visible por niveles", description: "Tus alumnos ven su avance desde principiante hasta avanzado con evaluaciones periódicas y feedback del profesor." },
    { icon: "Smartphone", title: "Portal para padres integrado", description: "Los padres de tus bailarines jóvenes ven horarios, pagos pendientes y progreso académico desde su celular." }
  ]}
  featuresTitle="Funcionalidades Especializadas para Danza"
  featuresSubtitle="Herramientas diseñadas por expertos que conocen el día a día de una academia de danza."
  features={[
    { icon: "Palette", title: "Clases por estilo de danza", description: "Crea clases de ballet, contemporáneo, hip-hop, folclor o jazz con horarios, salas y profesores asignados." },
    { icon: "Calendar", title: "Calendario visual de ensayos", description: "Vista mensual/semanal con código de colores por disciplina. Coordina ensayos para recitales sin conflictos." },
    { icon: "Users", title: "Gestión de alumnos y niveles", description: "Ficha 360° de cada bailarín con foto, nivel actual, evaluaciones, asistencia y pagos." },
    { icon: "CheckSquare", title: "Control de vestuario e inventario", description: "Registra uniformes, zapatillas y vestuario de recitales. Sabe quién tiene qué y qué falta comprar." },
    { icon: "DollarSign", title: "Cobros y mensualidades", description: "Genera cobros por mensualidad, paquete o clase individual. Recibos PDF automáticos y recordatorios de pago." },
    { icon: "Award", title: "Certificados y diplomas", description: "Emite certificados de nivel, participación en recitales o graduación automáticamente." }
  ]}
  finalCtaTitle="Lleva tu Academia de Baile al Siguiente Nivel"
/>
