---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";

const REGISTRO_URL = "https://app.akdemiapp.online/registro/academia";
const WA_DEMO = "https://wa.me/50765726078?text=Hola%2C%20quiero%20ver%20una%20demo%20de%20las%20herramientas%20exclusivas%20de%20AKDEMIApp";
const WA_FERNANDO = "https://wa.me/50765726078?text=Hola%20Fernando%2C%20quiero%20saber%20m%C3%A1s%20sobre%20AKDEMIApp";
---

<Layout
  title="Herramientas Exclusivas | AKDEMIApp"
  description="Competencias deportivas, competencias de danza y planificación de entrenamientos. Herramientas que ninguna otra plataforma para academias tiene."
>
  <Navbar />

  <main class="pt-16">

    <!-- ══════════════════════════════════════════════════════
         HERO
    ══════════════════════════════════════════════════════ -->
    <section class="bg-gradient-to-b from-[#EFF8FF] to-white py-24 px-6">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-block text-[11px] font-bold uppercase tracking-widest text-[#155D88] bg-[#EFF8FF] border border-[#155D88]/20 px-3 py-1 rounded-full mb-5">
          Herramientas Exclusivas
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-[#101828] leading-tight tracking-tight mb-5">
          Módulos Especializados
        </h1>
        <p class="text-[17px] text-gray-500 leading-relaxed mb-8 max-w-2xl mx-auto">
          Herramientas avanzadas diseñadas para academias deportivas y de danza. Se adquieren por separado como complemento a tu plan.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={REGISTRO_URL}
            class="inline-flex items-center justify-center bg-[#155D88] hover:bg-[#124e75] text-white text-[15px] font-bold px-7 py-3.5 rounded-xl shadow-lg shadow-[#155D88]/20 transition-all duration-200 w-full sm:w-auto"
          >
            Empieza gratis
          </a>
          <a
            href={WA_DEMO}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-direct="true"
            class="inline-flex items-center justify-center gap-2 bg-white hover:bg-gray-50 text-[#155D88] text-[15px] font-bold px-7 py-3.5 rounded-xl border border-[#155D88]/30 transition-all duration-200 w-full sm:w-auto"
          >
            <svg viewBox="0 0 24 24" width="17" height="17" fill="#155D88"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Agenda una demo
          </a>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
         TOOL 1 — COMPETENCIAS Y TORNEOS
    ══════════════════════════════════════════════════════ -->
    <section id="competencias-deportivas" class="py-20 px-6 bg-white" style="scroll-margin-top:72px;">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col gap-12 lg:gap-16 lg:flex-row items-start">

          <!-- Image left -->
          <div class="w-full lg:w-1/2 shrink-0 lg:sticky lg:top-24">
            <div class="rounded-2xl shadow-lg overflow-hidden border border-gray-200">
              <img
                src="/screenshots/hero-torneos.png"
                alt="Módulo de Competencias y Torneos en AKDEMIApp"
                class="w-full h-auto block"
                loading="lazy"
              />
            </div>
          </div>

          <!-- Content right -->
          <div class="w-full lg:w-1/2">
            <span class="inline-block text-[11px] font-bold uppercase tracking-widest text-[#155D88] bg-[#EFF8FF] border border-[#155D88]/20 px-3 py-1 rounded-full mb-3">
              Deportes
            </span>
            <div class="mb-4">
              <span class="inline-block bg-blue-50 text-blue-700 border border-blue-200 rounded-full px-4 py-1 text-sm">
                Disponible para: Academias de Fútbol, Basketball, Béisbol y Deportes
              </span>
            </div>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-[#101828] leading-tight tracking-tight mb-3">
              Gestión de Competencias y Torneos
            </h2>
            <p class="text-[16px] text-gray-500 leading-relaxed mb-6">
              Organiza torneos profesionales desde la inscripción de equipos hasta la entrega de premios. Fixture automático, tabla de posiciones en tiempo real, estadísticas completas y página pública compartible.
            </p>

            <!-- Format cards -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-7">
              <div class="bg-white rounded-lg p-4 border-l-4 border-[#155D88] shadow-sm border border-gray-100">
                <p class="font-semibold text-[#101828] text-[13px] mb-1">Liga (todos contra todos)</p>
                <p class="text-[12px] text-gray-500 leading-relaxed">Fixture automático con jornadas, calendario y emparejamientos.</p>
              </div>
              <div class="bg-white rounded-lg p-4 border-l-4 border-[#155D88] shadow-sm border border-gray-100">
                <p class="font-semibold text-[#101828] text-[13px] mb-1">Eliminatoria directa</p>
                <p class="text-[12px] text-gray-500 leading-relaxed">Bracket visual con cruces automáticos desde octavos hasta la final.</p>
              </div>
              <div class="bg-white rounded-lg p-4 border-l-4 border-[#155D88] shadow-sm border border-gray-100">
                <p class="font-semibold text-[#101828] text-[13px] mb-1">Grupos + Eliminatoria</p>
                <p class="text-[12px] text-gray-500 leading-relaxed">Fase de grupos con sorteo automático tipo serpiente. Los mejores clasifican a eliminatoria con cruces cruzados (1ro Grupo A vs 2do Grupo B).</p>
              </div>
            </div>

            <!-- Feature grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">

              <div class="flex gap-3">
                <div class="shrink-0 w-9 h-9 rounded-lg bg-[#EFF8FF] flex items-center justify-center">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
                    <path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
                    <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
                    <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#101828] text-[13px] mb-0.5">Fixture y calendario automático</p>
                  <p class="text-[12px] text-gray-500 leading-relaxed">Un clic genera el fixture completo con jornadas equilibradas y rotación de localía. Para eliminatorias, bracket con seeds automáticos. Para grupos, distribución y cruces internos.</p>
                </div>
              </div>

              <div class="flex gap-3">
                <div class="shrink-0 w-9 h-9 rounded-lg bg-[#EFF8FF] flex items-center justify-center">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#101828] text-[13px] mb-0.5">Tabla de posiciones en vivo</p>
                  <p class="text-[12px] text-gray-500 leading-relaxed">Puntos, goles a favor, en contra, diferencia y posición. Se actualiza automáticamente al registrar cada resultado. Desempates configurables.</p>
                </div>
              </div>

              <div class="flex gap-3">
                <div class="shrink-0 w-9 h-9 rounded-lg bg-[#EFF8FF] flex items-center justify-center">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#101828] text-[13px] mb-0.5">Página de partido con timeline</p>
                  <p class="text-[12px] text-gray-500 leading-relaxed">Registra goles con jugador y minuto, asistencias, tarjetas amarillas y rojas, cambios. Línea de tiempo visual del partido. Marcador en vivo editable.</p>
                </div>
              </div>

              <div class="flex gap-3">
                <div class="shrink-0 w-9 h-9 rounded-lg bg-[#EFF8FF] flex items-center justify-center">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#101828] text-[13px] mb-0.5">Ranking de goleadores y asistencias</p>
                  <p class="text-[12px] text-gray-500 leading-relaxed">Tres rankings separados actualizados en tiempo real: top goleadores, mejores asistidores y acumulación de tarjetas por jugador.</p>
                </div>
              </div>

              <div class="flex gap-3">
                <div class="shrink-0 w-9 h-9 rounded-lg bg-[#EFF8FF] flex items-center justify-center">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#101828] text-[13px] mb-0.5">Equipos y jugadores</p>
                  <p class="text-[12px] text-gray-500 leading-relaxed">Inscribe equipos por categoría (Sub-8 a Libre). Asigna colores y escudos. Cada jugador vinculado a su perfil de alumno con historial completo.</p>
                </div>
              </div>

              <div class="flex gap-3">
                <div class="shrink-0 w-9 h-9 rounded-lg bg-[#EFF8FF] flex items-center justify-center">
                  <!-- Layout -->
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                    <line x1="3" y1="9" x2="21" y2="9"/>
                    <line x1="9" y1="21" x2="9" y2="9"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#101828] text-[13px] mb-0.5">Dashboard en tiempo real</p>
                  <p class="text-[12px] text-gray-500 leading-relaxed">Donut de partidos jugados vs total, goles totales, tarjetas, equipos inscritos. Gráfico de goles por jornada. Top 5 goleadores. Feed de últimos resultados y próximos partidos.</p>
                </div>
              </div>

              <div class="flex gap-3">
                <div class="shrink-0 w-9 h-9 rounded-lg bg-[#EFF8FF] flex items-center justify-center">
                  <!-- GitBranch -->
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="6" y1="3" x2="6" y2="15"/>
                    <circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/>
                    <path d="M18 9a9 9 0 0 1-9 9"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#101828] text-[13px] mb-0.5">Bracket visual de eliminatorias</p>
                  <p class="text-[12px] text-gray-500 leading-relaxed">Vista de llaves con rondas etiquetadas (Octavos, Cuartos, Semifinal, Final). Ganadores resaltados. Click en cualquier partido para ver detalle.</p>
                </div>
              </div>

              <div class="flex gap-3">
                <div class="shrink-0 w-9 h-9 rounded-lg bg-[#EFF8FF] flex items-center justify-center">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#101828] text-[13px] mb-0.5">Clasificación grupos a eliminatoria</p>
                  <p class="text-[12px] text-gray-500 leading-relaxed">Botón automático que clasifica a los mejores equipos de cada grupo a la eliminatoria con cruces cruzados estilo UEFA/FIFA.</p>
                </div>
              </div>

              <div class="flex gap-3">
                <div class="shrink-0 w-9 h-9 rounded-lg bg-[#EFF8FF] flex items-center justify-center">
                  <!-- FileText -->
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="16" y1="13" x2="8" y2="13"/>
                    <line x1="16" y1="17" x2="8" y2="17"/>
                    <polyline points="10 9 9 9 8 9"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#101828] text-[13px] mb-0.5">5 reportes descargables</p>
                  <p class="text-[12px] text-gray-500 leading-relaxed">Tabla de posiciones PDF, fixture completo PDF, estadísticas del torneo PDF, acta de partido PDF, equipos y estadísticas individuales Excel.</p>
                </div>
              </div>

            </div>
            <p class="text-sm text-gray-400 italic mt-6">Este módulo se adquiere por separado. Consulta precios.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
         TOOL 2 — COMPETENCIAS DE DANZA
    ══════════════════════════════════════════════════════ -->
    <section id="competencias-danza" class="py-20 px-6 bg-[#F8FAFC]" style="scroll-margin-top:72px;">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col gap-12 lg:gap-16 lg:flex-row-reverse items-start">

          <!-- Image right -->
          <div class="w-full lg:w-1/2 shrink-0 lg:sticky lg:top-24">
            <div class="rounded-2xl shadow-lg overflow-hidden border border-gray-200">
              <img
                src="/screenshots/hero-danza-competencia.png"
                alt="Módulo de Competencias de Danza en AKDEMIApp"
                class="w-full h-auto block"
                loading="lazy"
              />
            </div>
          </div>

          <!-- Content left -->
          <div class="w-full lg:w-1/2">
            <span class="inline-block text-[11px] font-bold uppercase tracking-widest text-[#155D88] bg-[#EFF8FF] border border-[#155D88]/20 px-3 py-1 rounded-full mb-3">
              Danza y Artes
            </span>
            <div class="mb-4">
              <span class="inline-block bg-pink-50 text-pink-700 border border-pink-200 rounded-full px-4 py-1 text-sm">
                Disponible para: Academias de Danza, Ballet y Artes Escénicas
              </span>
            </div>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-[#101828] leading-tight tracking-tight mb-3">
              Competencias de Danza y Artes Escénicas
            </h2>
            <p class="text-[16px] text-gray-500 leading-relaxed mb-6">
              Sistema profesional de evaluación por jueces con criterios configurables, gestión de música con archivos reales, clasificaciones en vivo y herramientas para todo el equipo del evento.
            </p>

            <!-- Format cards -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-7">
              <div class="bg-white rounded-lg p-4 border-l-4 border-[#155D88] shadow-sm border border-gray-100">
                <p class="font-semibold text-[#101828] text-[13px] mb-1">Solo</p>
                <p class="text-[12px] text-gray-500 leading-relaxed">Cada participante actúa individualmente y es evaluado por el panel de jueces.</p>
              </div>
              <div class="bg-white rounded-lg p-4 border-l-4 border-[#155D88] shadow-sm border border-gray-100">
                <p class="font-semibold text-[#101828] text-[13px] mb-1">Grupo</p>
                <p class="text-[12px] text-gray-500 leading-relaxed">Equipos o compañías se presentan como conjunto con una coreografía.</p>
              </div>
              <div class="bg-white rounded-lg p-4 border-l-4 border-[#155D88] shadow-sm border border-gray-100">
                <p class="font-semibold text-[#101828] text-[13px] mb-1">Battle</p>
                <p class="text-[12px] text-gray-500 leading-relaxed">Enfrentamientos directos uno a uno con evaluación de jueces y eliminación progresiva hasta la final. Bracket automático con seeds.</p>
              </div>
            </div>

            <!-- Feature grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">

              <div class="flex gap-3">
                <div class="shrink-0 w-9 h-9 rounded-lg bg-[#EFF8FF] flex items-center justify-center">
                  <!-- Tablet -->
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="16" height="20" x="4" y="2" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#101828] text-[13px] mb-0.5">Panel de jueces en tablet</p>
                  <p class="text-[12px] text-gray-500 leading-relaxed">Enlace único por juez. Criterios configurables de 0 a 10 con incrementos de 0.5. Modo oscuro para jornadas largas. Texto ajustable. Foto del participante en pantalla.</p>
                </div>
              </div>

              <div class="flex gap-3">
                <div class="shrink-0 w-9 h-9 rounded-lg bg-[#EFF8FF] flex items-center justify-center">
                  <!-- Music -->
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#101828] text-[13px] mb-0.5">Música con archivos reales</p>
                  <p class="text-[12px] text-gray-500 leading-relaxed">Los participantes suben su pista (MP3, WAV, M4A — hasta 20MB) al inscribirse. Reproductor integrado para verificar antes del evento.</p>
                </div>
              </div>

              <div class="flex gap-3">
                <div class="shrink-0 w-9 h-9 rounded-lg bg-[#EFF8FF] flex items-center justify-center">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#101828] text-[13px] mb-0.5">Clasificación en vivo con medallas</p>
                  <p class="text-[12px] text-gray-500 leading-relaxed">Ranking con 🥇🥈🥉 actualizado en tiempo real. Desglose por juez con puntaje individual, no solo promedio. Transparencia total.</p>
                </div>
              </div>

              <div class="flex gap-3">
                <div class="shrink-0 w-9 h-9 rounded-lg bg-[#EFF8FF] flex items-center justify-center">
                  <!-- Monitor -->
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="20" height="14" x="2" y="3" rx="2"/>
                    <line x1="8" y1="21" x2="16" y2="21"/>
                    <line x1="12" y1="17" x2="12" y2="21"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#101828] text-[13px] mb-0.5">Modo proyección</p>
                  <p class="text-[12px] text-gray-500 leading-relaxed">Pantalla completa con fondo oscuro, texto extra grande y auto-actualización cada 15 segundos. Diseñado para proyectar en pantalla grande durante el evento.</p>
                </div>
              </div>

              <div class="flex gap-3">
                <div class="shrink-0 w-9 h-9 rounded-lg bg-[#EFF8FF] flex items-center justify-center">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-[#101828] text-[13px] mb-0.5">Avance entre rondas</p>
