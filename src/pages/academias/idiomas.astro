    { icon: "FileText", title: "Evaluaciones de nivel", description: "PDF a digital. Profesor evalúa, alumno ve resultado en portal." },
    { icon: "DollarSign", title: "Cobros flexibles", description: "Mensualidades, ciclos trimestrales, paquetes de conversación." },
    { icon: "Smartphone", title: "Portal del alumno", description: "Nivel actual, horario, pagos y evaluaciones desde el celular." },
    { icon: "Award", title: "Certificados digitales", description: "Certificados por nivel con nombre, fecha y firma. Descarga desde portal." }
  ]}
