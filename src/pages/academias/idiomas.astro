---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";

const REGISTRO_URL = "/registro";
const DEMO_WA = "https://wa.me/50765726078?text=Hola%2C%20tengo%20una%20escuela%20de%20idiomas%20y%20quiero%20saber%20m%C3%A1s";

interface Feature {
  id: string;
  title: string;
  description: string;
  benefits: string[];
  imageLeft: boolean;
  image: string;
}

const features: Feature[] = [
  {
    id: "alumnos",
    title: "Alumnos por nivel e idioma",
    description: "Organiza tus alumnos por idioma (Inglés, Francés, etc.) y nivel (A1 a C2). Ficha completa con historial de niveles cursados.",
    benefits: [
      "Organización por idioma: Inglés, Francés, Portugués, Mandarín y más",
      "Nivel MCER de A1 a C2 por alumno",
      "Historial completo de niveles completados",
      "Ficha con datos y contacto de emergencia",
    ],
    imageLeft: false,
    image: "/screenshots/alumnos.png",
  },
  {
    id: "horarios",
    title: "Grupos y horarios por nivel",
    description: "Cada grupo tiene su idioma, nivel, profesor y horario. Vista de calendario con colores por idioma.",
    benefits: [
      "Cada grupo con su idioma, nivel, profesor y sala",
      "Colores por idioma en el calendario semanal",
      "Detección automática de conflictos de horario",
      "Cambio de nivel o grupo con un clic",
    ],
    imageLeft: true,
    image: "/screenshots/calendario.png",
  },
  {
    id: "evaluaciones",
    title: "Evaluaciones de nivel",
    description: "Sube tu examen de colocación o de avance en PDF. El profesor evalúa digitalmente y el alumno ve su resultado en el portal.",
    benefits: [
      "Sube tu formato de examen en PDF",
      "El profesor evalúa y firma digitalmente",
      "El alumno ve su nota y feedback en el portal",
      "Historial de evaluaciones por nivel y ciclo",
    ],
    imageLeft: false,
    image: "/screenshots/evaluaciones.png",
  },
  {
    id: "cobros",
    title: "Cobros flexibles",
    description: "Mensualidades, ciclos trimestrales, paquetes de conversación, material incluido o separado. Recordatorios por WhatsApp.",
    benefits: [
      "Mensualidades o ciclos trimestrales",
      "Material didáctico incluido o facturado por separado",
      "Recordatorios automáticos antes del vencimiento",
      "Recibos digitales con detalle del ciclo y nivel",
    ],
    imageLeft: true,
    image: "/screenshots/cobros.png",
  },
  {
    id: "portal-alumno",
    title: "Portal del alumno",
    description: "Cada alumno ve su nivel actual, horario, pagos y evaluaciones. Los adultos gestionan su propio perfil.",
    benefits: [
      "Nivel actual y próximo grupo disponible",
      "Horario de clases y evaluaciones pendientes",
      "Historial de pagos y recibos descargables",
      "Acceso web y móvil sin instalar nada",
    ],
    imageLeft: false,
    image: "/screenshots/portal-alumno.png",
  },
  {
    id: "certificados",
    title: "Certificados digitales",
    description: "Genera certificados de nivel completado con nombre, fecha y firma digital. El alumno lo descarga desde su portal.",
    benefits: [
      "Certificados con nombre, nivel y fecha",
      "Firma digital del director o coordinador",
      "El alumno lo descarga en PDF desde su portal",
      "Comparte fácilmente en LinkedIn o por correo",
    ],
    imageLeft: true,
    image: "/screenshots/certificado.jpg",
  },
];
---

<Layout
  title="Software para Escuelas de Idiomas | AKDEMIApp"
  description="Gestiona tu escuela de idiomas con AKDEMIApp. Control de alumnos por nivel, horarios, cobros, asistencia y evaluaciones. Inglés, francés, mandarín y más. 14 días gratis."
>
  <Navbar />

  <main>

    <!-- ── 1. HERO ── -->
    <section class="relative overflow-hidden bg-gradient-to-b from-[#EFF8FF] via-[#f5faff] to-white pt-20 pb-20">
      <div class="absolute top-0 left-0 w-[500px] h-[500px] bg-[#B9E0FB] rounded-full filter blur-[100px] opacity-20 -translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-[#399ABE] rounded-full filter blur-[100px] opacity-10 translate-x-1/3 -translate-y-1/3 pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl mx-auto px-6 text-center">
        <div class="inline-flex items-center gap-1.5 bg-[#EFF8FF] border border-[#B9E0FB] text-[#155D88] text-xs font-bold px-3.5 py-1.5 rounded-full mb-7 tracking-widest uppercase">
          Escuelas de Idiomas
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-[3.4rem] font-extrabold text-[#101828] leading-[1.08] tracking-[-0.03em] mb-5">
          Tu escuela de idiomas, sin caos administrativo
        </h1>

        <p class="text-lg sm:text-xl text-gray-500 font-normal leading-relaxed max-w-2xl mx-auto mb-10">
          Gestiona alumnos por nivel, horarios, cobros y progreso desde un solo lugar. Inglés, francés, portugués, mandarín y cualquier idioma.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={REGISTRO_URL}
            class="flex items-center gap-2.5 bg-[#155D88] hover:bg-[#124e75] text-white font-semibold text-[15px] px-7 py-3.5 rounded-xl shadow-lg shadow-[#155D88]/25 transition-all duration-200 hover:-translate-y-0.5 w-full sm:w-auto justify-center"
          >
            Empieza gratis
          </a>
          <a
            href={DEMO_WA}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-direct="true"
            class="flex items-center gap-2 bg-white hover:bg-gray-50 text-gray-700 font-medium text-[15px] px-6 py-3.5 rounded-xl border border-gray-200 transition-all duration-200 w-full sm:w-auto justify-center"
          >
            Agenda una demo
          </a>
        </div>
      </div>
    </section>

    <!-- ── 2. PAIN POINTS ── -->
    <section class="bg-white py-20 px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#101828] text-center mb-12 tracking-tight">
          ¿Te suena familiar?
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

          <!-- Clock -->
          <div class="flex gap-4 items-start bg-[#F8FAFC] rounded-2xl p-6 border border-gray-100">
            <div class="shrink-0 w-10 h-10 rounded-xl bg-[#EFF8FF] flex items-center justify-center">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <p class="text-[15px] text-gray-700 leading-relaxed">
              Organizar grupos por nivel (A1, A2, B1, B2) y horarios sin que se crucen
            </p>
          </div>

          <!-- MessageCircle -->
          <div class="flex gap-4 items-start bg-[#F8FAFC] rounded-2xl p-6 border border-gray-100">
            <div class="shrink-0 w-10 h-10 rounded-xl bg-[#EFF8FF] flex items-center justify-center">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
            </div>
            <p class="text-[15px] text-gray-700 leading-relaxed">
              Alumnos preguntando en qué nivel están y cuándo es su próximo examen
            </p>
          </div>

          <!-- DollarSign -->
          <div class="flex gap-4 items-start bg-[#F8FAFC] rounded-2xl p-6 border border-gray-100">
            <div class="shrink-0 w-10 h-10 rounded-xl bg-[#EFF8FF] flex items-center justify-center">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
              </svg>
            </div>
            <p class="text-[15px] text-gray-700 leading-relaxed">
              Cobrar mensualidades, material didáctico y exámenes de certificación
            </p>
          </div>

          <!-- Users -->
          <div class="flex gap-4 items-start bg-[#F8FAFC] rounded-2xl p-6 border border-gray-100">
            <div class="shrink-0 w-10 h-10 rounded-xl bg-[#EFF8FF] flex items-center justify-center">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
            <p class="text-[15px] text-gray-700 leading-relaxed">
              Manejar alumnos que cambian de nivel o de horario a mitad de ciclo
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- ── 3. FEATURES ── -->
    <section class="py-6 px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#101828] text-center mb-4 tracking-tight">
          Todo lo que tu escuela de idiomas necesita
        </h2>
      </div>
    </section>

    {features.map((feature, index) => (
      <section
        id={feature.id}
        class={`py-20 px-6 ${index % 2 === 0 ? "bg-white" : "bg-[#F8FAFC]"}`}
      >
        <div class="max-w-6xl mx-auto">
          <div class={`flex flex-col gap-12 lg:gap-16 lg:flex-row items-center ${feature.imageLeft ? "" : "lg:flex-row-reverse"}`}>

            <!-- Screenshot -->
            <div class="w-full lg:w-1/2 shrink-0">
              <img
                src={feature.image}
                alt={feature.title}
                class="rounded-2xl border border-gray-200 w-full"
              />
            </div>

            <!-- Text -->
            <div class="w-full lg:w-1/2">
              <h2 class="text-3xl sm:text-4xl font-extrabold text-[#101828] leading-tight tracking-tight mb-4">
                {feature.title}
              </h2>
              <p class="text-[16px] text-gray-500 leading-relaxed mb-8">
                {feature.description}
              </p>
              <ul class="space-y-3">
                {feature.benefits.map((benefit) => (
                  <li class="flex items-center gap-3">
                    <span class="shrink-0 w-5 h-5 rounded-full bg-[#EFF8FF] flex items-center justify-center">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                    </span>
                    <span class="text-[15px] text-gray-700 font-medium">{benefit}</span>
                  </li>
                ))}
              </ul>
            </div>

          </div>
        </div>
      </section>
    ))}

    <!-- ── 4. CTA ── -->
    <section class="bg-[#101828] py-24 px-6">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4 tracking-tight">
          ¿Lista para profesionalizar tu escuela de idiomas?
        </h2>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-5">
          <a
            href={REGISTRO_URL}
            class="flex items-center gap-2.5 bg-[#399ABE] hover:bg-[#2e87ab] text-white font-semibold text-[15px] px-7 py-3.5 rounded-xl shadow-lg shadow-[#399ABE]/25 transition-all duration-200 hover:-translate-y-0.5 w-full sm:w-auto justify-center"
          >
            Empieza gratis
          </a>
          <a
            href={DEMO_WA}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-direct="true"
            class="flex items-center gap-2 bg-white/10 hover:bg-white/15 text-white font-medium text-[15px] px-6 py-3.5 rounded-xl border border-white/20 transition-all duration-200 w-full sm:w-auto justify-center"
          >
            Hablar por WhatsApp
          </a>
        </div>
        <p class="text-gray-500 text-xs">14 días gratis · Sin tarjeta de crédito</p>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
