---
import AcademyLandingLayout from '../../components/sections/AcademyLandingLayout.astro';
---
<AcademyLandingLayout
  badge="FORMACIÓN Y CAPACITACIÓN"
  title="Tu centro de formación, digitalizado y eficiente"
  subtitle="Gestiona cursos, talleres, alumnos, cobros y certificados desde un solo lugar. Ofimática, diseño, programación, emprendimiento y más."
  whatsappText="Hola%2C%20tengo%20un%20centro%20de%20formación%20y%20quiero%20saber%20más"
  seoTitle="Software para Centros de Formación y Capacitación | AKDEMIApp"
  seoDescription="Gestiona tu centro de formación con AKDEMIApp. Cursos, talleres, alumnos, cobros, certificados y comunicación. 14 días gratis."
  benefitsTitle="Beneficios Especializados para Centros de Formación"
  benefits={[
    { icon: "Calendar", title: "Cursos con fecha y duración", description: "Crea cursos con inicio, fin, profesor y cupo máximo. Vista de calendario con todos los talleres activos." },
    { icon: "Users", title: "Alumnos multi-curso", description: "Cada alumno inscrito en uno o varios cursos con historial de completados y certificados obtenidos." },
    { icon: "Award", title: "Certificados digitales", description: "Genera certificados personalizados con nombre, curso, fecha y firma digital al completar." },
    { icon: "FileText", title: "Inscripción online", description: "Formulario web que captura interesados directo al CRM. Se inscriben solos sin llamarte." }
  ]}
  featuresTitle="Funcionalidades Especializadas"
  featuresSubtitle="Herramientas diseñadas para centros de formación y capacitación."
  features={[
    { icon: "BookOpen", title: "Cursos y talleres organizados", description: "Fecha de inicio, duración, profesor, cupo. Cursos recurrentes o de duración fija." },
    { icon: "Users", title: "Alumnos por curso", description: "Ficha completa con historial de cursos, certificados y datos actualizados." },
    { icon: "DollarSign", title: "Cobros por curso o mensualidad", description: "Inscripción + mensualidades, pago único por taller, o paquetes con descuento." },
    { icon: "CheckSquare", title: "Control de asistencia", description: "Registra asistencia por sesión. Requisito mínimo para obtener certificado." },
    { icon: "Award", title: "Certificados digitales", description: "Certificados con nombre, curso y firma. El alumno descarga desde su portal." },
    { icon: "Globe", title: "Formulario de inscripción online", description: "Link compartible. Los interesados se registran y aparecen en tu CRM." }
  ]}
  finalCtaTitle="Lleva tu Centro de Formación al Siguiente Nivel"
/>
