---
import AcademyLandingLayout from '../../components/sections/AcademyLandingLayout.astro';
---
<AcademyLandingLayout
  heroImage="/screenshots/hero-artes-escenicas.jpg"
  badge="ARTES ESCÉNICAS"
  title="Tu academia de artes escénicas, en escena y organizada"
  subtitle="Gestiona alumnos, ensayos, montajes, cobros y comunicación desde un solo lugar. Teatro, actuación, teatro musical, comedia y más."
  whatsappText="Hola%2C%20tengo%20una%20academia%20de%20artes%20esc%C3%A9nicas%20y%20quiero%20saber%20m%C3%A1s"
  seoTitle="Software para Academias de Artes Escénicas | AKDEMIApp"
  seoDescription="Gestiona tu academia de teatro, actuación o artes escénicas con AKDEMIApp. Control de alumnos, montajes, ensayos, cobros y comunicación. 14 días gratis."
  benefitsTitle="Beneficios Especializados para Artes Escénicas"
  benefits={[
    { icon: "Calendar", title: "Ensayos y montajes organizados", description: "Planifica ensayos por obra, asigna horarios por elenco y lleva el calendario de presentaciones." },
    { icon: "Users", title: "Elenco por producción", description: "Asigna actores a cada montaje con su personaje, horarios de ensayo y disponibilidad." },
    { icon: "Star", title: "Evaluaciones de casting", description: "Evalúa audiciones digitalmente con criterios configurables. Resultados visibles en el portal." },
    { icon: "Globe", title: "Página web con cartelera", description: "Crea el sitio de tu academia con cartelera de funciones, formulario de contacto y venta de boletos." }
  ]}
  featuresTitle="Funcionalidades Especializadas"
  featuresSubtitle="Herramientas diseñadas para academias de teatro y artes escénicas."
  features={[
    { icon: "Users", title: "Alumnos por disciplina escénica", description: "Actuación, improvisación, teatro musical, expresión corporal. Ficha completa por alumno." },
    { icon: "Calendar", title: "Calendario de ensayos y funciones", description: "Ensayos por elenco con colores por producción. Fechas de estreno y funciones en el calendario." },
    { icon: "DollarSign", title: "Cobros por taller o temporada", description: "Mensualidades, talleres intensivos, cursos de verano. Recordatorios automáticos." },
    { icon: "CheckSquare", title: "Asistencia a ensayos", description: "Registra quién asistió a cada ensayo. Detecta ausencias que afectan la producción." },
    { icon: "Smartphone", title: "Portal del alumno", description: "Cada actor ve sus ensayos, horarios, pagos y evaluaciones desde su celular." },
    { icon: "MessageCircle", title: "Comunicación por elenco", description: "Envía avisos solo al elenco de una producción específica. Cambios de ensayo sin confusión." }
  ]}
  finalCtaTitle="Lleva tu Academia de Artes Escénicas al Siguiente Nivel"
/>
