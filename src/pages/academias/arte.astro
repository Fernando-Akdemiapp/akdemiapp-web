    { icon: "DollarSign", title: "Cobros por taller o mensualidad", description: "Mensualidades, talleres intensivos, paquetes. Materiales incluidos o aparte." },
    { icon: "CheckSquare", title: "Asistencia por sesión", description: "Registra quién vino. Detecta alumnos que pierden interés." },
    { icon: "Smartphone", title: "Portal del alumno", description: "Talleres inscritos, horarios, pagos y evaluaciones desde el celular." },
