---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";

const REGISTRO_URL = "/registro";
const DEMO_WA = "https://wa.me/50765726078?text=Hola%2C%20tengo%20un%20centro%20de%20tutor%C3%ADas%20y%20quiero%20saber%20m%C3%A1s";

interface Feature {
  id: string;
  title: string;
  description: string;
  benefits: string[];
  imageLeft: boolean;
  image: string;
}

const features: Feature[] = [
  {
    id: "alumnos",
    title: "Alumnos por materia y nivel",
    description: "Organiza tus alumnos por la materia que refuerzan y su nivel. Ficha completa con datos, contacto de padres y progreso.",
    benefits: [
      "Agrupa por materia: Matemáticas, Inglés, Ciencias y más",
      "Nivel educativo: primaria, secundaria, bachillerato",
      "Ficha completa con datos y contacto de padres",
      "Historial de temas cubiertos en cada sesión",
    ],
    imageLeft: false,
    image: "/screenshots/alumnos.png",
  },
  {
    id: "horarios",
    title: "Horarios flexibles",
    description: "Clases individuales o grupales, por hora o por bloque. Vista semanal con colores por materia para que nunca se crucen horarios.",
    benefits: [
      "Sesiones individuales o grupos pequeños",
      "Vista semanal con colores por materia",
      "Conflictos de horario detectados automáticamente",
      "Clases por hora o por bloque de tiempo",
    ],
    imageLeft: true,
    image: "/screenshots/calendario.png",
  },
  {
    id: "cobros",
    title: "Cobros por hora, paquete o mes",
    description: "Mensualidades fijas, paquetes de horas o cobro por sesión. Recordatorios automáticos por WhatsApp.",
    benefits: [
      "Mensualidades fijas o cobro por sesión individual",
      "Paquetes de horas prepagadas con saldo visible",
      "Recordatorios automáticos por WhatsApp antes del vencimiento",
      "Recibos digitales al momento del pago",
    ],
    imageLeft: false,
    image: "/screenshots/cobros.png",
  },
  {
    id: "progreso",
    title: "Seguimiento del progreso",
    description: "Registra qué temas se cubrieron en cada sesión. Los padres ven el avance desde su portal sin llamar.",
    benefits: [
      "Notas de sesión con temas cubiertos",
      "Progreso visible para padres en tiempo real",
      "Alertas cuando un alumno falta varias sesiones",
      "Historial completo por materia y período",
    ],
    imageLeft: true,
    image: "/screenshots/evaluaciones.png",
  },
  {
    id: "portal-padres",
    title: "Portal para padres",
    description: "Los padres ven horarios, pagos pendientes, asistencia y notas del profesor. Todo sin necesidad de reuniones.",
    benefits: [
      "Horarios y próximas sesiones en tiempo real",
      "Pagos pendientes y recibos descargables",
      "Notas del profesor sobre cada sesión",
      "Sin llamadas ni mensajes de WhatsApp innecesarios",
    ],
    imageLeft: false,
    image: "/screenshots/portal-alumno.png",
  },
  {
    id: "comunicacion",
    title: "Comunicación por materia",
    description: "Envía avisos solo a los padres de alumnos de matemáticas, o solo a los de inglés. Comunicación segmentada.",
    benefits: [
      "Mensajes segmentados por materia o grupo",
      "WhatsApp y email con plantillas personalizables",
      "Avisos de cambios de horario o sesión cancelada",
      "Recordatorios automáticos de exámenes próximos",
    ],
    imageLeft: true,
    image: "/screenshots/comunicaciones.png",
  },
];
---

<Layout
  title="Software para Centros de Tutorías y Refuerzo Escolar | AKDEMIApp"
  description="Gestiona tu centro de tutorías con AKDEMIApp. Control de alumnos, horarios, cobros, asistencia y comunicación con padres. 14 días gratis."
>
  <Navbar />

  <main>

    <!-- ── 1. HERO ── -->
    <section class="relative overflow-hidden bg-gradient-to-b from-[#EFF8FF] via-[#f5faff] to-white pt-20 pb-20">
      <div class="absolute top-0 left-0 w-[500px] h-[500px] bg-[#B9E0FB] rounded-full filter blur-[100px] opacity-20 -translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-[#399ABE] rounded-full filter blur-[100px] opacity-10 translate-x-1/3 -translate-y-1/3 pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl mx-auto px-6 text-center">
        <div class="inline-flex items-center gap-1.5 bg-[#EFF8FF] border border-[#B9E0FB] text-[#155D88] text-xs font-bold px-3.5 py-1.5 rounded-full mb-7 tracking-widest uppercase">
          Tutorías y Refuerzo Escolar
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-[3.4rem] font-extrabold text-[#101828] leading-[1.08] tracking-[-0.03em] mb-5">
          Tu centro de tutorías, organizado y profesional
        </h1>

        <p class="text-lg sm:text-xl text-gray-500 font-normal leading-relaxed max-w-2xl mx-auto mb-10">
          Gestiona alumnos, horarios por materia, cobros y comunicación con padres desde un solo lugar. Matemáticas, lectura, escritura, preparación de exámenes y más.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={REGISTRO_URL}
            class="flex items-center gap-2.5 bg-[#155D88] hover:bg-[#124e75] text-white font-semibold text-[15px] px-7 py-3.5 rounded-xl shadow-lg shadow-[#155D88]/25 transition-all duration-200 hover:-translate-y-0.5 w-full sm:w-auto justify-center"
          >
            Empieza gratis
          </a>
          <a
            href={DEMO_WA}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-direct="true"
            class="flex items-center gap-2 bg-white hover:bg-gray-50 text-gray-700 font-medium text-[15px] px-6 py-3.5 rounded-xl border border-gray-200 transition-all duration-200 w-full sm:w-auto justify-center"
          >
            Agenda una demo
          </a>
        </div>
      </div>
    </section>

    <!-- ── 2. PAIN POINTS ── -->
    <section class="bg-white py-20 px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#101828] text-center mb-12 tracking-tight">
          ¿Te suena familiar?
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

          <!-- Clock -->
          <div class="flex gap-4 items-start bg-[#F8FAFC] rounded-2xl p-6 border border-gray-100">
            <div class="shrink-0 w-10 h-10 rounded-xl bg-[#EFF8FF] flex items-center justify-center">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <p class="text-[15px] text-gray-700 leading-relaxed">
              Coordinar horarios de diferentes materias y niveles con varios profesores
            </p>
          </div>

          <!-- MessageCircle -->
          <div class="flex gap-4 items-start bg-[#F8FAFC] rounded-2xl p-6 border border-gray-100">
            <div class="shrink-0 w-10 h-10 rounded-xl bg-[#EFF8FF] flex items-center justify-center">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
            </div>
            <p class="text-[15px] text-gray-700 leading-relaxed">
              Padres preguntando por WhatsApp sobre el progreso de su hijo
            </p>
          </div>

          <!-- DollarSign -->
          <div class="flex gap-4 items-start bg-[#F8FAFC] rounded-2xl p-6 border border-gray-100">
            <div class="shrink-0 w-10 h-10 rounded-xl bg-[#EFF8FF] flex items-center justify-center">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
              </svg>
            </div>
            <p class="text-[15px] text-gray-700 leading-relaxed">
              Cobrar por hora, por paquete o por mes sin un sistema claro
            </p>
          </div>

          <!-- ClipboardList -->
          <div class="flex gap-4 items-start bg-[#F8FAFC] rounded-2xl p-6 border border-gray-100">
            <div class="shrink-0 w-10 h-10 rounded-xl bg-[#EFF8FF] flex items-center justify-center">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
                <line x1="12" y1="11" x2="16" y2="11"/><line x1="12" y1="16" x2="16" y2="16"/><line x1="8" y1="11" x2="8.01" y2="11"/><line x1="8" y1="16" x2="8.01" y2="16"/>
              </svg>
            </div>
            <p class="text-[15px] text-gray-700 leading-relaxed">
              No saber qué temas ya cubrió cada alumno ni su avance real
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- ── 3. FEATURES ── -->
    <section class="py-6 px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#101828] text-center mb-4 tracking-tight">
          Todo lo que tu centro de tutorías necesita
        </h2>
      </div>
    </section>

    {features.map((feature, index) => (
      <section
        id={feature.id}
        class={`py-20 px-6 ${index % 2 === 0 ? "bg-white" : "bg-[#F8FAFC]"}`}
      >
        <div class="max-w-6xl mx-auto">
          <div class={`flex flex-col gap-12 lg:gap-16 lg:flex-row items-center ${feature.imageLeft ? "" : "lg:flex-row-reverse"}`}>

            <!-- Screenshot -->
            <div class="w-full lg:w-1/2 shrink-0">
              <img
                src={feature.image}
                alt={feature.title}
                class="rounded-2xl border border-gray-200 w-full"
              />
            </div>

            <!-- Text -->
            <div class="w-full lg:w-1/2">
              <h2 class="text-3xl sm:text-4xl font-extrabold text-[#101828] leading-tight tracking-tight mb-4">
                {feature.title}
              </h2>
              <p class="text-[16px] text-gray-500 leading-relaxed mb-8">
                {feature.description}
              </p>
              <ul class="space-y-3">
                {feature.benefits.map((benefit) => (
                  <li class="flex items-center gap-3">
                    <span class="shrink-0 w-5 h-5 rounded-full bg-[#EFF8FF] flex items-center justify-center">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                    </span>
                    <span class="text-[15px] text-gray-700 font-medium">{benefit}</span>
                  </li>
                ))}
              </ul>
            </div>

          </div>
        </div>
      </section>
    ))}

    <!-- ── 4. CTA ── -->
    <section class="bg-[#101828] py-24 px-6">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4 tracking-tight">
          ¿Listo para profesionalizar tu centro de tutorías?
        </h2>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-5">
          <a
            href={REGISTRO_URL}
            class="flex items-center gap-2.5 bg-[#399ABE] hover:bg-[#2e87ab] text-white font-semibold text-[15px] px-7 py-3.5 rounded-xl shadow-lg shadow-[#399ABE]/25 transition-all duration-200 hover:-translate-y-0.5 w-full sm:w-auto justify-center"
          >
            Empieza gratis
          </a>
          <a
            href={DEMO_WA}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-direct="true"
            class="flex items-center gap-2 bg-white/10 hover:bg-white/15 text-white font-medium text-[15px] px-6 py-3.5 rounded-xl border border-white/20 transition-all duration-200 w-full sm:w-auto justify-center"
          >
            Hablar por WhatsApp
          </a>
        </div>
        <p class="text-gray-500 text-xs">14 días gratis · Sin tarjeta de crédito</p>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
