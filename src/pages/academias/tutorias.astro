---
import AcademyLandingLayout from '../../components/sections/AcademyLandingLayout.astro';
---
<AcademyLandingLayout
  heroImage="/screenshots/hero-tutorias.jpg"
  badge="TUTORÍAS Y REFUERZO ESCOLAR"
  title="Tu centro de tutorías, organizado y profesional"
  subtitle="Gestiona alumnos, horarios por materia, cobros y comunicación con padres desde un solo lugar. Matemáticas, lectura, escritura, preparación de exámenes y más."
  whatsappText="Hola%2C%20tengo%20un%20centro%20de%20tutorías%20y%20quiero%20saber%20más"
  seoTitle="Software para Centros de Tutorías y Refuerzo Escolar | AKDEMIApp"
  seoDescription="Gestiona tu centro de tutorías con AKDEMIApp. Control de alumnos, horarios, cobros, asistencia y comunicación con padres. 14 días gratis."
  benefitsTitle="Beneficios Especializados para Centros de Tutorías"
  benefits={[
    { icon: "BookOpen", title: "Alumnos por materia", description: "Organiza por materia y nivel. Ficha completa con datos, padres y progreso." },
    { icon: "Clock", title: "Horarios flexibles", description: "Clases individuales o grupales, por hora o bloque. Sin cruces de horario." },
    { icon: "TrendingUp", title: "Seguimiento del progreso", description: "Registra temas cubiertos por sesión. Los padres ven el avance en su portal." },
    { icon: "MessageCircle", title: "Comunicación segmentada", description: "Envía avisos solo a padres de alumnos de matemáticas, o solo a los de inglés." }
  ]}
  featuresTitle="Funcionalidades Especializadas"
  featuresSubtitle="Herramientas diseñadas para centros de tutorías y refuerzo escolar."
  features={[
    { icon: "Users", title: "Alumnos por materia y nivel", description: "Organiza alumnos por materia, nivel y profesor asignado." },
    { icon: "Calendar", title: "Horarios flexibles", description: "Individual, grupal, por hora o bloque. Colores por materia." },
    { icon: "DollarSign", title: "Cobros por hora, paquete o mes", description: "Mensualidades, paquetes de horas o cobro por sesión." },
    { icon: "TrendingUp", title: "Seguimiento del progreso", description: "Temas cubiertos por sesión. Padres ven avance en portal." },
    { icon: "Smartphone", title: "Portal para padres", description: "Horarios, pagos, asistencia y notas del profesor." },
    { icon: "MessageCircle", title: "Comunicación por materia", description: "Avisos segmentados por materia o grupo específico." }
  ]}
  finalCtaTitle="Lleva tu Centro de Tutorías al Siguiente Nivel"
/>
