---
import AcademyLandingLayout from '../components/sections/AcademyLandingLayout.astro';
---
<AcademyLandingLayout
  heroImage="/screenshots/hero-artes-escenicas.jpg"
  badge="ARTES ESCÉNICAS"
  title="Software de Gestión para Academias de Teatro y Artes Escénicas"
  subtitle="Casting, ensayos, montajes y funciones: organiza toda tu compañía o escuela de teatro desde un solo lugar."
  whatsappText="Hola, tengo una academia de teatro y quiero saber más"
  seoTitle="Software para Academia de Teatro | AKDEMIApp"
  seoDescription="Gestiona tu escuela de teatro con AKDEMIApp. Montajes, ensayos, casting, boletería y portal para alumnos. Prueba gratis."
  benefitsTitle="Beneficios para tu Academia de Teatro"
  benefits={[
    { icon: "Award", title: "Gestión de montajes", description: "Organiza cada producción: elenco, calendario de ensayos, escenografía, vestuario y funciones." },
    { icon: "Users", title: "Casting y audiciones", description: "Publica convocatorias, registra audiciones, selecciona elenco y notifica resultados automáticamente." },
    { icon: "Calendar", title: "Calendario de ensayos", description: "Coordina ensayos generales, parciales y técnicos sin conflictos de horario ni de espacio." },
    { icon: "DollarSign", title: "Boletería digital", description: "Vende boletos para funciones con QR, controla aforo y registra ingresos por función." }
  ]}
  featuresTitle="Funcionalidades Especializadas para Teatro"
  featuresSubtitle="Herramientas diseñadas por expertos que conocen el día a día de una escuela de artes escénicas."
  features={[
    { icon: "Users", title: "Clases por disciplina escénica", description: "Actuación, improvisación, voz, movimiento escénico, dramaturgia: con nivel y horario." },
    { icon: "Calendar", title: "Calendario de montajes", description: "Cada producción con timeline completo: audiciones → ensayos → estreno → funciones." },
    { icon: "FileText", title: "Gestión de alumnos y actores", description: "Ficha con formación, experiencia escénica, roles interpretados y evaluaciones." },
    { icon: "CheckSquare", title: "Control de vestuario y utilería", description: "Inventario por montaje: qué piezas se tienen, cuáles fabricar, presupuesto." },
    { icon: "DollarSign", title: "Cobros y boletería", description: "Mensualidades de clases + venta de boletos para funciones. Reportes de ingresos por evento." },
    { icon: "MessageCircle", title: "Comunicación con elenco", description: "Notificaciones de cambio de ensayo, convocatorias de último minuto, avisos generales." }
  ]}
  finalCtaTitle="Lleva tu Academia de Teatro al Siguiente Nivel"
/>
