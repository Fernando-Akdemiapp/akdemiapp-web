---
import AcademyLandingLayout from '../components/sections/AcademyLandingLayout.astro';
---
<AcademyLandingLayout
  heroImage="/screenshots/hero-futbol.jpg"
  badge="FÚTBOL"
  title="Tu escuela de fútbol, bajo control total"
  subtitle="Gestiona jugadores, categorías, horarios por cancha, cobros y comunicación con padres desde un solo lugar."
  whatsappText="Hola, tengo una escuela de fútbol y quiero saber más"
  seoTitle="Software para Academia de Fútbol | AKDEMIApp"
  seoDescription="Gestiona tu escuela de fútbol con AKDEMIApp. Categorías, entrenamientos, torneos, cobros y portal para padres. Prueba gratis."
  benefitsTitle="Beneficios Especializados para Fútbol"
  benefits={[
    { icon: "Users", title: "Categorías por edad y nivel", description: "Sub-8, Sub-10, Sub-12, juvenil, adulto: cada categoría con su horario, cancha y entrenador asignado." },
    { icon: "FileText", title: "Ficha médica y deportiva", description: "Registra datos médicos, lesiones, posición de juego, pierna dominante y contacto de emergencia de cada jugador." },
    { icon: "🏆", title: "Gestión de torneos y ligas", description: "Inscribe equipos por categoría, lleva tabla de posiciones, resultados y estadísticas de goles." },
    { icon: "CheckSquare", title: "Asistencia a entrenamientos", description: "Check-in por QR o manual. Reportes de asistencia por jugador y por categoría para evaluaciones." }
  ]}
  featuresTitle="Funcionalidades Especializadas"
  featuresSubtitle="Herramientas diseñadas por expertos que conocen el día a día de una escuela de fútbol."
  features={[
    { icon: "Clock", title: "Entrenamientos por categoría", description: "Planifica entrenamientos semanales por grupo de edad con horario, cancha y entrenador." },
    { icon: "Calendar", title: "Calendario de partidos", description: "Vista mensual con entrenamientos, partidos amistosos y torneos. Notificaciones automáticas a jugadores y padres." },
    { icon: "Users", title: "Gestión de jugadores", description: "Ficha 360°: datos personales, categoría, posición, pie dominante, ficha médica, evaluaciones y asistencia." },
    { icon: "CheckSquare", title: "Control de uniformes y equipos", description: "Tallas de uniformes por jugador, balones, conos, chalecos. Inventario de equipamiento deportivo." },
    { icon: "DollarSign", title: "Cobros e inscripciones", description: "Mensualidades por categoría, inscripción a torneos, cuota de uniforme. Descuentos por hermanos." },
    { icon: "TrendingUp", title: "Evaluaciones deportivas", description: "Evalúa técnica, condición física, trabajo en equipo y actitud. Progreso visible para padres y jugadores." }
  ]}
  finalCtaTitle="Lleva tu Academia de Fútbol al Siguiente Nivel"
/>
