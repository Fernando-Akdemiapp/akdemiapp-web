---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import { getCollection } from "astro:content";

const articles = await getCollection("ayuda");

const MODULE_ORDER = [
  "Primeros Pasos",
  "Alumnos",
  "Clases y Calendario",
  "Cobros y Finanzas",
  "Asistencia",
  "Comunicaciones",
  "Reportes",
  "Portales",
  "CRM y Prospectos",
  "Configuración",
];

const MODULE_ICONS: Record<string, string> = {
  "Primeros Pasos":    `<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>`,
  "Alumnos":           `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  "Clases y Calendario":`<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>`,
  "Cobros y Finanzas": `<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>`,
  "Asistencia":        `<polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>`,
  "Comunicaciones":    `<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>`,
  "Reportes":          `<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>`,
  "Portales":          `<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/>`,
  "CRM y Prospectos":  `<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>`,
  "Configuración":     `<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>`,
};

// Group articles by module, sorted by order within each module
const byModule = new Map<string, typeof articles>();
for (const mod of MODULE_ORDER) byModule.set(mod, []);
for (const article of articles) {
  const key = article.data.module;
  if (!byModule.has(key)) byModule.set(key, []);
  byModule.get(key)!.push(article);
}
for (const [, arr] of byModule) {
  arr.sort((a, b) => a.data.order - b.data.order);
}

const activeModules = MODULE_ORDER.filter(
  (mod) => (byModule.get(mod)?.length ?? 0) > 0
);
---

<Layout
  title="Centro de Ayuda — AKDEMIApp"
  description="Guías paso a paso para sacar el máximo provecho de AKDEMIApp."
>
  <Navbar />

  <main>
    <!-- PAGE HEADER -->
    <section class="bg-white pt-20 pb-10 px-6 border-b border-gray-100">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-[#101828] tracking-tight mb-3">
          Centro de Ayuda
        </h1>
        <p class="text-lg text-gray-500 font-normal mb-8">
          Guías paso a paso para sacar el máximo provecho de AKDEMIApp.
        </p>

        <!-- Search -->
        <div class="max-w-xl">
          <div class="relative">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
            <input
              id="ayuda-search"
              type="text"
              placeholder="Buscar artículo..."
              class="w-full bg-white rounded-xl border border-gray-200 shadow-sm pl-11 pr-5 py-4 text-[15px] text-gray-700 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-[#155D88]/20 focus:border-[#155D88] transition-all"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- MODULE SECTIONS -->
    <section class="bg-[#f9fafb] py-16 px-6">
      <div class="max-w-4xl mx-auto">
        {articles.length === 0 ? (
          <p class="text-center text-gray-400 py-20">No hay artículos publicados aún.</p>
        ) : (
          <div id="modules-container" class="space-y-6">
            {activeModules.map((mod) => {
              const modArticles = byModule.get(mod) ?? [];
              return (
                <div class="module-section" data-module={mod}>
                  <!-- Module header -->
                  <div class="flex items-center gap-3 mb-3">
                    <span class="w-10 h-10 bg-[#EFF8FF] rounded-xl flex items-center justify-center shrink-0">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#155D88"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        set:html={MODULE_ICONS[mod] ?? ""}
                      />
                    </span>
                    <span class="text-[16px] font-bold text-[#101828]">{mod}</span>
                    <span class="text-[11px] font-semibold text-[#155D88] bg-[#EFF8FF] px-2.5 py-0.5 rounded-full">
                      {modArticles.length} {modArticles.length === 1 ? "artículo" : "artículos"}
                    </span>
                  </div>

                  <!-- Article list -->
                  <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden divide-y divide-gray-50">
                    {modArticles.map((article) => (
                      <a
                        href={`/ayuda/${article.slug}`}
                        class="article-row flex flex-col px-6 py-4 hover:bg-[#f5faff] transition-colors"
                        data-title={article.data.title.toLowerCase()}
                      >
                        <span class="text-[14px] font-semibold text-[#155D88] leading-snug">
                          {article.data.title}
                        </span>
                        <span class="text-[13px] text-gray-500 mt-0.5 leading-relaxed">
                          {article.data.description}
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              );
            })}

            <!-- Empty search state -->
            <p id="no-results" class="text-center text-gray-400 py-16 hidden">
              No se encontraron artículos para tu búsqueda.
            </p>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script is:inline>
  (function () {
    function initSearch() {
      var input = document.getElementById('ayuda-search');
      var noResults = document.getElementById('no-results');
      if (!input) return;

      input.addEventListener('input', function () {
        var query = this.value.toLowerCase().trim();
        var sections = Array.from(document.querySelectorAll('.module-section'));
        var anyVisible = false;

        sections.forEach(function (section) {
          var rows = Array.from(section.querySelectorAll('.article-row'));
          var sectionVisible = false;

          rows.forEach(function (row) {
            var title = row.getAttribute('data-title') || '';
            var match = !query || title.includes(query);
            row.style.display = match ? '' : 'none';
            if (match) sectionVisible = true;
          });

          section.style.display = sectionVisible ? '' : 'none';
          if (sectionVisible) anyVisible = true;
        });

        if (noResults) {
          noResults.classList.toggle('hidden', anyVisible || !query);
        }
      });
    }

    initSearch();
    document.addEventListener('astro:page-load', initSearch);
  })();
</script>
