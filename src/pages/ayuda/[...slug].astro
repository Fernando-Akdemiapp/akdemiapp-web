---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const articles = await getCollection("ayuda");
  return articles.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"ayuda">;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const WA_SUPPORT = "https://wa.me/50765726078?text=Hola%2C%20necesito%20ayuda%20con%20AKDEMIApp";

function formatDate(date: Date): string {
  return date.toLocaleDateString("es-PA", { year: "numeric", month: "long", day: "numeric" });
}
---

<Layout
  title={`${entry.data.title} — Centro de Ayuda AKDEMIApp`}
  description={entry.data.description}
>
  <Navbar />

  <main class="bg-white">
    <div class="max-w-3xl mx-auto px-6 py-16">

      <!-- Back link -->
      <a
        href="/ayuda"
        class="inline-flex items-center gap-1.5 text-[14px] text-gray-400 hover:text-[#155D88] transition-colors mb-10"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/>
        </svg>
        Volver al Centro de Ayuda
      </a>

      <!-- Module badge -->
      <span class="inline-block text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-[#EFF8FF] text-[#155D88] mb-5">
        {entry.data.module}
      </span>

      <!-- Title -->
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#101828] leading-tight tracking-tight mb-5">
        {entry.data.title}
      </h1>

      <!-- Meta -->
      <p class="text-[13px] text-gray-400 mb-12 pb-8 border-b border-gray-100">
        Actualizado el {formatDate(entry.data.date)}
      </p>

      <!-- Article body -->
      <div class="prose-ayuda">
        <Content />
      </div>

      <!-- Bottom help card -->
      <div class="mt-16 bg-[#EFF8FF] rounded-2xl p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h2 class="text-[18px] font-extrabold text-[#101828] mb-1">
            ¿Necesitas más ayuda?
          </h2>
          <p class="text-[14px] text-gray-500 leading-relaxed">
            Nuestro equipo está disponible para ayudarte directamente.
          </p>
        </div>
        <a
          href={WA_SUPPORT}
          target="_blank"
          rel="noopener noreferrer"
          data-wa-direct="true"
          class="shrink-0 inline-flex items-center gap-2.5 bg-[#155D88] hover:bg-[#124e75] text-white font-semibold text-[14px] px-6 py-3 rounded-xl shadow-md shadow-[#155D88]/20 transition-all duration-200 hover:-translate-y-0.5 whitespace-nowrap"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="white">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Hablar con soporte
        </a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<style>
  .prose-ayuda :global(h2) {
    font-size: 1.5rem;
    font-weight: 800;
    color: #101828;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .prose-ayuda :global(h3) {
    font-size: 1.15rem;
    font-weight: 700;
    color: #101828;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  .prose-ayuda :global(p) {
    font-size: 1.0625rem;
    color: #374151;
    line-height: 1.85;
    margin-bottom: 1.35rem;
  }
  .prose-ayuda :global(ul),
  .prose-ayuda :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.35rem;
  }
  .prose-ayuda :global(li) {
    font-size: 1.0625rem;
    color: #374151;
    line-height: 1.75;
    margin-bottom: 0.4rem;
  }
  .prose-ayuda :global(strong) {
    color: #101828;
    font-weight: 700;
  }
  .prose-ayuda :global(a) {
    color: #155D88;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-ayuda :global(a:hover) {
    color: #399ABE;
  }
  .prose-ayuda :global(blockquote) {
    border-left: 4px solid #B9E0FB;
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: #6b7280;
    font-style: italic;
  }
  .prose-ayuda :global(hr) {
    border: none;
    border-top: 1px solid #f1f5f9;
    margin: 2.5rem 0;
  }
  .prose-ayuda :global(code) {
    background: #f1f5f9;
    color: #155D88;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }
  .prose-ayuda :global(pre) {
    background: #1e293b;
    color: #e2e8f0;
    padding: 1.25rem 1.5rem;
    border-radius: 0.75rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .prose-ayuda :global(pre code) {
    background: none;
    color: inherit;
    padding: 0;
    font-size: inherit;
  }
  .prose-ayuda :global(img) {
    border-radius: 0.75rem;
    border: 1px solid #e5e7eb;
    margin: 1.5rem 0;
    max-width: 100%;
  }
</style>
