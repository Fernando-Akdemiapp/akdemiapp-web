---
import AcademyLandingLayout from '../components/sections/AcademyLandingLayout.astro';
---
<AcademyLandingLayout
  heroImage="/images/hero-mockup.png"
  badge="YOGA Y PILATES"
  title="Tu estudio de yoga, en armonía total"
  subtitle="Gestiona alumnos, horarios, cobros y comunicación desde un solo lugar. Yoga, pilates y bienestar."
  whatsappText="Hola, tengo un estudio de yoga y quiero saber más"
  seoTitle="Software para Estudio de Yoga y Pilates | AKDEMIApp"
  seoDescription="Gestiona tu estudio de yoga y pilates con AKDEMIApp. Reservas, paquetes, control de cupo y portal para alumnos. Prueba gratis."
  benefitsTitle="Beneficios para tu Academia de Yoga y Pilates"
  benefits={[
    { icon: "Smartphone", title: "Reserva de clases online", description: "Tus alumnos reservan su lugar desde el celular. Control de cupo máximo por clase y lista de espera automática." },
    { icon: "DollarSign", title: "Paquetes flexibles de sesiones", description: "Vende paquetes de 4, 8 o 12 clases con vencimiento. El sistema descuenta automáticamente cada asistencia." },
    { icon: "Calendar", title: "Variedad de modalidades", description: "Hatha, Vinyasa, Ashtanga, Pilates mat, Pilates reformer: cada tipo con su horario, instructor y sala." },
    { icon: "TrendingUp", title: "Portal de bienestar", description: "Cada alumno ve sus clases próximas, paquete restante, historial de asistencia y puede reservar desde su celular." }
  ]}
  featuresTitle="Funcionalidades Especializadas para Yoga y Pilates"
  featuresSubtitle="Herramientas diseñadas por expertos que conocen el día a día de un estudio de bienestar."
  features={[
    { icon: "Calendar", title: "Clases por modalidad", description: "Yoga restaurativo, power yoga, Pilates mat, reformer: cada tipo con cupo máximo, duración e instructor." },
    { icon: "DollarSign", title: "Paquetes y membresías", description: "Paquetes de sesiones, membresía ilimitada, clase suelta. Control de vencimiento y sesiones restantes." },
    { icon: "Clock", title: "Reservas con control de cupo", description: "Define cupo máximo por clase. Lista de espera automática cuando se llena. Cancelación con anticipación mínima." },
    { icon: "Users", title: "Gestión de instructores", description: "Perfil de cada instructor con especialidades, horario, certificaciones y evaluaciones de alumnos." },
    { icon: "💳", title: "Cobros automáticos", description: "Renovación de paquetes, cobro de clase drop-in, recordatorios de vencimiento. Recibos PDF." },
    { icon: "MessageCircle", title: "Comunicación", description: "Notificaciones de cambio de horario, clase cancelada o instructor sustituto. WhatsApp y email masivo." }
  ]}
  finalCtaTitle="Lleva tu Academia de Yoga y Pilates al Siguiente Nivel"
/>
