---
import AcademyLandingLayout from '../components/sections/AcademyLandingLayout.astro';
---
<AcademyLandingLayout
  heroImage="/screenshots/hero-musica.jpg"
  badge="MÚSICA"
  title="Tu escuela de música, afinada y organizada"
  subtitle="Gestiona alumnos, instrumentos, horarios, cobros y audiciones desde un solo lugar."
  whatsappText="Hola, tengo una escuela de música y quiero saber más"
  seoTitle="Software para Escuela de Música | AKDEMIApp"
  seoDescription="Gestiona tu escuela de música con AKDEMIApp. Clases por instrumento, salas, recitales, cobros y portal para alumnos. Prueba gratis."
  benefitsTitle="Beneficios para tu Academia de Música"
  benefits={[
    { icon: "Users", title: "Clases individuales y grupales", description: "Gestiona clases 1-a-1 (piano, guitarra, voz) y grupales (ensamble, coro, orquesta) con diferente duración y precio." },
    { icon: "Clock", title: "Reserva de salas de práctica", description: "Tus alumnos reservan horarios de sala de ensayo desde el portal. Sin conflictos, sin WhatsApp." },
    { icon: "TrendingUp", title: "Seguimiento por instrumento", description: "Cada alumno tiene su perfil con instrumento principal, nivel (grado 1-8), repertorio y evaluaciones." },
    { icon: "Award", title: "Recitales y audiciones", description: "Organiza recitales de fin de periodo, audiciones de ingreso y presentaciones con logística completa." }
  ]}
  featuresTitle="Funcionalidades Especializadas para Música"
  featuresSubtitle="Herramientas diseñadas por expertos que conocen el día a día de una escuela de música."
  features={[
    { icon: "Calendar", title: "Clases por instrumento y nivel", description: "Piano, guitarra, violín, batería, canto, teoría musical: cada clase con duración, profesor y sala asignada." },
    { icon: "Clock", title: "Agenda flexible", description: "Clases individuales de 30/45/60 min + grupales. Vista semanal con bloques por profesor y sala disponible." },
    { icon: "Users", title: "Gestión de alumnos", description: "Ficha con instrumento, grado/nivel, repertorio actual, evaluaciones y notas del profesor." },
    { icon: "CheckSquare", title: "Inventario de instrumentos", description: "Registra instrumentos de la academia disponibles para préstamo o alquiler a alumnos." },
    { icon: "DollarSign", title: "Cobros diferenciados", description: "Mensualidad por instrumento, clase individual vs grupal, alquiler de instrumento. Paquetes y descuentos por hermanos." },
    { icon: "Award", title: "Certificados de grado", description: "Emite certificados por nivel completado (grado 1-8), participación en recitales o graduación." }
  ]}
  finalCtaTitle="Lleva tu Academia de Música al Siguiente Nivel"
/>
