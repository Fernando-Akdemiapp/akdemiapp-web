---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await post.render();

const FERNANDO_WA = "https://wa.me/50765726078?text=Hola%20Fernando%2C%20quiero%20saber%20m%C3%A1s%20sobre%20AKDEMIApp";

function formatDate(date: Date): string {
  return date.toLocaleDateString("es-PA", { year: "numeric", month: "long", day: "numeric" });
}

function categoryBadgeColor(category: string): string {
  const map: Record<string, string> = {
    "Gestión": "text-[#155D88] bg-[#EFF8FF]",
    "Cobros": "text-emerald-700 bg-emerald-50",
    "Marketing": "text-violet-700 bg-violet-50",
    "Tecnología": "text-slate-700 bg-slate-100",
    "Alumnos": "text-orange-700 bg-orange-50",
    "IA": "text-indigo-700 bg-indigo-50",
  };
  return map[category] ?? "text-[#155D88] bg-[#EFF8FF]";
}

// Estimate reading time: ~200 words per minute
const wordCount = post.body.split(/\s+/).length;
const readingTime = Math.max(1, Math.round(wordCount / 200));
---

<Layout title={`${post.data.title} | Blog AKDEMIApp`} description={post.data.description}>
  <Navbar />

  <main class="bg-white">
    <div class="max-w-3xl mx-auto px-6 py-16">

      <!-- Back link -->
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 text-[14px] text-gray-400 hover:text-[#155D88] transition-colors mb-10"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/>
        </svg>
        Volver al blog
      </a>

      <!-- Category badge -->
      <span class={`inline-block text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full mb-5 ${categoryBadgeColor(post.data.category)}`}>
        {post.data.category}
      </span>

      <!-- Title -->
      <h1 class="text-3xl sm:text-4xl lg:text-[2.6rem] font-extrabold text-[#101828] leading-[1.12] tracking-[-0.02em] mb-6">
        {post.data.title}
      </h1>

      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] text-gray-400 mb-12 pb-8 border-b border-gray-100">
        <span>{formatDate(post.data.date)}</span>
        <span class="text-gray-200">·</span>
        <span class="text-gray-600 font-medium">{post.data.author}</span>
        <span class="text-gray-200">·</span>
        <span>{readingTime} min de lectura</span>
      </div>

      <!-- Article body -->
      <div class="prose-blog">
        <Content />
      </div>

      <!-- Bottom CTA -->
      <div class="mt-16 bg-gray-50 rounded-xl p-8 text-center">
        <h2 class="text-xl sm:text-2xl font-extrabold text-[#101828] mb-3">
          ¿Quieres dejar de gestionar tu academia con Excel?
        </h2>
        <p class="text-gray-500 text-[15px] mb-7 leading-relaxed">
          AKDEMIApp automatiza cobros, asistencia, comunicaciones y más. 14 días gratis, sin tarjeta.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/registro"
            class="flex items-center gap-2 bg-[#155D88] hover:bg-[#124e75] text-white font-semibold text-[15px] px-6 py-3 rounded-xl shadow-md shadow-[#155D88]/20 transition-all duration-200 hover:-translate-y-0.5 w-full sm:w-auto justify-center"
          >
            Empieza gratis
          </a>
          <a
            href={FERNANDO_WA}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-direct="true"
            class="flex items-center gap-2 bg-white hover:bg-gray-100 text-gray-700 font-medium text-[15px] px-6 py-3 rounded-xl border border-gray-200 transition-all duration-200 w-full sm:w-auto justify-center"
          >
            Hablar con Fernando
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<style>
  .prose-blog :global(h2) {
    font-size: 1.5rem;
    font-weight: 800;
    color: #101828;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .prose-blog :global(h3) {
    font-size: 1.2rem;
    font-weight: 700;
    color: #101828;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  .prose-blog :global(p) {
    font-size: 1.0625rem;
    color: #374151;
    line-height: 1.85;
    margin-bottom: 1.35rem;
  }
  .prose-blog :global(ul),
  .prose-blog :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.35rem;
  }
  .prose-blog :global(li) {
    font-size: 1.0625rem;
    color: #374151;
    line-height: 1.75;
    margin-bottom: 0.4rem;
  }
  .prose-blog :global(strong) {
    color: #101828;
    font-weight: 700;
  }
  .prose-blog :global(a) {
    color: #155D88;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-blog :global(a:hover) {
    color: #399ABE;
  }
  .prose-blog :global(blockquote) {
    border-left: 4px solid #B9E0FB;
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: #6b7280;
    font-style: italic;
  }
  .prose-blog :global(hr) {
    border: none;
    border-top: 1px solid #f1f5f9;
    margin: 2.5rem 0;
  }
  .prose-blog :global(code) {
    background: #f1f5f9;
    color: #155D88;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }
</style>
