---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";

const REGISTRO_URL = "https://app.akdemiapp.online/registro/academia";
const FERNANDO_WA = "https://wa.me/50765726078?text=Hola%20Fernando%2C%20quiero%20saber%20m%C3%A1s%20sobre%20AKDEMIApp";
---

<Layout
  title="Integraciones | AKDEMIApp"
  description="AKDEMIApp se integra con WhatsApp, Yappy, PagueloFácil, Resend y Anthropic Claude AI. Conoce todas las integraciones disponibles."
>
  <Navbar />

  <main>

    <!-- ── 1. HERO ── -->
    <section class="relative overflow-hidden bg-gradient-to-b from-[#EFF8FF] via-[#f5faff] to-white pt-20 pb-16">
      <div class="absolute top-0 left-0 w-[500px] h-[500px] bg-[#B9E0FB] rounded-full filter blur-[100px] opacity-20 -translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-[#399ABE] rounded-full filter blur-[100px] opacity-10 translate-x-1/3 -translate-y-1/3 pointer-events-none"></div>

      <div class="relative z-10 max-w-2xl mx-auto px-6 text-center">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-[#101828] leading-tight tracking-[-0.03em] mb-5">
          Integraciones
        </h1>
        <p class="text-lg sm:text-xl text-gray-500 font-normal leading-relaxed">
          AKDEMIApp se conecta con las herramientas que ya usas para que todo funcione junto.
        </p>
      </div>
    </section>

    <!-- ── 2. INTEGRATIONS GRID ── -->
    <section class="bg-white py-20 px-6">
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

          <!-- WhatsApp Business -->
          <div class="bg-white rounded-xl p-8 border border-gray-100 shadow-sm">
            <div class="flex items-start gap-5 mb-5">
              <div class="w-16 h-16 rounded-full bg-[#25D366] flex items-center justify-center shrink-0">
                <svg viewBox="0 0 24 24" width="30" height="30" fill="white">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </div>
              <div class="pt-1">
                <p class="text-xl font-bold text-[#101828] leading-tight">WhatsApp Business</p>
                <span class="inline-block mt-1.5 text-[11px] font-semibold text-gray-500 bg-gray-100 px-2.5 py-0.5 rounded-full">Comunicaciones</span>
              </div>
            </div>
            <p class="text-[15px] text-gray-600 leading-relaxed mb-5">
              Envía recordatorios de pago, avisos de clase y felicitaciones de cumpleaños directamente al WhatsApp de padres y alumnos. Plantillas personalizables por academia.
            </p>
            <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-green-700 bg-green-50 border border-green-200 px-3 py-1 rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Activa
            </span>
          </div>

          <!-- Yappy -->
          <div class="bg-white rounded-xl p-8 border border-gray-100 shadow-sm">
            <div class="flex items-start gap-5 mb-5">
              <div class="w-16 h-16 rounded-full bg-[#0073E6] flex items-center justify-center shrink-0">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/>
                </svg>
              </div>
              <div class="pt-1">
                <p class="text-xl font-bold text-[#101828] leading-tight">Yappy</p>
                <span class="inline-block mt-1.5 text-[11px] font-semibold text-gray-500 bg-gray-100 px-2.5 py-0.5 rounded-full">Pagos</span>
              </div>
            </div>
            <p class="text-[15px] text-gray-600 leading-relaxed mb-5">
              Recibe pagos electrónicos de tus alumnos en Panamá. Integración directa con el módulo de cobros de AKDEMIApp.
            </p>
            <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-green-700 bg-green-50 border border-green-200 px-3 py-1 rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Activa
            </span>
          </div>

          <!-- PagueloFácil -->
          <div class="bg-white rounded-xl p-8 border border-gray-100 shadow-sm">
            <div class="flex items-start gap-5 mb-5">
              <div class="w-16 h-16 rounded-full bg-[#1A56DB] flex items-center justify-center shrink-0">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
              </div>
              <div class="pt-1">
                <p class="text-xl font-bold text-[#101828] leading-tight">PagueloFácil</p>
                <span class="inline-block mt-1.5 text-[11px] font-semibold text-gray-500 bg-gray-100 px-2.5 py-0.5 rounded-full">Pagos</span>
              </div>
            </div>
            <p class="text-[15px] text-gray-600 leading-relaxed mb-5">
              Procesamiento de pagos en línea para academias en Panamá. Tus alumnos pagan desde su celular.
            </p>
            <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-green-700 bg-green-50 border border-green-200 px-3 py-1 rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Activa
            </span>
          </div>

          <!-- Resend -->
          <div class="bg-white rounded-xl p-8 border border-gray-100 shadow-sm">
            <div class="flex items-start gap-5 mb-5">
              <div class="w-16 h-16 rounded-full bg-[#7C3AED] flex items-center justify-center shrink-0">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div class="pt-1">
                <p class="text-xl font-bold text-[#101828] leading-tight">Resend</p>
                <span class="inline-block mt-1.5 text-[11px] font-semibold text-gray-500 bg-gray-100 px-2.5 py-0.5 rounded-full">Email</span>
              </div>
            </div>
            <p class="text-[15px] text-gray-600 leading-relaxed mb-5">
              Emails transaccionales con el logo y colores de tu academia. Confirmaciones de pago, recordatorios y comunicados masivos.
            </p>
            <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-green-700 bg-green-50 border border-green-200 px-3 py-1 rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Activa
            </span>
          </div>

          <!-- Anthropic Claude AI -->
          <div class="bg-white rounded-xl p-8 border border-gray-100 shadow-sm">
            <div class="flex items-start gap-5 mb-5">
              <div class="w-16 h-16 rounded-full bg-[#1a1a2e] flex items-center justify-center shrink-0">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2a10 10 0 1 0 10 10"/><path d="M12 8v4l3 3"/><path d="M18 2v4h4"/>
                </svg>
              </div>
              <div class="pt-1">
                <p class="text-xl font-bold text-[#101828] leading-tight">Anthropic Claude AI</p>
                <span class="inline-block mt-1.5 text-[11px] font-semibold text-gray-500 bg-gray-100 px-2.5 py-0.5 rounded-full">Inteligencia Artificial</span>
              </div>
            </div>
            <p class="text-[15px] text-gray-600 leading-relaxed mb-5">
              El motor de IA detrás de AKDI, Escaneo Inteligente, Evaluaciones Digitales, Salud Financiera y Centinela. Potencia 5 funcionalidades con IA de última generación.
            </p>
            <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-green-700 bg-green-50 border border-green-200 px-3 py-1 rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Activa
            </span>
          </div>

          <!-- Google Calendar -->
          <div class="bg-white rounded-xl p-8 border border-gray-100 shadow-sm">
            <div class="flex items-start gap-5 mb-5">
              <div class="w-16 h-16 rounded-full bg-[#EA4335] flex items-center justify-center shrink-0">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
              </div>
              <div class="pt-1">
                <p class="text-xl font-bold text-[#101828] leading-tight">Google Calendar</p>
                <span class="inline-block mt-1.5 text-[11px] font-semibold text-gray-500 bg-gray-100 px-2.5 py-0.5 rounded-full">Calendario</span>
              </div>
            </div>
            <p class="text-[15px] text-gray-600 leading-relaxed mb-5">
              Sincroniza el calendario de tu academia con Google Calendar. Tus profesores ven sus clases en su calendario personal.
            </p>
            <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-blue-700 bg-blue-50 border border-blue-200 px-3 py-1 rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>Próximamente
            </span>
          </div>

        </div>
      </div>
    </section>

    <!-- ── 3. CTA ── -->
    <section class="bg-[#101828] py-24 px-6">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4 tracking-tight">
          ¿Necesitas una integración específica?
        </h2>
        <p class="text-gray-400 text-base mb-10 leading-relaxed">
          Escríbenos y la evaluamos para ti.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-5">
          <a
            href={FERNANDO_WA}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-direct="true"
            class="flex items-center gap-2.5 bg-[#399ABE] hover:bg-[#2e87ab] text-white font-semibold text-[15px] px-7 py-3.5 rounded-xl shadow-lg shadow-[#399ABE]/25 transition-all duration-200 hover:-translate-y-0.5 w-full sm:w-auto justify-center"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            Hablar con Fernando
          </a>
          <a
            href={REGISTRO_URL}
            class="flex items-center gap-2 bg-white/10 hover:bg-white/15 text-white font-medium text-[15px] px-6 py-3.5 rounded-xl border border-white/20 transition-all duration-200 w-full sm:w-auto justify-center"
          >
            Empieza gratis
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
