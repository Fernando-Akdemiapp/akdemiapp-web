---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";

const REGISTRO_URL = "https://app.akdemiapp.online/registro/academia";
const FERNANDO_WA = "https://wa.me/50765726078?text=Hola%20Fernando%2C%20quiero%20saber%20m%C3%A1s%20sobre%20AKDEMIApp";

interface Row {
  feature: string;
  akdemi: string;
  akdemiType: "check" | "cross" | "text";
  other: string;
  otherType: "check" | "cross" | "text";
}

const rows: Row[] = [
  { feature: "Enfoque", akdemi: "100% academias", akdemiType: "text", other: "Belleza, salud, fitness y academias", otherType: "text" },
  { feature: "Inteligencia Artificial", akdemi: "5 funcionalidades con IA (AKDI, Escaneo, Centinela, Evaluaciones, Salud Financiera)", akdemiType: "text", other: "No", otherType: "cross" },
  { feature: "Portal del Alumno", akdemi: "✓", akdemiType: "check", other: "✓", otherType: "check" },
  { feature: "Portal del Padre", akdemi: "✓", akdemiType: "check", other: "No", otherType: "cross" },
  { feature: "Portal del Profesor", akdemi: "✓", akdemiType: "check", other: "No", otherType: "cross" },
  { feature: "Evaluaciones digitales", akdemi: "IA convierte PDF a digital", akdemiType: "text", other: "No", otherType: "cross" },
  { feature: "CRM de Prospectos", akdemi: "Kanban + lead scoring + WhatsApp", akdemiType: "text", other: "Básico", otherType: "text" },
  { feature: "Página web incluida", akdemi: "Wizard 7 pasos + tienda", akdemiType: "text", other: "Sitio de reservas básico", otherType: "text" },
  { feature: "Cobros y facturación", akdemi: "Mensualidades, paquetes, abonos, POS", akdemiType: "text", other: "Pagos y planes", otherType: "text" },
  { feature: "Asistencia", akdemi: "Manual + QR", akdemiType: "text", other: "Manual", otherType: "text" },
  { feature: "Comunicaciones", akdemi: "WhatsApp + Email con branding", akdemiType: "text", other: "Email + SMS", otherType: "text" },
  { feature: "App instalable (PWA)", akdemi: "✓", akdemiType: "check", other: "App nativa", otherType: "text" },
  { feature: "Precio desde", akdemi: "Gratis (30 alumnos)", akdemiType: "text", other: "~$29 USD/mes", otherType: "text" },
  { feature: "Moneda", akdemi: "USD", akdemiType: "text", other: "USD/moneda local", otherType: "text" },
  { feature: "Soporte", akdemi: "WhatsApp directo con el fundador", akdemiType: "text", other: "Chat + email", otherType: "text" },
  { feature: "Vocabulario personalizable", akdemi: "✓ (alumno→atleta, clase→sesión)", akdemiType: "check", other: "No", otherType: "cross" },
];
---

<Layout
  title="AKDEMIApp vs AgendaPro — Comparativa 2026 | AKDEMIApp"
  description="Compara AKDEMIApp vs AgendaPro. Descubre cuál es mejor para tu academia de danza, artes marciales o deportes en Latinoamérica."
>
  <Navbar />

  <main>

    <!-- ── 1. HERO ── -->
    <section class="relative overflow-hidden bg-gradient-to-b from-[#EFF8FF] via-[#f5faff] to-white pt-20 pb-16">
      <div class="absolute top-0 left-0 w-[500px] h-[500px] bg-[#B9E0FB] rounded-full filter blur-[100px] opacity-20 -translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-[#399ABE] rounded-full filter blur-[100px] opacity-10 translate-x-1/3 -translate-y-1/3 pointer-events-none"></div>

      <div class="relative z-10 max-w-2xl mx-auto px-6 text-center">
        <div class="inline-flex items-center gap-1.5 bg-[#EFF8FF] border border-[#B9E0FB] text-[#155D88] text-xs font-bold px-3.5 py-1.5 rounded-full mb-7 tracking-widest uppercase">
          Comparativa 2026
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-[#101828] leading-tight tracking-[-0.03em] mb-5">
          AKDEMIApp vs AgendaPro
        </h1>
        <p class="text-lg sm:text-xl text-gray-500 font-normal leading-relaxed">
          ¿Cuál es la mejor opción para tu academia? Comparamos funcionalidades, precios y enfoque para que decidas con información real.
        </p>
      </div>
    </section>

    <!-- ── 2. COMPARISON TABLE ── -->
    <section class="bg-white py-20 px-6">
      <div class="max-w-5xl mx-auto">

        <!-- Desktop table -->
        <div class="hidden sm:block w-full rounded-xl border border-gray-200 shadow-sm overflow-hidden">
          <table class="w-full border-collapse">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="text-left px-6 py-4 text-[13px] font-bold text-gray-500 uppercase tracking-wider w-[35%] bg-gray-50">Funcionalidad</th>
                <th class="px-6 py-4 text-center text-[14px] font-bold text-[#155D88] bg-blue-50 w-[32.5%]">
                  <span class="flex items-center justify-center gap-2">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    AKDEMIApp
                  </span>
                </th>
                <th class="px-6 py-4 text-center text-[14px] font-bold text-gray-600 bg-white w-[32.5%]">AgendaPro</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row, i) => (
                <tr class={`border-b border-gray-100 ${i % 2 === 0 ? "" : "bg-gray-50/40"}`}>
                  <td class="px-6 py-4 text-[14px] font-medium text-gray-700">{row.feature}</td>
                  <td class="px-6 py-4 text-center bg-blue-50/60">
                    {row.akdemiType === "check" ? (
                      <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-green-100">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      </span>
                    ) : row.akdemiType === "cross" ? (
                      <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-red-100">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                      </span>
                    ) : (
                      <span class="text-[13px] text-gray-700 font-medium">{row.akdemi}</span>
                    )}
                  </td>
                  <td class="px-6 py-4 text-center">
                    {row.otherType === "check" ? (
                      <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-green-100">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      </span>
                    ) : row.otherType === "cross" ? (
                      <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-red-100">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                      </span>
                    ) : (
                      <span class="text-[13px] text-gray-500">{row.other}</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Mobile cards -->
        <div class="sm:hidden space-y-4">
          {rows.map((row) => (
            <div class="rounded-xl border border-gray-200 overflow-hidden shadow-sm">
              <div class="bg-gray-50 px-4 py-2.5 border-b border-gray-200">
                <p class="text-[13px] font-bold text-gray-600 uppercase tracking-wide">{row.feature}</p>
              </div>
              <div class="grid grid-cols-2 divide-x divide-gray-100">
                <div class="px-4 py-4 bg-blue-50/60">
                  <p class="text-[11px] font-bold text-[#155D88] mb-2 uppercase tracking-wider">AKDEMIApp</p>
                  {row.akdemiType === "check" ? (
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-green-100">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </span>
                  ) : row.akdemiType === "cross" ? (
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-red-100">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </span>
                  ) : (
                    <p class="text-[13px] text-gray-700 font-medium leading-snug">{row.akdemi}</p>
                  )}
                </div>
                <div class="px-4 py-4 bg-white">
                  <p class="text-[11px] font-bold text-gray-400 mb-2 uppercase tracking-wider">AgendaPro</p>
                  {row.otherType === "check" ? (
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-green-100">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </span>
                  ) : row.otherType === "cross" ? (
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-red-100">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </span>
                  ) : (
                    <p class="text-[13px] text-gray-500 leading-snug">{row.other}</p>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ── 3. VERDICT ── -->
    <section class="bg-gray-50 py-20 px-6">
      <div class="max-w-3xl mx-auto space-y-10">

        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="w-8 h-8 rounded-full bg-[#EFF8FF] border border-[#B9E0FB] flex items-center justify-center shrink-0">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <h2 class="text-xl font-extrabold text-[#101828]">¿Cuándo elegir AKDEMIApp?</h2>
          </div>
          <p class="text-[16px] text-gray-600 leading-relaxed pl-11">
            Si tu negocio es una academia de danza, artes marciales, música o deportes, AKDEMIApp fue construido específicamente para ti. Con 5 funcionalidades de inteligencia artificial, 3 portales diferenciados y herramientas diseñadas por directores de academia, es la opción más completa para el mercado latinoamericano.
          </p>
        </div>

        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="w-8 h-8 rounded-full bg-gray-100 border border-gray-200 flex items-center justify-center shrink-0">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <h2 class="text-xl font-extrabold text-[#101828]">¿Cuándo elegir AgendaPro?</h2>
          </div>
          <p class="text-[16px] text-gray-600 leading-relaxed pl-11">
            Si tu negocio combina servicios de belleza, salud y clases, y necesitas un sistema de reservas de citas individual, AgendaPro puede ser más adecuado.
          </p>
        </div>

      </div>
    </section>

    <!-- ── 4. CTA ── -->
    <section class="bg-[#101828] py-24 px-6">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-10 tracking-tight">
          ¿Quieres verlo en acción?
        </h2>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-5">
          <a
            href={REGISTRO_URL}
            class="flex items-center gap-2.5 bg-[#399ABE] hover:bg-[#2e87ab] text-white font-semibold text-[15px] px-7 py-3.5 rounded-xl shadow-lg shadow-[#399ABE]/25 transition-all duration-200 hover:-translate-y-0.5 w-full sm:w-auto justify-center"
          >
            Empieza gratis
          </a>
          <a
            href={FERNANDO_WA}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-direct="true"
            class="flex items-center gap-2 bg-white/10 hover:bg-white/15 text-white font-medium text-[15px] px-6 py-3.5 rounded-xl border border-white/20 transition-all duration-200 w-full sm:w-auto justify-center"
          >
            Hablar con Fernando
          </a>
        </div>
        <p class="text-gray-500 text-xs">14 días gratis · Sin tarjeta de crédito</p>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
