---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";

interface MiniBlock {
  icon: string;
  title: string;
  description: string;
}

interface Feature {
  id: string;
  title: string;
  description: string;
  benefits: string[];
  image: string;
  imageLeft: boolean;
  mobileImage?: string;
  imagePlaceholder?: boolean;
  miniBlocks?: MiniBlock[];
}

const features: Feature[] = [
  {
    id: "alumnos",
    title: "Gestión de Alumnos",
    description:
      "Ficha completa de cada estudiante con foto, datos personales, historial de pagos, asistencia y evaluaciones. Vista de cards o lista.",
    benefits: [
      "Vista cards y lista",
      "Filtros por estado y nivel",
      "Importar y exportar CSV",
      "Ficha 360°: contacto, pagos, asistencia, evaluaciones y emergencia",
    ],
    image: "/features/alumnos-cards.png",
    imageLeft: true,
  },
  {
    id: "crm",
    title: "CRM de Prospectos",
    description:
      "Pipeline visual tipo Kanban para seguir cada prospecto desde el primer contacto hasta la inscripción. Con temperatura de lead y score automático.",
    benefits: [
      "Kanban drag & drop",
      "Temperatura Frío/Tibio/Caliente",
      "Score automático",
      "Seguimiento por WhatsApp",
    ],
    image: "/features/crm-kanban.png",
    imageLeft: false,
  },
  {
    id: "comunicaciones",
    title: "Comunicaciones",
    description:
      "Mantén informados a padres, alumnos y profesores. Envía recordatorios de cobro, avisos de clase y felicitaciones de cumpleaños desde un solo lugar.",
    benefits: [
      "WhatsApp masivo con plantillas",
      "Email con branding de tu academia",
      "Recordatorios automáticos de pago",
      "Notificaciones de cumpleaños y certificados",
    ],
    image: "/screenshots/comunicaciones.png",
    imageLeft: false,
    imagePlaceholder: false,
  },
  {
    id: "asistencia",
    title: "Asistencia y Control",
    description:
      "Registra la asistencia de cada clase de forma manual o con código QR. Historial completo por alumno y reportes de asistencia por período.",
    benefits: [
      "Asistencia manual con un clic",
      "Escaneo QR por alumno",
      "Historial de asistencia por estudiante",
      "Reportes por clase y período",
    ],
    image: "/screenshots/asistencia.png",
    imageLeft: true,
    imagePlaceholder: false,
  },
  {
    id: "reportes",
    title: "Reportes y Exportaciones",
    description:
      "Toda la información de tu academia lista para descargar. Genera reportes financieros, de asistencia y de alumnos en el formato que necesites.",
    benefits: [
      "Exportar a CSV, PDF y Excel",
      "Reporte de ingresos, egresos y pendientes",
      "Reportes de asistencia por período",
      "Filtros por fecha, estado y disciplina",
    ],
    image: "/screenshots/reportes.png",
    imageLeft: false,
    imagePlaceholder: false,
  },
  {
    id: "nomina",
    title: "Nómina de Profesores",
    description:
      "Calcula pagos a profesores por clase, hora o período. Genera recibos PDF automáticos con firma digital que el profesor puede descargar.",
    benefits: [
      "Pago por clase, hora o monto fijo",
      "Recibos PDF con firma digital",
      "Historial de pagos por profesor",
      "Integrado con el calendario de clases",
    ],
    image: "/screenshots/nomina.png",
    imageLeft: true,
    imagePlaceholder: false,
  },
  {
    id: "cobros",
    title: "Cobros y Pagos",
    description:
      "Control total de mensualidades, inscripciones, paquetes y abonos parciales. Dashboard con totales facturados, cobrados y pendientes en tiempo real.",
    benefits: [
      "Dashboard financiero",
      "Abonos parciales",
      "Recibos PDF automáticos",
      "Filtros por estado y tipo",
    ],
    image: "/features/cobros-pagos.png",
    imageLeft: true,
  },
  {
    id: "calendario",
    title: "Calendario y Agenda",
    description:
      "Vista mensual, semanal y diaria de todas las clases. Código de colores por disciplina, filtros por tipo de clase e instructor.",
    benefits: [
      "Vista mes/semana/día",
      "Colores por disciplina",
      "Clases grupales e individuales",
      "Exportar a PDF",
    ],
    image: "/features/calendario.png",
    imageLeft: false,
  },
  {
    id: "portal",
    title: "Portales Personalizados",
    description:
      "Cada usuario accede a su propio portal con la información que le corresponde. Tres portales independientes con credenciales propias y branding de tu academia.",
    benefits: [],
    miniBlocks: [
      { icon: "student", title: "Portal del Alumno", description: "Clases, horarios, pagos, recibos, QR personal y certificados" },
      { icon: "parents", title: "Portal del Padre", description: "Ve las clases, pagos y progreso de sus hijos. Recibe notificaciones y puede pagar en línea" },
      { icon: "teacher", title: "Portal del Profesor", description: "Sus clases asignadas, lista de alumnos, asistencia y evaluaciones pendientes" },
    ],
    image: "/features/portal-alumno.png",
    imageLeft: false,
    mobileImage: "/features/portal-alumno-mobile.png",
  },
  {
    id: "sitio-web",
    title: "Sitio Web para tu Academia",
    description:
      "Crea una página web profesional en minutos con el wizard de 7 pasos. Se auto-completa con tu logo, colores y disciplinas. Incluye formulario de contacto, tienda y reserva de clase de prueba.",
    benefits: [
      "Wizard guiado de 7 pasos",
      "Auto-populate desde tu academia",
      "Tienda integrada",
      "Formulario → CRM automático",
    ],
    image: "/features/website-builder.png",
    imageLeft: true,
    mobileImage: "/features/website-builder-mobile.png",
  },
];
---

<Layout
  title="Funcionalidades — Software de Gestión para Academias"
  description="Más de 35 herramientas para gestionar alumnos, cobros, agenda, CRM, portales y más. Diseñado para academias de danza, artes marciales, música y deportes."
>
  <Navbar />

  <main class="pt-16">
    <!-- HERO -->
    <section class="bg-gradient-to-b from-[#EFF8FF] to-white py-20 px-6">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-block text-[12px] font-bold uppercase tracking-widest text-[#155D88] bg-[#EFF8FF] border border-[#155D88]/20 px-3 py-1 rounded-full mb-5">
          Funcionalidades
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-[#101828] leading-tight tracking-tight mb-5">
          Todo lo que necesitas para gestionar tu academia
        </h1>
        <p class="text-[17px] text-gray-500 leading-relaxed">
          Más de 35 herramientas diseñadas para academias de danza, artes marciales, música, deportes y bienestar en Latinoamérica.
        </p>
      </div>
    </section>

    <!-- FEATURE SECTIONS -->
    {features.map((feature, index) => (
      <section
        id={feature.id}
        style="scroll-margin-top: 72px;"
        class={`py-20 px-6 ${index % 2 === 0 ? "bg-white" : "bg-[#F8FAFC]"}`}
      >
        <div class="max-w-6xl mx-auto">
          <div class={`flex flex-col gap-12 lg:gap-16 lg:flex-row items-center ${feature.imageLeft ? "" : "lg:flex-row-reverse"}`}>

            <!-- Screenshot(s) -->
            <div class="w-full lg:w-1/2 shrink-0">
              {feature.imagePlaceholder ? (
                <div class="rounded-2xl border border-gray-200 bg-gray-100 flex items-center justify-center aspect-video">
                  <p class="text-gray-400 text-sm font-medium">Screenshot próximamente</p>
                </div>
              ) : feature.mobileImage ? (
                <div class="flex flex-col sm:flex-row gap-6 items-start">
                  <div class="rounded-2xl shadow-lg overflow-hidden border border-gray-200 flex-1">
                    <img
                      src={feature.image}
                      alt={feature.title}
                      class="w-full h-auto block"
                      loading="lazy"
                    />
                  </div>
                  <img
                    src={feature.mobileImage}
                    alt={`${feature.title} — vista móvil`}
                    class="rounded-2xl shadow-lg border border-gray-200 max-h-[400px] w-auto"
                    loading="lazy"
                  />
                </div>
              ) : (
                <div class="rounded-2xl shadow-lg overflow-hidden border border-gray-200">
                  <img
                    src={feature.image}
                    alt={feature.title}
                    class="w-full h-auto block"
                    loading="lazy"
                  />
                </div>
              )}
            </div>

            <!-- Text -->
            <div class="w-full lg:w-1/2">
              <h2 class="text-3xl sm:text-4xl font-extrabold text-[#101828] leading-tight tracking-tight mb-4">
                {feature.title}
              </h2>
              <p class="text-[16px] text-gray-500 leading-relaxed mb-8">
                {feature.description}
              </p>
              {feature.miniBlocks ? (
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  {feature.miniBlocks.map((block) => (
                    <div class="bg-[#F8FAFC] rounded-xl p-4 border border-gray-100">
                      <div class="w-8 h-8 rounded-lg bg-[#EFF8FF] flex items-center justify-center mb-3">
                        {block.icon === 'student' && (
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                          </svg>
                        )}
                        {block.icon === 'parents' && (
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                          </svg>
                        )}
                        {block.icon === 'teacher' && (
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                          </svg>
                        )}
                      </div>
                      <p class="font-semibold text-[#101828] text-[14px] mb-1.5">{block.title}</p>
                      <p class="text-[13px] text-gray-500 leading-relaxed">{block.description}</p>
                    </div>
                  ))}
                </div>
              ) : (
                <ul class="space-y-3">
                  {feature.benefits.map((benefit) => (
                    <li class="flex items-center gap-3">
                      <span class="shrink-0 w-5 h-5 rounded-full bg-[#EFF8FF] flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="20 6 9 17 4 12"/>
                        </svg>
                      </span>
                      <span class="text-[15px] text-gray-700 font-medium">{benefit}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>

          </div>
        </div>
      </section>
    ))}

    <!-- Y MUCHO MÁS -->
    <section class="bg-gray-50 py-20 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#101828] leading-tight tracking-tight mb-3">
            Y mucho más...
          </h2>
          <p class="text-[16px] text-gray-500 max-w-xl mx-auto">
            Cada detalle pensado para que gestionar tu academia sea más fácil
          </p>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">

          <!-- Ticket / Eventos y Boletería -->
          <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
            <svg class="mb-3" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#399ABE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/>
              <path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/>
            </svg>
            <p class="text-sm font-semibold text-[#101828] mb-1">Eventos y Boletería</p>
            <p class="text-sm text-gray-500 leading-relaxed">Crea eventos, vende boletos y controla acceso con QR</p>
          </div>

          <!-- Package / Inventario -->
          <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
            <svg class="mb-3" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#399ABE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
              <path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>
            </svg>
            <p class="text-sm font-semibold text-[#101828] mb-1">Inventario</p>
            <p class="text-sm text-gray-500 leading-relaxed">Controla productos, uniformes y materiales con stock en tiempo real</p>
          </div>

          <!-- FileCheck / Reglamento Digital -->
          <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
            <svg class="mb-3" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#399ABE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
              <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
              <path d="m9 15 2 2 4-4"/>
            </svg>
            <p class="text-sm font-semibold text-[#101828] mb-1">Reglamento Digital</p>
            <p class="text-sm text-gray-500 leading-relaxed">Publica las reglas de tu academia. Padres y alumnos firman digitalmente</p>
          </div>

          <!-- Trophy / Competencias y Torneos -->
          <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
            <svg class="mb-3" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#399ABE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
              <path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
              <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
              <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
            </svg>
            <p class="text-sm font-semibold text-[#101828] mb-1">Competencias y Torneos</p>
            <p class="text-sm text-gray-500 leading-relaxed">Organiza torneos internos con brackets y resultados</p>
          </div>

          <!-- Receipt / Facturación Electrónica -->
          <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
            <svg class="mb-3" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#399ABE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/>
              <path d="M16 8H8"/><path d="M16 12H8"/><path d="M16 16H8"/>
            </svg>
            <p class="text-sm font-semibold text-[#101828] mb-1">Facturación Electrónica</p>
            <p class="text-sm text-gray-500 leading-relaxed">Integración con Yappy y PagueloFácil para Panamá</p>
          </div>

          <!-- CreditCard / POS y Tipos de Pago -->
          <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
            <svg class="mb-3" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#399ABE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="14" x="2" y="5" rx="2"/>
              <line x1="2" x2="22" y1="10" y2="10"/>
            </svg>
            <p class="text-sm font-semibold text-[#101828] mb-1">POS y Tipos de Pago</p>
            <p class="text-sm text-gray-500 leading-relaxed">Punto de venta físico configurable por academia</p>
          </div>

          <!-- ShoppingCart / Tienda Online -->
          <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
            <svg class="mb-3" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#399ABE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/>
              <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
            </svg>
            <p class="text-sm font-semibold text-[#101828] mb-1">Tienda Online</p>
            <p class="text-sm text-gray-500 leading-relaxed">Vende productos y paquetes directamente desde tu sitio web</p>
          </div>

          <!-- Smartphone / App Instalable (PWA) -->
          <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
            <svg class="mb-3" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#399ABE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/>
              <path d="M12 18h.01"/>
            </svg>
            <p class="text-sm font-semibold text-[#101828] mb-1">App Instalable (PWA)</p>
            <p class="text-sm text-gray-500 leading-relaxed">Tus usuarios instalan la app sin pasar por tiendas</p>
          </div>

          <!-- Palette / Disciplinas Configurables -->
          <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
            <svg class="mb-3" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#399ABE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="13.5" cy="6.5" r=".5" fill="#399ABE"/>
              <circle cx="17.5" cy="10.5" r=".5" fill="#399ABE"/>
              <circle cx="8.5" cy="7.5" r=".5" fill="#399ABE"/>
              <circle cx="6.5" cy="12.5" r=".5" fill="#399ABE"/>
              <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>
            </svg>
            <p class="text-sm font-semibold text-[#101828] mb-1">Disciplinas Configurables</p>
            <p class="text-sm text-gray-500 leading-relaxed">Define las disciplinas, niveles y horarios de tu academia</p>
          </div>

          <!-- MessageSquare / Vocabulario Personalizado -->
          <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
            <svg class="mb-3" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#399ABE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            <p class="text-sm font-semibold text-[#101828] mb-1">Vocabulario Personalizado</p>
            <p class="text-sm text-gray-500 leading-relaxed">Cambia 'alumno' por 'atleta', 'clase' por 'sesión' y más</p>
          </div>

          <!-- Building2 / Multi-sede -->
          <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
            <svg class="mb-3" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#399ABE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/>
              <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/>
              <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/>
              <path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/>
            </svg>
            <p class="text-sm font-semibold text-[#101828] mb-1">Multi-sede</p>
            <p class="text-sm text-gray-500 leading-relaxed">Gestiona varias sedes desde un solo panel de administración</p>
          </div>

          <!-- FormInput / Campos Adicionales -->
          <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
            <svg class="mb-3" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#399ABE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="6" width="20" height="12" rx="2"/>
              <path d="M8 12h.01"/><path d="M8 6V4"/><path d="M8 20v-2"/>
              <path d="M16 12h.01"/>
            </svg>
            <p class="text-sm font-semibold text-[#101828] mb-1">Campos Adicionales</p>
            <p class="text-sm text-gray-500 leading-relaxed">Agrega campos personalizados al formulario de inscripción</p>
          </div>

        </div>
      </div>
    </section>

    <!-- AI BLOCK -->
    <section class="bg-slate-900 text-white py-20 px-6">
      <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <div class="text-center mb-14">
          <span class="inline-block text-[11px] font-bold uppercase tracking-widest text-[#399ABE] bg-[#399ABE]/10 border border-[#399ABE]/30 px-3 py-1 rounded-full mb-5">
            Inteligencia Artificial
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold leading-tight tracking-tight mb-4">
            Tu academia con superpoderes
          </h2>
          <p class="text-[17px] text-slate-400 max-w-2xl mx-auto">
            La única plataforma para academias con IA integrada en cada módulo
          </p>
        </div>

        <!-- Cards grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-10">
          <!-- AKDI -->
          <div class="rounded-2xl border border-slate-700 bg-slate-800/60 p-6 hover:border-[#399ABE]/50 transition-colors">
            <p class="text-[11px] font-bold uppercase tracking-widest text-[#399ABE] mb-3">AKDI</p>
            <p class="text-[14px] text-slate-300 leading-relaxed">Tu asistente IA. Pregúntale cualquier cosa sobre tu academia y responde con datos reales en 3 segundos.</p>
          </div>
          <!-- Escaneo Inteligente -->
