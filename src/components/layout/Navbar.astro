<script>
  function initNavbar() {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("icon-open");
    const iconClose = document.getElementById("icon-close");
    const navbarInner = document.getElementById("navbar-inner");
    const recursosToggle = document.getElementById("recursos-toggle");
    const recursosSubmenu = document.getElementById("recursos-submenu");
    const recursosChevron = document.getElementById("recursos-chevron");
    let isOpen = false;

    function closeMenu() {
      isOpen = false;
      menu?.classList.add("hidden");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      document.body.style.overflow = "";
      recursosSubmenu?.classList.add("hidden");
      if (recursosChevron) recursosChevron.style.transform = "";
    }

    function onScroll() {
      if (window.scrollY > 10) {
        navbarInner?.classList.add("shadow-md");
      } else {
        navbarInner?.classList.remove("shadow-md");
      }
    }

    btn?.addEventListener("click", () => {
      isOpen = !isOpen;
      menu?.classList.toggle("hidden", !isOpen);
      iconOpen?.classList.toggle("hidden", isOpen);
      iconClose?.classList.toggle("hidden", !isOpen);
      document.body.style.overflow = isOpen ? "hidden" : "";
      if (!isOpen) {
        recursosSubmenu?.classList.add("hidden");
        if (recursosChevron) recursosChevron.style.transform = "";
      }
    });

    recursosToggle?.addEventListener("click", () => {
      const nowHidden = recursosSubmenu?.classList.toggle("hidden");
      if (recursosChevron) {
        recursosChevron.style.transform = nowHidden ? "" : "rotate(180deg)";
      }
    });

    menu?.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", closeMenu);
    });

    window.addEventListener("scroll", onScroll);
    onScroll();
  }

  document.addEventListener("astro:page-load", initNavbar);
</script>
