---
import { getSettings } from "@/services/settings";
import { getStrapiMedia } from "@/lib/api";

const settings = await getSettings();
const logoUrl = settings?.footer?.logo
  ? getStrapiMedia(settings.footer.logo.url)
  : "/AKDEMIApp-Logo.png";

const currentYear = new Date().getFullYear();
const WA_LINK = "https://wa.me/50765726078?text=Hola%2C%20me%20interesa%20una%20demo%20de%20AKDEMIApp";
const LOGIN_URL = "https://app.akdemiapp.online/login";
---

<!-- FOOTER -->
<footer class="bg-[#101828] pt-16 pb-0">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-12 pb-12 border-b border-white/[0.06]">

      <!-- Col 1: Brand -->
      <div>
        <div class="flex items-center gap-2.5 mb-4">
          <img src={logoUrl} alt="AKDEMIApp" class="w-8 h-8 object-contain" />
          <span class="text-[18px] font-bold text-white tracking-tight">
            AKDEMI<span class="text-[#399ABE]">App</span>
          </span>
        </div>
        <p class="text-[13px] text-[#5a7080] leading-[1.75] mb-5 max-w-[260px]">
          El primer CRM AI-Native para academias latinoamericanas. Gestiona alumnos, cobros, clases y comunicaciones desde un solo lugar.
        </p>
        <a href={WA_LINK} target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-2 bg-[#399ABE]/[0.12] hover:bg-[#399ABE]/[0.2] border border-[#399ABE]/25 text-[#399ABE] px-4 py-2 rounded-lg text-[12px] font-semibold transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="#399ABE">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          +507 6572 6078
        </a>
      </div>

      <!-- Col 2: Producto -->
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[0.09em] text-[#3a4a5a] mb-4">Producto</p>
        <nav class="flex flex-col gap-2.5">
          <a href="/#features" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Funcionalidades</a>
          <a href="/blog" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Blog</a>
          <a href="/ayuda" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Centro de Ayuda</a>
          <a href="/#pricing" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Planes y Precios</a>
          <a href="/#faq" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Preguntas Frecuentes</a>
          <a href="/#testimonios" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Testimonios</a>
          <a href={LOGIN_URL} class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Iniciar sesión</a>
          <a href={LOGIN_URL} class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Empieza gratis</a>
        </nav>
      </div>

      <!-- Col 3: Academias -->
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[0.09em] text-[#3a4a5a] mb-4">Academias</p>
        <nav class="flex flex-col gap-2.5">
          <a href="/academia-danzas/" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Baile y Danza</a>
          <a href="/academia-artes-marciales/" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Artes Marciales</a>
          <a href="/academia-musica/" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Música</a>
          <a href="/academia-arte/" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Artes Plásticas</a>
          <a href="/academia-teatro/" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Artes Escénicas</a>
          <a href="/academia-yoga/" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Yoga y Pilates</a>
          <a href="/academia-futbol/" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Deportes</a>
          <a href="/academia-idiomas/" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Formación e Idiomas</a>
        </nav>
      </div>

      <!-- Col 4: Recursos -->
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[0.09em] text-[#3a4a5a] mb-4">Recursos</p>
        <nav class="flex flex-col gap-2.5">
          <a href="/integraciones" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Integraciones</a>
          <a href="/comparar/akdemiapp-vs-agendapro" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">AKDEMIApp vs AgendaPro</a>
          <a href="/comparar/akdemiapp-vs-timp" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">AKDEMIApp vs TIMP</a>
        </nav>
      </div>

      <!-- Col 5: Empresa + Legal -->
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[0.09em] text-[#3a4a5a] mb-4">Empresa</p>
        <nav class="flex flex-col gap-2.5 mb-6">
          <a href="/#nosotros" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Nosotros</a>
          <a href="https://procesoptimo.com" target="_blank" rel="noopener noreferrer" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">ProcesOptimo</a>
          <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Contacto</a>
        </nav>
        <p class="text-[10px] font-bold uppercase tracking-[0.09em] text-[#3a4a5a] mb-4">Legal</p>
        <nav class="flex flex-col gap-2.5">
          <a href="/terminos" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Términos de Servicio</a>
          <a href="/privacidad" class="text-[13px] text-[#8a9ab0] hover:text-[#399ABE] transition-colors">Política de Privacidad</a>
        </nav>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 py-5">
      <p class="text-[12px] text-[#3a4a5a]">© {currentYear} AKDEMIApp. Todos los derechos reservados.</p>
      <div class="flex gap-5">
        <a href="/terminos" class="text-[12px] text-[#3a4a5a] hover:text-[#399ABE] transition-colors">Términos</a>
        <a href="/privacidad" class="text-[12px] text-[#3a4a5a] hover:text-[#399ABE] transition-colors">Privacidad</a>
      </div>
      <p class="text-[12px] text-[#3a4a5a]">
        Hecho con <span class="text-[#e74c3c]">❤</span> por
        <a href="https://procesoptimo.com" target="_blank" rel="noopener noreferrer"
           class="text-[#399ABE] font-semibold hover:text-white transition-colors">ProcesOptimo</a>
      </p>
    </div>

  </div>
</footer>
