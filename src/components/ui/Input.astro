---
/**
 * Input - Componente de input reutilizable
 *
 * Input field con label, validación, estados de error y accesibilidad completa.
 * Diseñado para integrarse con el sistema de diseño de AkdemiApp.
 */

interface Props {
  /**
   * Nombre del campo (atributo name del input)
   */
  name: string;

  /**
   * Etiqueta visible del campo
   */
  label: string;

  /**
   * Tipo de input (text, email, tel, etc.)
   */
  type?: string;

  /**
   * Texto de ayuda/placeholder
   */
  placeholder?: string;

  /**
   * Si el campo es obligatorio
   */
  required?: boolean;

  /**
   * Mensaje de error a mostrar
   */
  error?: string;

  /**
   * Valor por defecto del input
   */
  value?: string;

  /**
   * Patrón de validación regex
   */
  pattern?: string;

  /**
   * Mensaje del pattern para accesibilidad
   */
  title?: string;

  /**
   * Número mínimo de caracteres
   */
  minlength?: number;

  /**
   * Número máximo de caracteres
   */
  maxlength?: number;

  /**
   * Clases CSS adicionales
   */
  class?: string;

  /**
   * ID del campo (si no se proporciona, usa name)
   */
  id?: string;
}

const {
  name,
  label,
  type = "text",
  placeholder,
  required = false,
  error,
  value = "",
  pattern,
  title,
  minlength,
  maxlength,
  class: className = "",
  id = name,
} = Astro.props;

const errorId = `${id}-error`;
const hasError = error && error.length > 0;
---

<div class={`form-group ${className}`}>
  <label
    for={id}
    class="block text-sm font-medium text-gray-700 mb-2"
  >
    {label}
    {required && <span class="text-red-500 ml-1" aria-label="obligatorio">*</span>}
  </label>

  <input
    type={type}
    id={id}
    name={name}
    value={value}
    placeholder={placeholder}
    required={required}
    pattern={pattern}
    title={title}
    minlength={minlength}
    maxlength={maxlength}
    aria-required={required}
    aria-invalid={hasError}
    aria-describedby={hasError ? errorId : undefined}
    class={`
      w-full px-4 py-3
      rounded-lg
      border-2
      ${hasError ? 'border-red-500 focus:border-red-600 focus:ring-red-500/20' : 'border-gray-200 focus:border-primary-600 focus:ring-primary-500/20'}
      bg-white
      text-gray-900
      placeholder-gray-400
      transition-all duration-200
      hover:border-gray-300
      focus:outline-none focus:ring-4
      disabled:bg-gray-100 disabled:cursor-not-allowed
    `}
  />

  {hasError && (
    <div
      id={errorId}
      class="mt-2 flex items-center gap-2 text-red-600 text-sm animate-slideDown"
      role="alert"
    >
      <svg
        class="w-4 h-4 flex-shrink-0"
        fill="currentColor"
        viewBox="0 0 20 20"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
          clip-rule="evenodd"
        />
      </svg>
      <span>{error}</span>
    </div>
  )}
</div>

<style>
  .form-group {
    position: relative;
  }

  /* Animación para mostrar errores */
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-slideDown {
    animation: slideDown 0.2s ease-out;
  }

  /* Estado de validación exitosa (opcional, se puede activar con JS) */
  input:not(:placeholder-shown):valid:not(:focus) {
    border-color: #10b981; /* green-500 */
  }

  /* Eliminar estilos por defecto del navegador en algunos campos */
  input[type="search"]::-webkit-search-decoration,
  input[type="search"]::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
</style>
