---
/**
 * EmptyContentState Component
 * Displays a friendly message when content is unavailable from the API
 */

interface Props {
  title?: string;
  message?: string;
  icon?: string;
  showInDev?: boolean;
}

const {
  title = "Contenido No Disponible",
  message = "El contenido de esta sección no está disponible en este momento. Por favor, intenta más tarde.",
  icon = "📭",
  showInDev = true
} = Astro.props;

// Only show in development mode if showInDev is true
const isDev = import.meta.env.DEV;
const shouldShow = isDev || !showInDev;
---

{shouldShow && (
  <div class="py-12 px-4">
    <div class="max-w-md mx-auto text-center">
      <div class="text-6xl mb-4">{icon}</div>
      <h3 class="text-xl font-semibold text-gray-800 mb-2">{title}</h3>
      <p class="text-gray-600 mb-4">{message}</p>
      {isDev && (
        <div class="mt-4 p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
          <p class="text-xs text-gray-500">
            💡 Modo desarrollo: Verifica que Strapi esté corriendo y tenga contenido publicado
          </p>
        </div>
      )}
    </div>
  </div>
)}
