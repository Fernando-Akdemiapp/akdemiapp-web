---
/**
 * CTA Section - Dynamic Call-to-Action with optional stats
 */
import Button from "../ui/Button.astro";
import CTAButton from "../ui/CTAButton.astro";
import EmptyContentState from "../ui/EmptyContentState.astro";
import { getSiteStats } from "@/services/stats";
import type { CTASection as CTASectionProps } from '@/types/Page';

type Props = Partial<CTASectionProps>;

const {
  title = "Deja de perder tiempo y dinero con hojas de cálculo",
  description = "Más de 500 academias como la tuya ya están cobrando automáticamente, ahorrando 20+ horas semanales y creciendo sin caos. Agenda tu demostración personalizada hoy.",
  primaryButtonText = "Agenda tu Demo Gratis",
  primaryButtonLink = "#contact",
  secondaryButtonText = "Ver Precios",
  secondaryButtonLink = "/#pricing",
  showStats = true,
  backgroundColor = 'gradient'
} = Astro.props;

const stats = showStats ? await getSiteStats() : null;

if (import.meta.env.PROD && showStats && !stats) {
  console.warn('⚠️ CTA Section: Stats requested but not available from API');
}

const bgClass = backgroundColor === 'primary'
  ? 'bg-gradient-to-br from-[#0d3d5e] to-[#155D88]'
  : backgroundColor === 'secondary'
  ? 'bg-gradient-to-br from-[#155D88] to-[#1a7aad]'
  : 'bg-gradient-to-br from-[#0d3d5e] via-[#155D88] to-[#1a7aad]';
---

<section id="contact" class={`py-16 lg:py-24 ${bgClass} relative overflow-hidden`}>
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6">
        {title}
      </h2>
      <p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
        {description}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <button
          onclick="window.openLeadModal && window.openLeadModal()"
          class="inline-flex items-center justify-center px-8 py-4 bg-white text-[#155D88] hover:bg-gray-50 shadow-xl hover:shadow-2xl transform hover:-translate-y-1 font-bold rounded-lg transition-all duration-200 text-lg cursor-pointer border-0"
        >
          Agenda una demo
        </button>

        <a
          href="https://app.akdemiapp.online/registro/academia"
          class="inline-flex items-center justify-center px-8 py-4 bg-transparent text-white font-bold rounded-lg border-2 border-white hover:bg-white/10 transition-all duration-200 text-lg"
        >
          Empieza gratis
        </a>
      </div>

      {showStats && stats && (
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 items-center pt-12 border-t border-white/20">
          <div class="text-center">
            <p class="text-4xl font-bold text-white mb-1">30 min</p>
            <p class="text-white/80 text-sm">Demostración personalizada</p>
          </div>
          <div class="text-center">
            <p class="text-4xl font-bold text-white mb-1">{stats.hoursPerMonthSaved}+</p>
            <p class="text-white/80 text-sm">Horas ahorradas/mes</p>
          </div>
          <div class="text-center">
            <p class="text-4xl font-bold text-white mb-1">{stats.satisfactionRate}%</p>
            <p class="text-white/80 text-sm">Lo recomendaría</p>
          </div>
          <div class="text-center">
            <p class="text-4xl font-bold text-white mb-1">{stats.totalAcademies}+</p>
            <p class="text-white/80 text-sm">Academias confían en nosotros</p>
          </div>
        </div>
      )}
    </div>
  </div>
</section>
