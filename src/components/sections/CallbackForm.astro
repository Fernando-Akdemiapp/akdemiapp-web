---
/**
 * CallbackForm - Formulario de contacto "Nosotros te Llamamos"
 *
 * Refactored to receive props from Page Builder (Strapi CMS)
 * Uses CallbackFormSection type from @/types/Page
 *
 * IMPORTANT: Form logic and validation preserved - only title/subtitle use props
 */

import Card from "../ui/Card.astro";
import Badge from "../ui/Badge.astro";
import Input from "../ui/Input.astro";
import Select from "../ui/Select.astro";
import Button from "../ui/Button.astro";
import type { CallbackFormSection as CallbackFormSectionProps } from '@/types/Page';

// Make props optional for backwards compatibility with old pages
type Props = Partial<CallbackFormSectionProps>;

// Default phone prefixes for fallback
const defaultPhonePrefixes = [
  { value: "+507", label: "+507 (Panamá)" },
  { value: "+34", label: "+34 (España)" },
  { value: "+52", label: "+52 (México)" },
  { value: "+1", label: "+1 (USA/Canadá)" },
  { value: "+54", label: "+54 (Argentina)" },
  { value: "+56", label: "+56 (Chile)" },
  { value: "+57", label: "+57 (Colombia)" },
  { value: "+51", label: "+51 (Perú)" },
];

const {
  formTitle = "Nosotros te Llamamos",
  formDescription = "¿Alguna duda? ¡Estamos encantados de poder ayudarte! Solo tienes que dejarnos tu teléfono y pronto recibirás una llamada de uno de nuestros expertos. Explícanos cómo quieres mejorar tu academia y juntos encontraremos la mejor solución para ti.",
  submitButtonText = "Quiero que me llamen",
  successMessage = "¡Gracias por tu interés! Te contactaremos pronto para resolver todas tus dudas.",
  errorMessage = "Por favor, intenta nuevamente o contacta a soporte.",
  privacyText = "Usaremos estos datos para contactarte y resolver tus dudas por teléfono.",
  phonePrefixes = defaultPhonePrefixes,
  defaultPrefix = "+507"
} = Astro.props;
---

<section class="py-16 lg:py-24 bg-gradient-to-b from-gray-50 to-white relative overflow-hidden">
  <!-- Elementos decorativos de fondo -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div
      class="absolute top-20 right-10 w-72 h-72 bg-primary-100 rounded-full mix-blend-multiply filter blur-xl opacity-20 animate-blob"
    >
    </div>
    <div
      class="absolute bottom-20 left-10 w-72 h-72 bg-secondary-100 rounded-full mix-blend-multiply filter blur-xl opacity-20 animate-blob animation-delay-2000"
    >
    </div>
  </div>

  <div class="w-full px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Formulario -->
    <Card class="shadow-xl border-2 border-gray-100 max-w-7xl mx-auto" padding="lg">
      <!-- Header dentro del Card -->
      <div class="mb-8 text-center">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-gray-900 mb-3">
          <span class="bg-gradient-to-r from-primary-600 to-secondary-600 bg-clip-text text-transparent">
            {formTitle}
          </span>
        </h2>

        <p class="text-base md:text-lg text-gray-600 max-w-4xl mx-auto">
          {formDescription}
        </p>
      </div>

      <form
        id="callback-form"
        class="space-y-6"
        novalidate
      >
        <!-- Grid para todos los campos + botón en una línea (desktop) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-end">
          <!-- Campo Nombre -->
          <div class="lg:col-span-4">
            <Input
              name="nombre"
              label="Nombre completo"
              type="text"
              placeholder="Ej: María García"
              required={true}
              minlength={3}
              maxlength={100}
              class="animate-fadeIn"
            />
          </div>

          <!-- Prefijo Telefónico -->
          <div class="lg:col-span-2">
            <Select
              name="prefijo"
              label="Prefijo"
              options={phonePrefixes}
              value={defaultPrefix}
              required={true}
              placeholder="Código"
              class="animate-fadeIn animation-delay-100"
            />
          </div>

          <!-- Número de Teléfono -->
          <div class="lg:col-span-3">
            <Input
              name="telefono"
              label="Número de teléfono"
              type="tel"
              placeholder="Ej: 12345678"
              required={true}
              pattern="[0-9]{6,15}"
              title="Ingresa un número de teléfono válido (6-15 dígitos)"
              minlength={6}
              maxlength={15}
              class="animate-fadeIn animation-delay-200"
            />
          </div>

          <!-- Botón de Envío -->
          <div class="lg:col-span-3">
            <Button
              type="submit"
              variant="primary"
              size="lg"
              class="w-full group animate-fadeIn animation-delay-300"
            >
              <svg
                class="w-5 h-5 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                />
              </svg>
              {submitButtonText}
              <svg
                class="w-5 h-5 ml-2 transition-transform group-hover:translate-x-1"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"
                />
              </svg>
            </Button>
          </div>
        </div>

        <!-- Nota de privacidad -->
        <div class="pt-2">
          <p class="text-sm text-gray-500">
            <svg
              class="w-4 h-4 inline-block mr-1"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z"
                clip-rule="evenodd"
              />
            </svg>
            {privacyText}
          </p>
        </div>

        <!-- Mensaje de éxito (oculto por defecto) -->
        <div
          id="success-message"
          class="hidden p-4 bg-green-50 border-2 border-green-200 rounded-lg"
          role="alert"
        >
          <div class="flex items-center gap-3">
            <svg
              class="w-6 h-6 text-green-600 flex-shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"
              />
            </svg>
            <div>
              <p class="font-semibold text-green-900">¡Gracias por tu interés!</p>
              <p class="text-green-700 text-sm">{successMessage}</p>
            </div>
          </div>
        </div>

        <!-- Mensaje de error (oculto por defecto) -->
        <div
          id="error-message"
          class="hidden p-4 bg-red-50 border-2 border-red-200 rounded-lg"
          role="alert"
        >
          <div class="flex items-center gap-3">
            <svg
              class="w-6 h-6 text-red-600 flex-shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                clip-rule="evenodd"
              />
            </svg>
            <div>
              <p class="font-semibold text-red-900">Error al enviar la solicitud</p>
              <p class="text-red-700 text-sm">{errorMessage}</p>
            </div>
          </div>
        </div>
      </form>
    </Card>
  </div>
</section>

<script>
  import { createCallbackRequest } from '../../services/callbacks';
  import type { CallbackRequest } from '../../types/CallbackRequest';

  function setupCallbackForm() {
    const form = document.getElementById('callback-form') as HTMLFormElement;
    const successMessage = document.getElementById('success-message');
    const errorMessage = document.getElementById('error-message');
    const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement;

    if (!form || !submitButton) return;

    // Guardar contenido original del botón
    const originalButtonContent = submitButton.innerHTML;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Validación HTML5
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      // Ocultar mensajes previos
      successMessage?.classList.add('hidden');
      errorMessage?.classList.add('hidden');

      // Obtener datos del formulario
      const formData = new FormData(form);
      const prefijo = formData.get('prefijo') as string;
      const telefono = formData.get('telefono') as string;

      const data: CallbackRequest = {
        nombre: formData.get('nombre') as string,
        prefijo,
        telefono,
        telefonoCompleto: `${prefijo} ${telefono}`,
        source: window.location.href,
      };

      // Estado de loading
      submitButton.disabled = true;
      submitButton.innerHTML = `
        <svg class="animate-spin h-5 w-5 mr-2 inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Enviando...
      `;

      try {
        // Llamada al API de Strapi
        const result = await createCallbackRequest(data);

        if (result) {
          // Mostrar mensaje de éxito
          if (successMessage) {
            successMessage.classList.remove('hidden');
            successMessage.classList.add('animate-fadeIn');
          }

          // Reset del formulario
          form.reset();

          // Ocultar mensaje después de 7 segundos
          setTimeout(() => {
            successMessage?.classList.add('hidden');
          }, 7000);

          console.log('✅ Solicitud de llamada enviada exitosamente:', result);
        } else {
          // Mostrar mensaje de error
          if (errorMessage) {
            errorMessage.classList.remove('hidden');
            errorMessage.classList.add('animate-fadeIn');
          }

          // Ocultar mensaje de error después de 7 segundos
          setTimeout(() => {
            errorMessage?.classList.add('hidden');
          }, 7000);

          console.error('❌ Error: No se pudo crear la solicitud de callback');
        }
      } catch (error) {
        // Mostrar mensaje de error
        if (errorMessage) {
          errorMessage.classList.remove('hidden');
          errorMessage.classList.add('animate-fadeIn');
        }

        // Ocultar mensaje de error después de 7 segundos
        setTimeout(() => {
          errorMessage?.classList.add('hidden');
        }, 7000);

        console.error('❌ Error al enviar solicitud:', error);
      } finally {
        // Restaurar botón
        submitButton.disabled = false;
        submitButton.innerHTML = originalButtonContent;
      }
    });
  }

  // Inicializar cuando la página cargue
  document.addEventListener('astro:page-load', setupCallbackForm);
</script>

<style>
  /* Delays para animaciones escalonadas */
  .animation-delay-100 {
    animation-delay: 0.1s;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-300 {
    animation-delay: 0.3s;
  }

  .animation-delay-2000 {
    animation-delay: 2s;
  }
</style>
