  <path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/>
</svg>
          </div>
          <div>
            <p class="text-[13px] font-bold text-[#101828] leading-tight">Evaluaciones</p>
            <p class="text-[11px] text-gray-400 mt-0.5 leading-snug">Carga con IA, rangos, niveles y firmas digitales</p>
