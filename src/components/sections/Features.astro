---
---

<section id="features" class="py-20 bg-[#f8faff]">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">

    <!-- Header -->
    <div class="mb-14">
      <span class="inline-block bg-[#EFF8FF] border border-[#B9E0FB] text-[#155D88] text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-5">
        Funcionalidades
      </span>
      <h2 class="text-4xl lg:text-5xl font-extrabold text-[#101828] tracking-tight leading-[1.08] mb-4">
        Todo lo que tu academia<br>
        <span class="bg-gradient-to-r from-[#155D88] to-[#399ABE] bg-clip-text text-transparent">
          necesita en un solo lugar
        </span>
      </h2>
      <p class="text-lg text-gray-500 max-w-xl leading-relaxed">
        Más de 35 funcionalidades diseñadas por directores de academia para resolver los problemas reales de cada día.
      </p>
    </div>

    <!-- 6 tarjetas principales -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="features-grid">
      <button
        type="button"
        data-panel="gestion"
        class="feature-card text-left bg-white border border-gray-200 rounded-2xl p-7 cursor-pointer transition-all duration-200 hover:border-[#155D88] hover:shadow-lg hover:-translate-y-1 relative overflow-hidden group"
      >
        <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-[#155D88] to-[#399ABE] opacity-0 group-hover:opacity-100 transition-opacity duration-200 panel-bar"></div>
        <div class="w-12 h-12 bg-[#EFF8FF] rounded-xl flex items-center justify-center mb-4 shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
  <path d="M6 12v5c3 3 9 3 12 0v-5"/>
</svg>
        </div>
        <h3 class="text-[16px] font-bold text-[#101828] mb-2 tracking-tight">Gestión de Academia</h3>
        <p class="text-[13px] text-gray-500 leading-relaxed mb-4">Alumnos, asistencias, clases, evaluaciones y reglamento en un solo panel.</p>
        <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-[#155D88]">
          5 funcionalidades
          <svg class="w-3.5 h-3.5 arrow-icon transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 9l-7 7-7-7"/></svg>
        </span>
      </button>
      <button
        type="button"
        data-panel="finanzas"
        class="feature-card text-left bg-white border border-gray-200 rounded-2xl p-7 cursor-pointer transition-all duration-200 hover:border-[#155D88] hover:shadow-lg hover:-translate-y-1 relative overflow-hidden group"
      >
        <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-[#155D88] to-[#399ABE] opacity-0 group-hover:opacity-100 transition-opacity duration-200 panel-bar"></div>
        <div class="w-12 h-12 bg-[#EFF8FF] rounded-xl flex items-center justify-center mb-4 shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  <rect x="1" y="4" width="22" height="22" rx="2"/>
  <line x1="1" y1="10" x2="23" y2="10"/>
</svg>
        </div>
        <h3 class="text-[16px] font-bold text-[#101828] mb-2 tracking-tight">Finanzas</h3>
        <p class="text-[13px] text-gray-500 leading-relaxed mb-4">Cobros, POS, reportes financieros y facturación integrada.</p>
        <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-[#155D88]">
          5 funcionalidades
          <svg class="w-3.5 h-3.5 arrow-icon transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 9l-7 7-7-7"/></svg>
        </span>
      </button>
      <button
        type="button"
        data-panel="captacion"
        class="feature-card text-left bg-white border border-gray-200 rounded-2xl p-7 cursor-pointer transition-all duration-200 hover:border-[#155D88] hover:shadow-lg hover:-translate-y-1 relative overflow-hidden group"
      >
        <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-[#155D88] to-[#399ABE] opacity-0 group-hover:opacity-100 transition-opacity duration-200 panel-bar"></div>
        <div class="w-12 h-12 bg-[#EFF8FF] rounded-xl flex items-center justify-center mb-4 shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
  <polyline points="17 6 23 6 23 12"/>
</svg>
        </div>
        <h3 class="text-[16px] font-bold text-[#101828] mb-2 tracking-tight">Captación y CRM</h3>
        <p class="text-[13px] text-gray-500 leading-relaxed mb-4">Pipeline Kanban, formularios online, reservas y boletería.</p>
        <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-[#155D88]">
          4 funcionalidades
          <svg class="w-3.5 h-3.5 arrow-icon transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 9l-7 7-7-7"/></svg>
        </span>
      </button>
      <button
        type="button"
        data-panel="comunicaciones"
        class="feature-card text-left bg-white border border-gray-200 rounded-2xl p-7 cursor-pointer transition-all duration-200 hover:border-[#155D88] hover:shadow-lg hover:-translate-y-1 relative overflow-hidden group"
      >
        <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-[#155D88] to-[#399ABE] opacity-0 group-hover:opacity-100 transition-opacity duration-200 panel-bar"></div>
        <div class="w-12 h-12 bg-[#EFF8FF] rounded-xl flex items-center justify-center mb-4 shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
  <polyline points="22,6 12,13 2,6"/>
</svg>
        </div>
        <h3 class="text-[16px] font-bold text-[#101828] mb-2 tracking-tight">Comunicaciones</h3>
        <p class="text-[13px] text-gray-500 leading-relaxed mb-4">WhatsApp con plantillas y masivo, email, notificaciones, cumpleaños y certificados.</p>
        <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-[#155D88]">
          6 funcionalidades
          <svg class="w-3.5 h-3.5 arrow-icon transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 9l-7 7-7-7"/></svg>
        </span>
      </button>
      <button
        type="button"
        data-panel="portales"
        class="feature-card text-left bg-white border border-gray-200 rounded-2xl p-7 cursor-pointer transition-all duration-200 hover:border-[#155D88] hover:shadow-lg hover:-translate-y-1 relative overflow-hidden group"
      >
        <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-[#155D88] to-[#399ABE] opacity-0 group-hover:opacity-100 transition-opacity duration-200 panel-bar"></div>
        <div class="w-12 h-12 bg-[#EFF8FF] rounded-xl flex items-center justify-center mb-4 shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
  <circle cx="9" cy="7" r="4"/>
  <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
  <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
</svg>
        </div>
        <h3 class="text-[16px] font-bold text-[#101828] mb-2 tracking-tight">Portales</h3>
        <p class="text-[13px] text-gray-500 leading-relaxed mb-4">Acceso personalizado para alumnos, padres y profesores.</p>
        <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-[#155D88]">
          3 portales
          <svg class="w-3.5 h-3.5 arrow-icon transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 9l-7 7-7-7"/></svg>
        </span>
      </button>
      <button
        type="button"
        data-panel="tecnologia"
        class="feature-card text-left bg-white border border-gray-200 rounded-2xl p-7 cursor-pointer transition-all duration-200 hover:border-[#155D88] hover:shadow-lg hover:-translate-y-1 relative overflow-hidden group"
