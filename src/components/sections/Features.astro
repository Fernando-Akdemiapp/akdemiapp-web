<style>
  .animate-fade-in {
    animation: fadeInPanel 0.2s ease forwards;
  }
  @keyframes fadeInPanel {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .feature-card.active {
    border-color: #155D88;
    box-shadow: 0 8px 28px rgba(21,93,136,0.14);
    transform: translateY(-4px);
  }
  .feature-card.active .panel-bar { opacity: 1; }
  .feature-card.active .arrow-icon { transform: rotate(180deg); }
</style>

<script>
  function initFeatures() {
    var cards = document.querySelectorAll('.feature-card');
    var panels = document.querySelectorAll('.feature-panel');
    var current = null;

    cards.forEach(function(card) {
      card.addEventListener('click', function() {
        var id = card.getAttribute('data-panel');
        var panel = document.getElementById('panel-' + id);

        if (current === id) {
          panel.classList.add('hidden');
          card.classList.remove('active');
          current = null;
          return;
        }

        panels.forEach(function(p) { p.classList.add('hidden'); });
        cards.forEach(function(c) { c.classList.remove('active'); });

        panel.classList.remove('hidden');
        card.classList.add('active');
        current = id;

        panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });
  }

  document.addEventListener('astro:page-load', initFeatures);
</script>
