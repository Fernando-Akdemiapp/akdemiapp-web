        <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-[#155D88] to-[#399ABE] opacity-0 group-hover:opacity-100 transition-opacity duration-200 panel-bar"></div>
        <div class="w-12 h-12 bg-[#EFF8FF] rounded-xl flex items-center justify-center mb-4 shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  <rect x="3" y="11" width="22" height="22" rx="2"/>
  <circle cx="12" cy="5" r="2"/>
  <path d="M12 7v4"/>
  <line x1="8" y1="16" x2="8" y2="16"/>
  <line x1="16" y1="16" x2="16" y2="16"/>
</svg>
        </div>
        <h3 class="text-[16px] font-bold text-[#101828] mb-2 tracking-tight">Tecnología</h3>
        <p class="text-[13px] text-gray-500 leading-relaxed mb-4">AKDI IA, PWA móvil, QR, inventario, tienda en línea y multi-academia.</p>
        <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-[#155D88]">
          6 funcionalidades
          <svg class="w-3.5 h-3.5 arrow-icon transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 9l-7 7-7-7"/></svg>
