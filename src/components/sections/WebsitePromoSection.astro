---
const SITIO_URL = "/sitio/allonge";
---

<section class="py-20 bg-gradient-to-br from-[#1a1a2e] via-[#16213e] to-[#0f1624]">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-14">
      <h2 class="text-3xl lg:text-4xl font-extrabold text-white tracking-tight leading-tight mb-4">
        Tu Academia también merece su propia
        <span class="block bg-gradient-to-r from-[#399ABE] to-[#B9E0FB] bg-clip-text text-transparent mt-1">
          Página Web
        </span>
      </h2>
      <p class="text-[16px] text-[#8a9ab0] max-w-xl mx-auto leading-relaxed">
        Incluido en el plan Business o disponible como add-on en cualquier plan.
      </p>
    </div>

    <!-- 3 columnas -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-12">

      <!-- Sitio Web Profesional -->
      <div class="bg-white/[0.06] border border-white/[0.1] rounded-2xl p-7 hover:bg-white/[0.09] hover:border-[#399ABE]/40 hover:-translate-y-1 transition-all duration-200">
        <div class="w-14 h-14 bg-[#399ABE]/20 border border-[#399ABE]/30 rounded-xl flex items-center justify-center mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#399ABE" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M2 12h20"/>
            <path d="M12 2a14.5 14.5 0 0 1 4 10 14.5 14.5 0 0 1-4 10 14.5 14.5 0 0 1-4-10 14.5 14.5 0 0 1 4-10z"/>
          </svg>
        </div>
        <h3 class="text-[17px] font-bold text-white tracking-tight mb-2">Sitio Web Profesional</h3>
        <p class="text-[13px] text-[#8a9ab0] leading-relaxed">Tu academia con presencia online profesional. Dominio personalizado, diseño moderno y optimizado para móviles.</p>
      </div>

      <!-- Personalización Total -->
      <div class="bg-white/[0.06] border border-white/[0.1] rounded-2xl p-7 hover:bg-white/[0.09] hover:border-[#399ABE]/40 hover:-translate-y-1 transition-all duration-200">
        <div class="w-14 h-14 bg-[#399ABE]/20 border border-[#399ABE]/30 rounded-xl flex items-center justify-center mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#399ABE" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="13.5" cy="6.5" r="1.5"/>
            <circle cx="17.5" cy="10.5" r="1.5"/>
            <circle cx="8.5" cy="7.5" r="1.5"/>
            <circle cx="6.5" cy="12.5" r="1.5"/>
            <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>
          </svg>
        </div>
        <h3 class="text-[17px] font-bold text-white tracking-tight mb-2">Personalización Total</h3>
        <p class="text-[13px] text-[#8a9ab0] leading-relaxed">Tus colores, tu logo, tus fotos. El sitio refleja la identidad de tu academia automáticamente.</p>
      </div>

      <!-- Captación de Alumnos 24/7 -->
      <div class="bg-white/[0.06] border border-white/[0.1] rounded-2xl p-7 hover:bg-white/[0.09] hover:border-[#399ABE]/40 hover:-translate-y-1 transition-all duration-200">
        <div class="w-14 h-14 bg-[#399ABE]/20 border border-[#399ABE]/30 rounded-xl flex items-center justify-center mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#399ABE" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
        </div>
        <h3 class="text-[17px] font-bold text-white tracking-tight mb-2">Captación de Alumnos 24/7</h3>
        <p class="text-[13px] text-[#8a9ab0] leading-relaxed">Formulario de contacto integrado. Los interesados te encuentran y se registran aunque estés dando clases.</p>
      </div>

    </div>

    <!-- CTA -->
    <div class="text-center">
      <a
        href={SITIO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 bg-[#399ABE] hover:bg-[#2d85a8] text-white font-bold text-[15px] px-8 py-3.5 rounded-xl shadow-lg shadow-[#399ABE]/25 transition-all duration-200 hover:-translate-y-0.5"
      >
        Ver ejemplo de Sitio Web
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>

  </div>
</section>
