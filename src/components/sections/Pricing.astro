    if (by) { by.classList.remove('bg-[#155D88]','text-white','border-[#155D88]'); by.classList.add('bg-white','text-gray-500','border-gray-200'); }
  }
  function setPricingYearly() {
    document.querySelectorAll('.pricing-yearly').forEach(function(el) { el.classList.remove('hidden'); });
    document.querySelectorAll('.pricing-monthly').forEach(function(el) { el.classList.add('hidden'); });
    var bm = document.getElementById('btn-monthly');
    var by = document.getElementById('btn-yearly');
    if (by) { by.classList.add('bg-[#155D88]','text-white','border-[#155D88]'); by.classList.remove('bg-white','text-gray-500','border-gray-200'); }
    if (bm) { bm.classList.remove('bg-[#155D88]','text-white','border-[#155D88]'); bm.classList.add('bg-white','text-gray-500','border-gray-200'); }
  }
  document.addEventListener('astro:page-load', function() {
