<style>
  /* AI Section background */
  #ai-section-landing {
    position: relative;
  }

  .ai-bg-base {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0f1624 0%, #1a1a2e 100%);
    z-index: 0;
  }

  .ai-bg-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 55% at 50% 45%, rgba(57, 154, 190, 0.09) 0%, transparent 70%);
    z-index: 1;
  }

  /* AI section header text */
  .ai-badge-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #399ABE;
  }

  .ai-section-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  .ai-section-subtitle {
    font-size: 1.1rem;
    color: #8899aa;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Grid layouts */
  .ai-row-1 {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .ai-row-2 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  /* Base card */
  .ai-card {
    position: relative;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(57, 154, 190, 0.2);
    border-radius: 16px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  @keyframes ai-border-pulse {
    0%, 100% { border-color: rgba(57, 154, 190, 0.4); }
    50% { border-color: rgba(57, 154, 190, 0.7); }
  }

  .ai-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.35), 0 0 32px rgba(57, 154, 190, 0.08);
    animation: ai-border-pulse 1.8s ease-in-out infinite;
  }

  .ai-icon-wrap svg {
    transition: transform 0.3s ease;
  }

  .ai-card:hover .ai-icon-wrap svg {
    transform: scale(1.1);
  }

  /* Per-card accent borders */
  .ai-card-akdi {
    border-left: 3px solid #399ABE;
    border-top-color: rgba(57, 154, 190, 0.45);
    box-shadow: 0 0 40px rgba(57, 154, 190, 0.1);
  }

  .ai-card-escaneo { border-left: 3px solid #22c55e; }
  .ai-card-salud { border-left: 3px solid #f59e0b; }
  .ai-card-evaluaciones { border-left: 3px solid #8b5cf6; }
  .ai-card-centinela { border-left: 3px solid #6366f1; opacity: 0.85; }

  /* Watermark */
  .ai-watermark {
    position: absolute;
    top: 20px;
    right: 24px;
    font-size: 3rem;
    font-weight: 800;
