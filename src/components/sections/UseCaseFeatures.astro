---
import type { UseCaseFeaturesSection as UseCaseFeaturesSectionProps } from "@/types/Page";

type Props = UseCaseFeaturesSectionProps;

const {
  benefitsTitle,
  benefitsSubtitle,
  benefitsBadge,
  benefits,
  featuresTitle,
  featuresSubtitle,
  featuresDescription,
  featuresBadge,
  mainFeatures,
  showCTA = false,
  ctaText,
} = Astro.props;

const WA_LINK = "https://wa.me/50765726078?text=Hola%2C%20tengo%20una%20pregunta%20sobre%20AKDEMIApp%20para%20mi%20academia";

function cleanEmoji(str: string): string {
  return str.replace(/[\u200B-\u200D\uFEFF\uFE0F\u20E3]/g, '').trim();
}

const ICONS: Record<string, string> = {
  '⏱️': `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2"/><path d="M9 3h6"/><path d="M12 3v2"/></svg>`,
  '⏱': `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2"/><path d="M9 3h6"/><path d="M12 3v2"/></svg>`,
  '💹': `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>`,
