  '🧑‍🧑‍🧒‍🧒': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  '🖥️': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
  '🖥': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
  '🗒️': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
  '🗒': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
  '🌟': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
  '🩰': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>`,
  '🎶': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>`,
  '🎵': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>`,
  '🎻': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>`,
  '🥋': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L4 6v6c0 5 4 9 8 10 4-1 8-5 8-10V6l-8-4z"/><path d="M9 12l2 2 4-4"/></svg>`,
  '⚽': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>`,
  '🏀': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M4.93 4.93l14.14 14.14"/><path d="M2 12h20"/><path d="M12 2v20"/></svg>`,
  '⚾': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M4.93 4.93c4.08 4.08 10.07 4.08 14.14 0"/><path d="M4.93 19.07c4.08-4.08 10.07-4.08 14.14 0"/></svg>`,
  '🏈': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2c6 0 10 4 10 10S18 22 12 22 2 18 2 12 6 2 12 2z"/><path d="M2 12h20"/><path d="M12 2v20"/><path d="M8 8l8 8"/><path d="M16 8l-8 8"/></svg>`,
  '🎨': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r="1.5"/><circle cx="17.5" cy="10.5" r="1.5"/><circle cx="8.5" cy="7.5" r="1.5"/><circle cx="6.5" cy="12.5" r="1.5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>`,
  '🎭': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10 11h.01M14 11h.01"/><path d="M7 13c0 2 2 3 5 3s5-1 5-3"/><path d="M3 7c0-1.5 2-2 4-2 1 0 2 .5 3 1 1-.5 2-1 3-1 2 0 4 .5 4 2v10c0 1.5-2 2-4 2-1 0-2-.5-3-1-1 .5-2 1-3 1-2 0-4-.5-4-2V7z"/></svg>`,
  '🌐': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a14.5 14.5 0 0 1 4 10 14.5 14.5 0 0 1-4 10 14.5 14.5 0 0 1-4-10 14.5 14.5 0 0 1 4-10z"/></svg>`,
  '🧘': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="4" r="2"/><path d="M12 6c0 0-4 3-4 7"/><path d="M12 6c0 0 4 3 4 7"/><path d="M8 13c-2 1-3 3-2 5"/><path d="M16 13c2 1 3 3 2 5"/><path d="M10 22h4"/><path d="M12 13v9"/></svg>`,
  '📝': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>`,
};

function getIconSVG(emoji: string): string | null {
  if (!emoji) return null;
  const cleaned = cleanEmoji(emoji);
  return ICONS[cleaned] || ICONS[emoji] || null;
}
---

<!-- BENEFITS -->
{benefits && benefits.length > 0 && (
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">

      {(benefitsBadge || benefitsTitle) && (
        <div class="text-center mb-12">
          {benefitsBadge && (
            <span class="inline-block bg-[#EFF8FF] border border-[#B9E0FB] text-[#155D88] text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-5">
              {benefitsBadge}
            </span>
          )}
          {benefitsTitle && (
            <h2 class="text-3xl lg:text-4xl font-extrabold text-[#101828] tracking-tight leading-tight">
              {benefitsTitle}
              {benefitsSubtitle && (
                <span class="block bg-gradient-to-r from-[#155D88] to-[#399ABE] bg-clip-text text-transparent mt-1">
                  {benefitsSubtitle}
                </span>
              )}
            </h2>
          )}
        </div>
      )}

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {benefits.map((benefit) => {
          const iconSVG = getIconSVG(benefit.icon);
          return (
            <div class="bg-[#f8faff] border border-[#e5eaf0] rounded-2xl p-6 text-center hover:border-[#155D88] hover:shadow-lg hover:-translate-y-1 transition-all duration-200">
              <div class="w-14 h-14 bg-[#EFF8FF] rounded-xl flex items-center justify-center mx-auto mb-4">
                {iconSVG
                  ? <Fragment set:html={iconSVG} />
                  : <span class="text-3xl">{benefit.icon}</span>
                }
              </div>
              <h3 class="text-[16px] font-bold text-[#101828] mb-2 tracking-tight">{benefit.title}</h3>
              <p class="text-[13px] text-gray-500 leading-relaxed">{benefit.description}</p>
            </div>
          );
        })}
      </div>

    </div>
  </section>
)}

<!-- MAIN FEATURES -->
{mainFeatures && mainFeatures.length > 0 && (
  <section id="features" class="py-16 bg-[#f8faff]">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">

      {(featuresBadge || featuresTitle) && (
        <div class="mb-12">
          {featuresBadge && (
            <span class="inline-block bg-[#EFF8FF] border border-[#B9E0FB] text-[#155D88] text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-5">
              {featuresBadge}
            </span>
          )}
          {featuresTitle && (
            <h2 class="text-3xl lg:text-4xl font-extrabold text-[#101828] tracking-tight leading-tight mb-3">
              {featuresTitle}
              {featuresSubtitle && (
                <span class="block bg-gradient-to-r from-[#155D88] to-[#399ABE] bg-clip-text text-transparent mt-1">
                  {featuresSubtitle}
                </span>
              )}
            </h2>
          )}
          {featuresDescription && (
            <p class="text-[16px] text-gray-500 leading-relaxed max-w-2xl">
              {featuresDescription}
            </p>
          )}
        </div>
      )}

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {mainFeatures.map((feature) => {
          const iconSVG = getIconSVG(feature.icon);
          return (
            <div class="bg-white border border-[#e5eaf0] rounded-2xl p-6 hover:border-[#155D88] hover:shadow-lg hover:-translate-y-1 transition-all duration-200 relative group">
              <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-[#155D88] to-[#399ABE] rounded-t-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-[#EFF8FF] rounded-xl flex items-center justify-center shrink-0">
                  {iconSVG
                    ? <Fragment set:html={iconSVG} />
                    : <span class="text-2xl">{feature.icon}</span>
                  }
                </div>
                <div>
                  <h3 class="text-[15px] font-bold text-[#101828] mb-1.5 tracking-tight">{feature.title}</h3>
                  <p class="text-[13px] text-gray-500 leading-relaxed">{feature.description}</p>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      {showCTA && (
        <div class="mt-12 bg-[#EFF8FF] border border-[#B9E0FB] rounded-2xl p-6 flex flex-col sm:flex-row items-center justify-between gap-5">
          <p class="text-[15px] font-semibold text-[#101828]">
            {ctaText || "¿Necesitas alguna funcionalidad específica para tu academia?"}
          </p>
          <a href={WA_LINK} target="_blank" rel="noopener noreferrer"
             class="flex items-center gap-2 bg-[#155D88] hover:bg-[#124e75] text-white px-5 py-2.5 rounded-xl text-[13px] font-bold whitespace-nowrap transition-colors shrink-0">
            <svg class="w-4 h-4 fill-white" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Escribir por WhatsApp
          </a>
        </div>
      )}

    </div>
  </section>
)}
