---
import { fade } from "astro:transitions";
import type { HeroSection as HeroSectionProps } from "@/types/Page";

type Props = HeroSectionProps;

const {
  title,
  subtitle,
  description,
  ctaText,
  ctaLink,
  secondaryCtaText,
  secondaryCtaLink,
  badge,
  showStats = true,
  totalAcademies = 70,
  activeUsers = 250,
  satisfactionRate = 98,
} = Astro.props;

const WA_LINK = "https://wa.me/50765726078?text=Hola%2C%20vi%20AKDEMIApp%20y%20me%20interesa%20una%20demostraci%C3%B3n%20para%20mi%20academia";
---

<section
  id="hero"
  class="relative overflow-hidden bg-gradient-to-b from-[#EFF8FF] via-[#f5faff] to-white pt-16"
>
  <!-- Decorative blobs -->
  <div class="absolute top-0 left-0 w-[500px] h-[500px] bg-[#B9E0FB] rounded-full filter blur-[100px] opacity-20 -translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
  <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-[#399ABE] rounded-full filter blur-[100px] opacity-10 translate-x-1/3 -translate-y-1/3 pointer-events-none"></div>

  <!-- Hero content — centrado -->
  <div
    class="relative z-10 max-w-4xl mx-auto px-6 pt-16 pb-12 text-center"
    transition:animate={fade({ duration: "0.6s" })}
  >
    <!-- Badge -->
    {badge && (
      <div class="inline-flex items-center gap-1.5 bg-[#EFF8FF] border border-[#B9E0FB] text-[#155D88] text-xs font-semibold px-3.5 py-1.5 rounded-full mb-7">
        <span class="w-1.5 h-1.5 rounded-full bg-[#399ABE] animate-pulse"></span>
        {badge}
      </div>
    )}

    <!-- Título -->
    <h1 class="text-4xl sm:text-5xl lg:text-[3.6rem] font-extrabold text-[#101828] leading-[1.08] tracking-[-0.03em] mb-5">
      {title}
      {subtitle && (
        <span class="block bg-gradient-to-r from-[#155D88] to-[#399ABE] bg-clip-text text-transparent">
          {subtitle}
        </span>
      )}
    </h1>

    <!-- Descripción -->
    {description && (
      <p class="text-lg sm:text-xl text-gray-500 leading-relaxed max-w-2xl mx-auto mb-9">
        {description}
      </p>
    )}

    <!-- Botones -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-14">
      <a
        href={WA_LINK}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2.5 bg-[#155D88] hover:bg-[#124e75] text-white font-semibold text-[15px] px-7 py-3.5 rounded-xl shadow-lg shadow-[#155D88]/25 transition-all duration-200 hover:-translate-y-0.5 w-full sm:w-auto justify-center"
      >
        <svg class="w-5 h-5 fill-white shrink-0" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Agenda una demostración
      </a>

      {secondaryCtaText && secondaryCtaLink && (
        <a
          href={secondaryCtaLink}
          class="flex items-center gap-2 bg-white hover:bg-gray-50 text-gray-700 font-medium text-[15px] px-6 py-3.5 rounded-xl border border-gray-200 transition-all duration-200 w-full sm:w-auto justify-center"
        >
          <svg class="w-4 h-4 fill-gray-500" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
          {secondaryCtaText}
        </a>
      )}
    </div>

    <!-- Video — ancho completo, pegado hacia abajo estilo Notion -->
    <div class="relative mx-auto max-w-5xl -mb-1">
      <div class="rounded-t-2xl overflow-hidden shadow-2xl shadow-[#155D88]/15 border border-[#155D88]/10 border-b-0">
        <video
          autoplay
          muted
          loop
          playsinline
          class="w-full block"
          poster="/hero-video-poster.jpg"
        >
          <source src="/hero-video.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </div>

  <!-- Stats bar — debajo del video -->
  {showStats && (
    <div class="relative z-10 border-t border-gray-100 bg-white">
      <div class="max-w-4xl mx-auto grid grid-cols-3 divide-x divide-gray-100">
        <div class="py-6 text-center">
          <p class="text-3xl font-extrabold text-[#155D88] tracking-tight">{totalAcademies}+</p>
          <p class="text-sm text-gray-500 mt-1">Academias activas</p>
        </div>
        <div class="py-6 text-center">
          <p class="text-3xl font-extrabold text-[#155D88] tracking-tight">{activeUsers}+</p>
          <p class="text-sm text-gray-500 mt-1">Usuarios Activos</p>
        </div>
        <div class="py-6 text-center">
          <p class="text-3xl font-extrabold text-[#155D88] tracking-tight">{satisfactionRate}%</p>
          <p class="text-sm text-gray-500 mt-1">Satisfacción</p>
        </div>
      </div>
    </div>
  )}
</section>
