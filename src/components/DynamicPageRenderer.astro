---
/**
 * Dynamic Page Renderer Component
 *
 * Renders a dynamic array of sections by mapping each section to its
 * corresponding Astro component using the component registry.
 *
 * This component is the core of the Page Builder system, enabling
 * content editors to create pages in Strapi CMS that are automatically
 * rendered on the frontend without code changes.
 *
 * Features:
 * - Component registry lookup for dynamic rendering
 * - Error handling for unknown components
 * - Props pass-through to child components
 * - Developer-friendly error messages
 *
 * @example
 * ```astro
 * <DynamicPageRenderer sections={page.sections} />
 * ```
 */

import type { Section } from '@/types';
import { getComponentForSection } from '@/lib/componentRegistry';
import WebsitePromoSection from '@/components/sections/WebsitePromoSection.astro';
import AISection from '@/components/sections/AISection.astro';
import ROICalculator from '@/components/sections/ROICalculator.astro';

interface Props {
  sections: Section[];
  slug?: string;
  isAcademyPage?: boolean;
}

const { sections, slug = '', isAcademyPage = false } = Astro.props;

console.log('[DynamicPageRenderer] Received sections:', sections?.length || 0);
console.log('[DynamicPageRenderer] Sections types:', sections?.map(s => s.__component).join(', '));

// Log ALL sections details for debugging
if (sections && sections.length > 0) {
  sections.forEach((section, index) => {
    console.log(`[DynamicPageRenderer] Section ${index + 1} (${section.__component}):`, JSON.stringify(section, null, 2));
  });
}

// Validate sections array
if (!sections || !Array.isArray(sections)) {
  console.error('DynamicPageRenderer: sections prop is required and must be an array');
}

// Per-slug hero title/subtitle overrides for academy pages
const academyHeroOverrides: Record<string, { title: string; subtitle: string }> = {
  'academia-danzas': {
    title: 'Tu academia de danza, organizada y profesional',
    subtitle: 'Gestiona bailarines, horarios por disciplina, recitales, cobros y comunicación con padres desde un solo lugar.',
  },
  'academia-musica': {
    title: 'Tu escuela de música, afinada y organizada',
    subtitle: 'Gestiona alumnos, instrumentos, horarios, cobros y audiciones desde un solo lugar.',
  },
  'academia-artes-marciales': {
    title: 'Tu dojo, tu academia, tu control total',
    subtitle: 'Gestiona alumnos, cinturones, exámenes de grado, cobros y comunicación con padres desde un solo lugar.',
  },
  'academia-futbol': {
    title: 'Tu escuela de fútbol, bajo control total',
    subtitle: 'Gestiona jugadores, categorías, horarios por cancha, cobros y comunicación con padres desde un solo lugar.',
  },
  'academia-baloncesto': {
    title: 'Tu academia de basketball, organizada al máximo',
    subtitle: 'Gestiona jugadores, categorías, horarios, cobros y comunicación con padres desde un solo lugar.',
  },
  'academia-beisbol': {
    title: 'Tu academia de béisbol, profesional desde el día uno',
    subtitle: 'Gestiona jugadores, categorías, horarios, cobros y comunicación con padres desde un solo lugar.',
  },
  'academia-yoga': {
    title: 'Tu estudio de yoga, en armonía total',
    subtitle: 'Gestiona alumnos, horarios, cobros y comunicación desde un solo lugar. Yoga, pilates y bienestar.',
  },
  'academia-arte': {
    title: 'Tu taller de arte, organizado para crear',
    subtitle: 'Gestiona alumnos, talleres, horarios, cobros y exposiciones desde un solo lugar.',
  },
};

// Filter out any null/undefined sections
const validSections = sections?.filter((section) => section != null) || [];
console.log('[DynamicPageRenderer] Valid sections:', validSections.length);
---

{validSections.length === 0 ? (
  <!-- Empty state: No sections to render -->
  <div class="container mx-auto px-4 py-16 text-center">
    <div class="max-w-md mx-auto">
      <div class="text-6xl mb-4">📄</div>
      <h2 class="text-2xl font-bold text-gray-900 mb-2">
        No Content Available
      </h2>
      <p class="text-gray-600">
        This page doesn't have any content sections yet.
      </p>
    </div>
  </div>
) : (
  validSections.map((section, index) => {
    // Get the Astro component for this section type
    const Component = getComponentForSection(section);

    // Handle unknown component types
    if (!Component) {
      console.error(
        `DynamicPageRenderer: Unknown component type "${section.__component}" at index ${index}`
      );

      return (
        <div
          class="bg-red-50 border border-red-200 text-red-800 px-6 py-4 rounded-lg m-4"
          role="alert"
        >
          <div class="flex items-start gap-3">
            <svg
              class="w-6 h-6 text-red-600 flex-shrink-0 mt-0.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            <div class="flex-1">
              <p class="font-semibold text-base mb-1">
                Component Not Found
              </p>
              <p class="text-sm">
                Component type <code class="bg-red-100 px-1.5 py-0.5 rounded font-mono text-xs">{section.__component}</code> is not registered in the component registry.
              </p>
              <details class="mt-2">
                <summary class="text-sm font-medium cursor-pointer hover:underline">
                  View Details
                </summary>
                <pre class="mt-2 text-xs bg-red-100 p-2 rounded overflow-x-auto">
{JSON.stringify(section, null, 2)}
                </pre>
              </details>
            </div>
          </div>
        </div>
      );
    }

    // Inject website promo section before pricing
    const isPricing = section.__component === 'sections.pricing-section';
    const isFeaturesSection = section.__component === 'sections.features-section' || section.__component === 'sections.use-case-features-section';
    const isHeroSection = section.__component === 'sections.hero-section' || section.__component === 'sections.use-case-hero-section';
    const isTestimonialsSection = section.__component === 'sections.testimonials-section';
    // Merge slug-based hero overrides when applicable
    const heroOverride = section.__component === 'sections.use-case-hero-section' && slug && academyHeroOverrides[slug]
      ? academyHeroOverrides[slug]
      : {};
    const resolvedSection = { ...section, ...heroOverride };

    // Render the component with all section props
    // The spread operator passes all section properties as props
    return (
      <>
        {isPricing && !isAcademyPage && <ROICalculator />}
        {isPricing && <WebsitePromoSection slug={slug} />}
        <Component {...resolvedSection} key={`section-${section.id || index}`} />
        {isHeroSection && isAcademyPage && (
          <section style="background:#fff; padding:5rem 0;">
            <div style="max-width:1200px; margin:0 auto; padding:0 1.5rem;">
              <div class="crm-grid" style="display:grid; grid-template-columns:1fr; gap:3rem; align-items:center;">
                <div style="order:1;">
                  <span style="display:inline-block; background:#EFF8FF; border:1px solid #B9E0FB; color:#399ABE; font-size:0.78rem; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; padding:0.35rem 1rem; border-radius:999px; margin-bottom:1.25rem;">
                    Captación de Alumnos (CRM)
                  </span>
                  <h2 style="font-size:clamp(1.75rem,3.5vw,2.4rem); font-weight:800; color:#1a1a2e; line-height:1.1; margin:0 0 1rem; tracking-tight;">
                    Nuevos alumnos llegan solos a tu academia
                  </h2>
                  <p style="font-size:1.05rem; color:#475569; line-height:1.75; margin:0 0 2rem; max-width:520px;">
                    Formularios de inscripción online, seguimiento de prospectos y recordatorios automáticos. Convierte interesados en alumnos sin trabajo manual.
                  </p>
                  <ul style="list-style:none; padding:0; margin:0 0 2.5rem; display:flex; flex-direction:column; gap:0.85rem;">
                    <li style="display:flex; align-items:flex-start; gap:0.75rem;">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" style="flex-shrink:0; margin-top:2px;"><circle cx="10" cy="10" r="10" fill="#EFF8FF"/><path d="M6 10.5l2.8 2.8 5.2-5.6" stroke="#399ABE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      <span style="font-size:0.97rem; color:#1a1a2e; font-weight:500;">Formulario de inscripción integrado en tu sitio web</span>
                    </li>
                    <li style="display:flex; align-items:flex-start; gap:0.75rem;">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" style="flex-shrink:0; margin-top:2px;"><circle cx="10" cy="10" r="10" fill="#EFF8FF"/><path d="M6 10.5l2.8 2.8 5.2-5.6" stroke="#399ABE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      <span style="font-size:0.97rem; color:#1a1a2e; font-weight:500;">Seguimiento automático de prospectos con recordatorios</span>
                    </li>
                    <li style="display:flex; align-items:flex-start; gap:0.75rem;">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" style="flex-shrink:0; margin-top:2px;"><circle cx="10" cy="10" r="10" fill="#EFF8FF"/><path d="M6 10.5l2.8 2.8 5.2-5.6" stroke="#399ABE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      <span style="font-size:0.97rem; color:#1a1a2e; font-weight:500;">Convierte leads en alumnos inscritos con 1 clic</span>
                    </li>
                  </ul>
                  <a href="https://app.akdemiapp.online/registro/academia"
                     style="display:inline-flex; align-items:center; justify-content:center; background:#399ABE; color:#fff; font-weight:700; font-size:0.97rem; padding:0.85rem 2rem; border-radius:0.75rem; text-decoration:none; box-shadow:0 4px 20px rgba(57,154,190,0.3);">
                    Ver el CRM en acción →
                  </a>
                </div>
                <div style="order:2;">
                  <img src="/images/crm-preview.png" alt="CRM Captación de Alumnos - Pipeline visual de prospectos" style="width:100%; border-radius:12px; box-shadow: 0 8px 30px rgba(0,0,0,0.12);" />
                </div>
              </div>
            </div>
          </section>
        )}
        {isTestimonialsSection && isAcademyPage && (
          <section style="background:linear-gradient(135deg,#1a1a2e 0%,#16213e 100%); padding:4rem 0; text-align:center;">
            <div style="max-width:800px; margin:0 auto; padding:0 1.5rem;">
              <h2 style="font-size:clamp(1.5rem,3vw,2rem); font-weight:800; color:#fff; margin:0 0 0.75rem;">Únete a más de 70 academias en LATAM</h2>
              <p style="font-size:1rem; color:rgba(255,255,255,0.7); margin:0 0 2rem;">Plan Business completo sin compromiso</p>
              <a href="https://app.akdemiapp.online/registro/academia?plan=business" style="display:inline-flex; align-items:center; justify-content:center; background:#fff; color:#1a1a2e; font-weight:700; font-size:1rem; padding:0.85rem 2rem; border-radius:0.75rem; text-decoration:none; box-shadow:0 4px 20px rgba(0,0,0,0.2); transition:all 0.2s;">
                Prueba 14 días gratis
              </a>
            </div>
          </section>
        )}
        {isFeaturesSection && (
          <>
            <section style="background:#e8f4f8; padding:4rem 0; text-align:center;">
              <div style="max-width:800px; margin:0 auto; padding:0 1.5rem;">
                <h2 style="font-size:clamp(1.5rem,3vw,2rem); font-weight:800; color:#1a1a2e; margin:0 0 0.75rem;">¿Listo para transformar tu academia?</h2>
                <p style="font-size:1rem; color:#475569; margin:0 0 2rem;">Más de 35 herramientas incluidas en todos los planes</p>
                <a href="https://app.akdemiapp.online/registro/academia" style="display:inline-flex; align-items:center; justify-content:center; background:#399ABE; color:#fff; font-weight:700; font-size:1rem; padding:0.85rem 2rem; border-radius:0.75rem; text-decoration:none; box-shadow:0 4px 20px rgba(57,154,190,0.3); transition:all 0.2s;">
                  Empieza gratis
                </a>
              </div>
            </section>
            <AISection />
            {/* Trust / security strip */}
            <div style="background:#fff; border-top:1px solid #f1f5f9; padding:28px 24px;">
              <div style="max-width:900px; margin:0 auto; text-align:center;">
                <p style="font-size:0.68rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#94a3b8; margin:0 0 16px;">Seguridad y Confianza</p>
                <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:2rem;">
                  <!-- Shield / SSL -->
                  <div style="display:flex; align-items:center; gap:0.5rem;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#399ABE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                    <span style="font-size:0.85rem; color:#475569;">Cifrado SSL 256-bit</span>
                  </div>
                  <!-- Database / Backups -->
                  <div style="display:flex; align-items:center; gap:0.5rem;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#399ABE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <ellipse cx="12" cy="5" rx="9" ry="3"/>
                      <path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/>
                      <path d="M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3"/>
                    </svg>
                    <span style="font-size:0.85rem; color:#475569;">Backups automáticos diarios</span>
                  </div>
                  <!-- Server / AWS -->
                  <div style="display:flex; align-items:center; gap:0.5rem;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#399ABE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="2" width="20" height="8" rx="2" ry="2"/>
                      <rect x="2" y="14" width="20" height="8" rx="2" ry="2"/>
                      <line x1="6" y1="6" x2="6.01" y2="6"/>
                      <line x1="6" y1="18" x2="6.01" y2="18"/>
                    </svg>
                    <span style="font-size:0.85rem; color:#475569;">Infraestructura en AWS</span>
                  </div>
                  <!-- FileCheck / Audited -->
                  <div style="display:flex; align-items:center; gap:0.5rem;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#399ABE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
                      <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
                      <path d="m9 15 2 2 4-4"/>
                    </svg>
                    <span style="font-size:0.85rem; color:#475569;">87 rutas auditadas</span>
                  </div>
                </div>
              </div>
            </div>
          </>
        )}
      </>
    );
  })
)}

<style>
  @media (min-width: 1024px) {
    .crm-grid { grid-template-columns: 3fr 2fr !important; }
  }

  /* Error state styling */
  details summary::-webkit-details-marker {
    display: none;
  }

  details summary::before {
    content: '▶';
    display: inline-block;
    margin-right: 0.5rem;
    transition: transform 0.2s;
  }

  details[open] summary::before {
    transform: rotate(90deg);
  }
</style>
