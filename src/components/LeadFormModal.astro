---
// LeadFormModal.astro — modal captación de leads AKDEMIApp
---

<div id="akdemi-modal-root">
  <div class="overlay" id="overlay" onclick="ovClick(event)">
    <div class="modal" id="modal">
      <div class="mhdr" id="mhdr">
        <div class="badge">
          <div class="bdot"></div>
          <span class="bname">AKDEMIApp</span>
        </div>
        <button class="cbtn" onclick="closeModal()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
        <h2 class="mtitle">Agenda una demo gratuita</h2>
        <p class="msub">Descubre cómo academias de toda Latinoamérica gestionan sus alumnos y cobros con AKDEMIApp.</p>
        <div class="pwrap">
          <div class="ptrack"><div class="pfill" id="pfill" style="width:33%"></div></div>
          <span class="ptxt" id="ptxt">Paso 1 de 3</span>
        </div>
        <div class="mdiv"></div>
      </div>
      <div class="mbody" id="mbody">

        <!-- Paso 1: Datos personales -->
        <div class="step active" id="step-1">
          <div class="fg">
            <label class="sh">Desde dónde nos escribes</label>
            <div class="cgrid" id="cgrid"></div>
            <div class="lw" id="lw">
              <div class="lsbox">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" class="fi" id="fsearch" placeholder="Buscar país..." autocomplete="off" oninput="filterL(this.value)" onfocus="showL()">
              </div>
              <div class="ldd" id="ldd"></div>
            </div>
          </div>
          <div class="fg">
            <label class="flbl">Nombre completo</label>
            <input type="text" id="fname" class="fi" placeholder="Ej. María García">
            <div class="ferr" id="err-name">Por favor ingresa tu nombre</div>
          </div>
          <div class="fg">
            <label class="flbl">Correo electrónico</label>
            <input type="email" id="femail" class="fi" placeholder="tu@academia.com">
            <div class="ferr" id="err-email">Por favor ingresa un email válido</div>
          </div>
          <div class="fg">
            <label class="flbl">WhatsApp</label>
            <div class="prow">
              <div class="ppre" id="ppre">
                <span id="flag-area"><svg width="22" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></span>
                <span id="dcode">+</span>
              </div>
              <input type="tel" id="fphone" class="fi" placeholder="Selecciona país primero">
            </div>
            <div class="ferr" id="err-phone">Selecciona tu país e ingresa tu número</div>
          </div>
          <div class="mnav">
            <button class="bnx" onclick="goS(2)"><span class="bl">Continuar</span><span class="spin"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></button>
          </div>
        </div>

        <!-- Paso 2: Tipo de academia -->
        <div class="step" id="step-2">
          <div class="fg">
            <label class="sh">Tipo de academia</label>
            <div class="pgrid" id="ac-pills"></div>
            <div id="oa-wrap" style="display:none;margin-top:10px;"><input type="text" class="fi" id="f-oa" placeholder="Describe tu tipo de academia..."></div>
            <div class="ferr" id="err-ac">Selecciona el tipo de academia</div>
          </div>
          <div class="fg" style="margin-top:4px;">
            <label class="sh">Número de alumnos activos</label>
            <div class="sgrid" id="sgrid"></div>
            <div class="ferr" id="err-size">Selecciona un rango</div>
          </div>
          <div class="mnav">
            <button class="bbk" onclick="goS(1)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Atrás</button>
            <button class="bnx" onclick="goS(3)"><span class="bl">Continuar</span><span class="spin"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></button>
          </div>
        </div>

        <!-- Paso 3: Fuente -->
        <div class="step" id="step-3">
          <div class="fg">
            <label class="sh">¿Cómo nos encontraste?</label>
            <div class="pgrid" id="src-pills"></div>
            <div class="ferr" id="err-src">Selecciona al menos una opción</div>
          </div>
          <div class="mnav">
            <button class="bbk" onclick="goS(2)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Atrás</button>
            <button class="bnx" id="sbtn" onclick="doSubmit()"><span class="bl" id="slbl2">Agendar demo</span><span class="spin"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.63 19.79 19.79 0 01.21 1.05 2 2 0 012.18 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.17a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.11v2.81z"/></svg></button>
          </div>
        </div>

        <!-- Éxito -->
        <div class="succ" id="succ">
          <div class="sico"><svg viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
          <h2 class="stitle">¡Gracias, <span id="sname"></span>!</h2>
          <p class="smsg">Tu solicitud llegó con éxito. Nuestro equipo revisará tus datos y te contactará muy pronto por WhatsApp.</p>
          <div class="scards">
            <div class="sc"><div class="sci"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div><div class="scl">Respuesta</div><div class="scv">~15 min</div></div>
            <div class="sc"><div class="sci"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div><div class="scl">Canal</div><div class="scv">WhatsApp</div></div>
            <div class="sc"><div class="sci"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#155D88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg></div><div class="scl">Demo</div><div class="scv">30 min</div></div>
          </div>
          <button class="bwa" onclick="openWA()"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>Escribir por WhatsApp ahora</button>
        </div>

      </div>
    </div>
  </div>
</div>

<style is:global>
/* ── Todo scoped a #akdemi-modal-root — nunca body/html/:root ── */
#akdemi-modal-root {
  font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
}
#akdemi-modal-root *, #akdemi-modal-root *::before, #akdemi-modal-root *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}
#akdemi-modal-root .overlay {
  position: fixed; inset: 0; z-index: 9999;
  background: rgba(15,23,42,.55); backdrop-filter: blur(8px);
  display: flex; align-items: center; justify-content: center; padding: 16px;
  opacity: 0; pointer-events: none; transition: opacity .3s ease;
}
#akdemi-modal-root .overlay.open { opacity: 1; pointer-events: all; }
#akdemi-modal-root .modal {
  width: 100%; max-width: 520px; background: #fff;
  border: 1px solid rgba(0,0,0,.08); border-radius: 24px;
  box-shadow: 0 40px 80px rgba(0,0,0,.15), 0 0 0 1px rgba(255,255,255,.8) inset;
  transform: scale(.95) translateY(16px);
  transition: transform .35s cubic-bezier(0.34,1.56,0.64,1), opacity .3s ease;
  opacity: 0; max-height: 92vh; display: flex; flex-direction: column; overflow: hidden;
}
#akdemi-modal-root .overlay.open .modal { transform: scale(1) translateY(0); opacity: 1; }
#akdemi-modal-root .mhdr { padding: 28px 28px 0; position: relative; flex-shrink: 0; }
#akdemi-modal-root .badge {
  display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px;
  border-radius: 50px; border: 1px solid rgba(21,93,136,.2);
  background: rgba(21,93,136,.07); margin-bottom: 20px;
}
#akdemi-modal-root .bdot {
  width: 8px; height: 8px; border-radius: 50%; background: #155D88;
  animation: am-pulse 2s ease-in-out infinite;
}
@keyframes am-pulse { 0%,100%{opacity:1} 50%{opacity:.5} }
#akdemi-modal-root .bname { font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #155D88; }
#akdemi-modal-root .mtitle { font-size: 26px; font-weight: 700; line-height: 1.2; margin-bottom: 8px; color: #0F172A; }
#akdemi-modal-root .msub { font-size: 13px; color: #334155; line-height: 1.5; margin-bottom: 22px; }
#akdemi-modal-root .pwrap { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
#akdemi-modal-root .ptrack { flex: 1; height: 3px; background: rgba(0,0,0,.08); border-radius: 99px; overflow: hidden; }
#akdemi-modal-root .pfill {
  height: 100%; border-radius: 99px;
  background: linear-gradient(90deg,#1d4ed8,#155D88);
  transition: width .4s cubic-bezier(0.4,0,0.2,1);
}
#akdemi-modal-root .ptxt { font-size: 11px; font-weight: 600; color: #64748B; white-space: nowrap; }
#akdemi-modal-root .mdiv { height: 1px; background: rgba(0,0,0,.08); margin: 18px 0 0; }
#akdemi-modal-root .cbtn {
  position: absolute; top: 28px; right: 28px; width: 32px; height: 32px;
  border-radius: 50%; border: 1px solid rgba(0,0,0,.10);
  background: rgba(0,0,0,.05); color: #475569; cursor: pointer;
  display: flex; align-items: center; justify-content: center; transition: all .15s ease;
}
#akdemi-modal-root .cbtn:hover { background: rgba(0,0,0,.10); color: #0F172A; }
#akdemi-modal-root .cbtn svg { width: 14px; height: 14px; }
#akdemi-modal-root .mbody { padding: 20px 28px 28px; overflow-y: auto; flex: 1; }
#akdemi-modal-root .mbody::-webkit-scrollbar { width: 4px; }
#akdemi-modal-root .mbody::-webkit-scrollbar-thumb { background: rgba(0,0,0,.12); border-radius: 99px; }
#akdemi-modal-root .step { display: none; }
#akdemi-modal-root .step.active { display: block; animation: am-si .3s cubic-bezier(0.4,0,0.2,1); }
@keyframes am-si { from{opacity:0;transform:translateX(12px)} to{opacity:1;transform:translateX(0)} }
#akdemi-modal-root .fg { margin-bottom: 16px; }
#akdemi-modal-root .flbl {
  display: block; font-size: 11px; font-weight: 700; letter-spacing: 1px;
  text-transform: uppercase; color: #475569; margin-bottom: 8px;
}
#akdemi-modal-root .fi {
  width: 100%; padding: 13px 16px; background: rgba(0,0,0,.04);
  border: 1px solid rgba(0,0,0,.10); border-radius: 12px; color: #0F172A;
  font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 14px; transition: all .15s ease; outline: none;
}
#akdemi-modal-root .fi:focus { border-color: #155D88; background: #fff; box-shadow: 0 0 0 3px rgba(21,93,136,.12); }
#akdemi-modal-root .fi::placeholder { color: #94A3B8; }
#akdemi-modal-root .fi.err { border-color: #F87171; }
#akdemi-modal-root .ferr { font-size: 11px; color: #F87171; margin-top: 6px; display: none; }
#akdemi-modal-root .prow { display: flex; gap: 10px; }
#akdemi-modal-root .ppre {
  display: flex; align-items: center; gap: 8px; padding: 13px 14px;
  background: rgba(0,0,0,.05); border: 1px solid rgba(0,0,0,.12);
  border-radius: 12px; font-size: 14px; color: #334155; white-space: nowrap; min-width: 96px;
}
#akdemi-modal-root .prow .fi { flex: 1; }
#akdemi-modal-root .cgrid { display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; }
#akdemi-modal-root .ccard {
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  padding: 12px 8px; background: rgba(0,0,0,.04); border: 1px solid rgba(0,0,0,.08);
  border-radius: 12px; cursor: pointer; transition: all .15s ease; text-align: center;
}
#akdemi-modal-root .ccard:hover { background: rgba(0,0,0,.07); border-color: rgba(0,0,0,.15); transform: translateY(-1px); }
#akdemi-modal-root .ccard.sel { border-color: #155D88; background: rgba(21,93,136,.08); box-shadow: 0 0 12px rgba(21,93,136,.2); }
#akdemi-modal-root .cname { font-size: 11px; font-weight: 600; color: #1E293B; line-height: 1.2; }
#akdemi-modal-root .cdial { font-size: 10px; color: #64748B; }
#akdemi-modal-root .lw { display: none; margin-top: 10px; position: relative; }
#akdemi-modal-root .lsbox { position: relative; }
#akdemi-modal-root .lsbox svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); pointer-events: none; }
#akdemi-modal-root .lsbox .fi { padding-left: 42px; }
#akdemi-modal-root .ldd {
  display: none; position: absolute; top: calc(100% + 6px); left: 0; right: 0; z-index: 999;
  background: #fff; border: 1px solid rgba(0,0,0,.12); border-radius: 12px;
  max-height: 220px; overflow-y: auto; box-shadow: 0 16px 40px rgba(0,0,0,.12);
}
#akdemi-modal-root .ldd::-webkit-scrollbar { width: 4px; }
#akdemi-modal-root .ldd::-webkit-scrollbar-thumb { background: rgba(0,0,0,.12); border-radius: 99px; }
#akdemi-modal-root .litem { display: flex; align-items: center; gap: 10px; padding: 10px 14px; cursor: pointer; transition: background .15s; font-size: 14px; }
#akdemi-modal-root .litem:hover { background: rgba(0,0,0,.04); }
#akdemi-modal-root .litem .ln { flex: 1; color: #0F172A; font-weight: 500; }
#akdemi-modal-root .litem .ld { color: #64748B; font-size: 12px; }
#akdemi-modal-root .pgrid { display: flex; flex-wrap: wrap; gap: 8px; }
#akdemi-modal-root .pill {
  display: flex; align-items: center; gap: 6px; padding: 8px 14px;
  background: rgba(0,0,0,.04); border: 1px solid rgba(0,0,0,.08);
  border-radius: 50px; cursor: pointer; font-size: 13px; font-weight: 500;
  color: #334155; transition: all .15s ease; user-select: none;
  font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
}
#akdemi-modal-root .pill:hover { background: rgba(0,0,0,.07); color: #0F172A; }
#akdemi-modal-root .pill.sel { border-color: #155D88; background: rgba(21,93,136,.08); color: #155D88; }
#akdemi-modal-root .chk {
  width: 16px; height: 16px; border-radius: 50%; border: 1.5px solid currentColor;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all .15s ease;
}
#akdemi-modal-root .pill.sel .chk { background: #155D88; border-color: #155D88; }
#akdemi-modal-root .chk svg { display: none; width: 10px; height: 10px; }
#akdemi-modal-root .pill.sel .chk svg { display: block; }
#akdemi-modal-root .sgrid { display: grid; grid-template-columns: repeat(2,1fr); gap: 8px; }
#akdemi-modal-root .scard {
  padding: 14px; background: rgba(0,0,0,.04); border: 1px solid rgba(0,0,0,.08);
  border-radius: 12px; cursor: pointer; transition: all .15s ease;
}
#akdemi-modal-root .scard:hover { background: rgba(0,0,0,.07); transform: translateY(-1px); }
#akdemi-modal-root .scard.sel { border-color: #155D88; background: rgba(21,93,136,.08); }
#akdemi-modal-root .snum { font-size: 22px; font-weight: 700; margin-bottom: 2px; color: #0F172A; }
#akdemi-modal-root .scard.sel .snum { color: #155D88; }
#akdemi-modal-root .slbl { font-size: 11px; color: #64748B; }
#akdemi-modal-root .sh {
  display: block; font-size: 11px; font-weight: 700; letter-spacing: 1.5px;
  text-transform: uppercase; color: #475569; margin-bottom: 12px;
}
#akdemi-modal-root .mnav { display: flex; gap: 10px; margin-top: 22px; }
#akdemi-modal-root .bbk {
  padding: 13px 20px; border-radius: 12px; border: 1px solid rgba(0,0,0,.12);
  background: transparent; color: #475569;
  font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 13px; font-weight: 600; cursor: pointer; transition: all .15s ease;
  display: flex; align-items: center; gap: 6px;
}
#akdemi-modal-root .bbk:hover { background: rgba(0,0,0,.05); color: #0F172A; }
#akdemi-modal-root .bnx {
  flex: 1; padding: 13px 20px; border-radius: 12px; border: none;
  background: linear-gradient(135deg,#1d4ed8,#155D88); color: #fff;
  font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 14px; font-weight: 700; cursor: pointer; transition: all .15s ease;
  display: flex; align-items: center; justify-content: center; gap: 8px;
  box-shadow: 0 4px 20px rgba(21,93,136,.25);
}
#akdemi-modal-root .bnx:hover { transform: translateY(-1px); box-shadow: 0 8px 30px rgba(21,93,136,.35); filter: brightness(1.05); }
#akdemi-modal-root .bnx svg { width: 16px; height: 16px; }
#akdemi-modal-root .spin {
  width: 16px; height: 16px; border: 2px solid rgba(255,255,255,.3);
  border-top-color: #fff; border-radius: 50%; animation: am-sp .7s linear infinite; display: none;
}
@keyframes am-sp { to{transform:rotate(360deg)} }
#akdemi-modal-root .bnx.ld .spin { display: block; }
#akdemi-modal-root .bnx.ld .bl { display: none; }
#akdemi-modal-root .bnx.ld svg { display: none; }
#akdemi-modal-root .succ { display: none; text-align: center; padding: 8px 0 16px; }
#akdemi-modal-root .succ.show { display: block; animation: am-si .4s cubic-bezier(0.4,0,0.2,1); }
#akdemi-modal-root .sico {
  width: 80px; height: 80px; border-radius: 50%;
  background: linear-gradient(135deg,rgba(21,93,136,.15),rgba(21,93,136,.05));
  border: 1px solid rgba(21,93,136,.25);
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 24px; box-shadow: 0 0 40px rgba(21,93,136,.12);
  animation: am-pop .5s cubic-bezier(0.34,1.56,0.64,1);
}
@keyframes am-pop { from{transform:scale(0);opacity:0} to{transform:scale(1);opacity:1} }
#akdemi-modal-root .sico svg { width: 36px; height: 36px; }
#akdemi-modal-root .stitle { font-size: 26px; font-weight: 700; margin-bottom: 10px; color: #0F172A; }
#akdemi-modal-root .smsg { font-size: 14px; color: #475569; line-height: 1.6; max-width: 380px; margin: 0 auto 28px; }
#akdemi-modal-root .scards { display: flex; gap: 10px; margin-bottom: 24px; }
#akdemi-modal-root .sc {
  flex: 1; padding: 14px; background: rgba(0,0,0,.04);
  border: 1px solid rgba(0,0,0,.08); border-radius: 12px; text-align: center;
}
#akdemi-modal-root .sci { display: flex; align-items: center; justify-content: center; height: 30px; margin-bottom: 8px; }
#akdemi-modal-root .scl { font-size: 10px; color: #64748B; font-weight: 600; letter-spacing: .5px; }
#akdemi-modal-root .scv { font-size: 13px; font-weight: 700; color: #0F172A; margin-top: 2px; }
#akdemi-modal-root .bwa {
  width: 100%; padding: 14px; border-radius: 12px; border: none;
  background: linear-gradient(135deg,#25D366,#128C7E); color: #fff;
  font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 14px; font-weight: 700; cursor: pointer;
  display: flex; align-items: center; justify-content: center; gap: 10px;
  box-shadow: 0 4px 20px rgba(37,211,102,.25); transition: all .15s ease;
}
#akdemi-modal-root .bwa:hover { transform: translateY(-1px); box-shadow: 0 8px 30px rgba(37,211,102,.35); }
#akdemi-modal-root .bwa svg { width: 20px; height: 20px; }
</style>

<script is:inline>
var curStep=1,selC=null,selAc=null,selSz=null,selSrc=[];

var MC=[
  {code:'PA',name:'Panamá',     dial:'+507',digits:8, ph:'6000-0000'},
  {code:'MX',name:'México',     dial:'+52', digits:10,ph:'55 1234 5678'},
  {code:'CO',name:'Colombia',   dial:'+57', digits:10,ph:'310 123 4567'},
  {code:'CR',name:'Costa Rica', dial:'+506',digits:8, ph:'8000-0000'},
  {code:'GT',name:'Guatemala',  dial:'+502',digits:8, ph:'5000-0000'},
  {code:'PE',name:'Perú',       dial:'+51', digits:9, ph:'987 654 321'},
  {code:'CL',name:'Chile',      dial:'+56', digits:9, ph:'9 1234 5678'},
  {code:'AR',name:'Argentina',  dial:'+54', digits:10,ph:'11 1234-5678'},
  {code:'OTHER',name:'Otro',    dial:'+',   digits:0, ph:'Número de teléfono'}
];

var LC=[
  {code:'SV',name:'El Salvador',       dial:'+503',digits:8, ph:'7000-0000'},
  {code:'HN',name:'Honduras',          dial:'+504',digits:8, ph:'9000-0000'},
  {code:'NI',name:'Nicaragua',         dial:'+505',digits:8, ph:'8000-0000'},
  {code:'BZ',name:'Belice',            dial:'+501',digits:7, ph:'600-0000'},
  {code:'VE',name:'Venezuela',         dial:'+58', digits:10,ph:'412 000 0000'},
  {code:'EC',name:'Ecuador',           dial:'+593',digits:9, ph:'99 000 0000'},
  {code:'BO',name:'Bolivia',           dial:'+591',digits:8, ph:'7000 0000'},
  {code:'PY',name:'Paraguay',          dial:'+595',digits:9, ph:'981 000 000'},
  {code:'UY',name:'Uruguay',           dial:'+598',digits:8, ph:'9000 0000'},
  {code:'BR',name:'Brasil',            dial:'+55', digits:11,ph:'11 9 0000-0000'},
  {code:'CU',name:'Cuba',              dial:'+53', digits:8, ph:'5000-0000'},
  {code:'DO',name:'Rep. Dominicana',   dial:'+1',  digits:10,ph:'809 000 0000'},
  {code:'PR',name:'Puerto Rico',       dial:'+1',  digits:10,ph:'787 000 0000'},
  {code:'HT',name:'Haití',             dial:'+509',digits:8, ph:'3000-0000'},
  {code:'JM',name:'Jamaica',           dial:'+1',  digits:10,ph:'876 000 0000'},
  {code:'TT',name:'Trinidad y Tobago', dial:'+1',  digits:10,ph:'868 000 0000'},
  {code:'GY',name:'Guyana',            dial:'+592',digits:7, ph:'600 0000'},
  {code:'SR',name:'Surinam',           dial:'+597',digits:7, ph:'700-0000'},
  {code:'US',name:'Estados Unidos',    dial:'+1',  digits:10,ph:'305 000 0000'},
  {code:'ES',name:'España',            dial:'+34', digits:9, ph:'600 000 000'}
];

var ACS=['Danza','Artes Marciales','Yoga','Pilates','Música','Teatro','Natación','Gimnasia','Crossfit','Idiomas','Deportes','Otra'];
var SZS=[{v:'1-30',l:'1 – 30'},{v:'31-80',l:'31 – 80'},{v:'81-200',l:'81 – 200'},{v:'200+',l:'200+'}];
var SRS=['Google','Instagram','WhatsApp','Referido','Facebook','Otro'];

function flagBadge(code,size){
  if(code==='OTHER'){
    return '<div style="width:'+size+'px;height:'+Math.round(size*.75)+'px;display:flex;align-items:center;justify-content:center;"><svg width="'+(size-4)+'" height="'+(size-4)+'" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></div>';
  }
  var s=size===36?'13px':'11px';
  return '<div style="width:'+size+'px;height:'+Math.round(size*.75)+'px;background:#CBD5E1;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:'+s+';font-weight:800;letter-spacing:0.5px;color:#1E293B;font-family:ui-sans-serif,system-ui,sans-serif;">'+code+'</div>';
}

function buildGrid(){
  var g=document.getElementById('cgrid');g.innerHTML='';
  MC.forEach(function(c){
    var d=document.createElement('div');d.className='ccard';d.setAttribute('data-c',c.code);
    d.innerHTML=flagBadge(c.code,36)+'<span class="cname">'+c.name+'</span><span class="cdial">'+c.dial+'</span>';
    d.onclick=function(){pickC(c);};
    g.appendChild(d);
  });
}

function pickC(c){
  selC=c;
  document.querySelectorAll('.ccard').forEach(function(el){el.classList.toggle('sel',el.getAttribute('data-c')===c.code);});
  document.getElementById('flag-area').innerHTML=flagBadge(c.code,28);
  document.getElementById('dcode').textContent=c.dial;
  var ph=document.getElementById('fphone');
  ph.placeholder=c.ph;ph.maxLength=c.digits>0?c.digits+5:20;
  var lw=document.getElementById('lw');
  lw.style.display=c.code==='OTHER'?'block':'none';
  if(c.code==='OTHER'){document.getElementById('fsearch').value='';renderL('');}
}

function renderL(q){
  var dd=document.getElementById('ldd');dd.innerHTML='';
  var fl=LC.filter(function(c){return !q||c.name.toLowerCase().indexOf(q.toLowerCase())>=0;});
  fl.forEach(function(c){
    var it=document.createElement('div');it.className='litem';
    it.innerHTML=flagBadge(c.code,28)+'<span class="ln">'+c.name+'</span><span class="ld">'+c.dial+'</span>';
    it.onclick=function(){
      selC=c;
      document.getElementById('fsearch').value=c.name;
      dd.style.display='none';
      document.getElementById('flag-area').innerHTML=flagBadge(c.code,28);
      document.getElementById('dcode').textContent=c.dial;
      var ph=document.getElementById('fphone');ph.placeholder=c.ph;ph.maxLength=c.digits+5;
    };
    dd.appendChild(it);
  });
  dd.style.display=fl.length>0?'block':'none';
}

function filterL(v){renderL(v);}
function showL(){renderL(document.getElementById('fsearch').value);}

document.addEventListener('click',function(e){
  var lw=document.getElementById('lw');
  if(lw&&!lw.contains(e.target)){var dd=document.getElementById('ldd');if(dd)dd.style.display='none';}
});

function mkPill(label,onTgl){
  var p=document.createElement('div');p.className='pill';
  p.innerHTML='<div class="chk"><svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>'+label;
  p.onclick=onTgl;return p;
}

function buildAc(){
  var g=document.getElementById('ac-pills');g.innerHTML='';
  ACS.forEach(function(t){
    var p=mkPill(t,function(){
      document.querySelectorAll('#ac-pills .pill').forEach(function(x){x.classList.remove('sel');});
      p.classList.add('sel');selAc=t;
      document.getElementById('oa-wrap').style.display=t==='Otra'?'block':'none';
    });g.appendChild(p);
  });
}

function buildSz(){
  var g=document.getElementById('sgrid');g.innerHTML='';
  SZS.forEach(function(s){
    var d=document.createElement('div');d.className='scard';
    d.innerHTML='<div class="snum">'+s.l+'</div><div class="slbl">Alumnos</div>';
    d.onclick=function(){
      document.querySelectorAll('.scard').forEach(function(x){x.classList.remove('sel');});
      d.classList.add('sel');selSz=s.v;
    };g.appendChild(d);
  });
}

function buildSrc(){
  var g=document.getElementById('src-pills');g.innerHTML='';
  SRS.forEach(function(s){
    var p=mkPill(s,function(){
      p.classList.toggle('sel');
      if(p.classList.contains('sel')){if(selSrc.indexOf(s)<0)selSrc.push(s);}
      else{selSrc=selSrc.filter(function(x){return x!==s;});}
    });g.appendChild(p);
  });
}

function clrErr(){
  document.querySelectorAll('.ferr').forEach(function(e){e.style.display='none';});
  document.querySelectorAll('.fi').forEach(function(i){i.classList.remove('err');});
}
function shErr(id){var e=document.getElementById(id);if(e)e.style.display='block';}

function goS(n){
  clrErr();
  if(n>curStep){
    if(curStep===1){
      if(!selC){shErr('err-phone');return;}
      if(!document.getElementById('fname').value.trim()){shErr('err-name');document.getElementById('fname').classList.add('err');return;}
      var em=document.getElementById('femail').value.trim();
      if(!em||em.indexOf('@')<0){shErr('err-email');document.getElementById('femail').classList.add('err');return;}
      if(!document.getElementById('fphone').value.trim()){shErr('err-phone');document.getElementById('fphone').classList.add('err');return;}
    }
    if(curStep===2){
      if(!selAc){shErr('err-ac');return;}
      if(!selSz){shErr('err-size');return;}
    }
  }
  curStep=n;
  document.querySelectorAll('.step').forEach(function(s){s.classList.remove('active');});
  var el=document.getElementById('step-'+n);if(el)el.classList.add('active');
  var p=n===1?33:n===2?66:100;
  document.getElementById('pfill').style.width=p+'%';
  document.getElementById('ptxt').textContent='Paso '+n+' de 3';
  document.getElementById('mbody').scrollTop=0;
}

function doSubmit(){
  clrErr();
  if(selSrc.length===0){shErr('err-src');return;}
  var btn=document.getElementById('sbtn');
  btn.classList.add('ld');btn.disabled=true;
  var payload={
    name:document.getElementById('fname').value.trim(),
    email:document.getElementById('femail').value.trim(),
    phone:(selC?selC.dial:'')+document.getElementById('fphone').value.trim(),
    country:selC?selC.name:'',
    academyType:selAc,
    size:selSz,
    source:selSrc.join(','),
    origin:'akdemiapp-web'
  };
  console.log('Lead payload:',JSON.stringify(payload,null,2));
  setTimeout(function(){
    btn.classList.remove('ld');btn.disabled=false;
    document.querySelectorAll('.step').forEach(function(s){s.classList.remove('active');});
    document.getElementById('mhdr').style.display='none';
    document.getElementById('sname').textContent=payload.name.split(' ')[0];
    document.getElementById('succ').classList.add('show');
  },1400);
}

function openModal(){
  curStep=1;selC=null;selAc=null;selSz=null;selSrc=[];
  document.getElementById('mhdr').style.display='block';
  document.getElementById('succ').classList.remove('show');
  ['fname','femail','fphone'].forEach(function(id){document.getElementById(id).value='';});
  document.getElementById('flag-area').innerHTML='<svg width="22" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>';
  document.getElementById('dcode').textContent='+';
  document.getElementById('fphone').placeholder='Selecciona país primero';
  document.getElementById('lw').style.display='none';
  buildGrid();buildAc();buildSz();buildSrc();
  goS(1);
  document.getElementById('overlay').classList.add('open');
  document.body.style.overflow='hidden';
}

function closeModal(){document.getElementById('overlay').classList.remove('open');document.body.style.overflow='';}
function ovClick(e){if(e.target===document.getElementById('overlay'))closeModal();}
function openWA(){window.open('https://wa.me/50765726078?text='+encodeURIComponent('Hola, acabo de llenar el formulario de AKDEMIApp.'),'_blank');}
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeModal();});

window.openLeadModal = openModal;
document.addEventListener('astro:page-load', () => {
  window.openLeadModal = openModal;
  document.querySelectorAll('a[href*="wa.me"]:not([data-wa-direct])').forEach(el => {
    el.addEventListener('click', e => { e.preventDefault(); openModal(); });
  });
  document.querySelectorAll('a[href*="wa.me"]:not([data-wa-direct])').forEach(el => {
    const icon = el.querySelector('svg, img, [class*="icon"]');
    if (icon) icon.outerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>';
  });
});
</script>
