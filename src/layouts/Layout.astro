---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title = "AkdemiApp - Software de Gestión para Academias y Escuelas",
  description = "Optimiza, organiza y simplifica la gestión de tu academia con AkdemiApp. Software integral para control de alumnos, profesores, pagos, horarios y más.",
  ogImage = "/og-image.jpg",
  canonical = Astro.url.pathname,
} = Astro.props;

const fullTitle = title.includes("AkdemiApp") ? title : `${title} | AkdemiApp`;
const canonicalURL = new URL(canonical, Astro.site);
---

<!doctype html>
<html lang="es" transition:animate="fade">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Fonts Preload -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- View Transitions -->
    <ClientRouter />
  </head>
  <body class="antialiased bg-white text-gray-900">
    <slot />

    <!-- ── LEAD FORM MODAL ── -->
<div class="overlay" id="overlay" onclick="ovClick(event)">
  <div class="modal" id="modal">
    <div class="mhdr" id="mhdr">
      <div class="badge"><div class="bdot"></div><span class="bname" id="bname">AKDEMIApp</span></div>
      <button class="cbtn" onclick="closeModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
      <h2 class="mtitle" id="mtitle">Agenda una demo gratuita</h2>
      <p class="msub" id="msub">Descubre cómo academias de toda Latinoamérica gestionan sus alumnos y cobros con AKDEMIApp.</p>
      <div class="pwrap"><div class="ptrack"><div class="pfill" id="pfill" style="width:33%"></div></div><span class="ptxt" id="ptxt">Paso 1 de 3</span></div>
      <div class="mdiv"></div>
    </div>
    <div class="mbody" id="mbody">

      <div class="step active" id="step-1">
        <div class="fg">
          <label class="sh">Desde dónde nos escribes</label>
          <div class="cgrid" id="cgrid"></div>
          <div class="lw" id="lw">
            <div class="lsbox">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input type="text" class="fi" id="fsearch" placeholder="Buscar país..." autocomplete="off" oninput="filterL(this.value)" onfocus="showL()">
            </div>
            <div class="ldd" id="ldd"></div>
          </div>
        </div>
        <div class="fg">
          <label class="flbl">Nombre completo</label>
          <input type="text" id="fname" class="fi" placeholder="Ej. María García">
          <div class="ferr" id="err-name">Por favor ingresa tu nombre</div>
        </div>
        <div class="fg">
          <label class="flbl">Correo electrónico</label>
          <input type="email" id="femail" class="fi" placeholder="tu@academia.com">
          <div class="ferr" id="err-email">Por favor ingresa un email válido</div>
        </div>
        <div class="fg">
          <label class="flbl">WhatsApp</label>
          <div class="prow">
            <div class="ppre" id="ppre">
              <span id="flag-area"><svg width="22" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></span>
              <span id="dcode">+</span>
            </div>
            <input type="tel" id="fphone" class="fi" placeholder="Selecciona país primero">
          </div>
          <div class="ferr" id="err-phone">Selecciona tu país e ingresa tu número</div>
        </div>
        <div class="mnav">
          <button class="bnx" onclick="goS(2)"><span class="bl">Continuar</span><span class="spin"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></button>
        </div>
      </div>

      <div class="step" id="step-2">
        <div id="sec-ac">
          <div class="fg">
            <label class="sh">Tipo de academia</label>
            <div class="pgrid" id="ac-pills"></div>
            <div id="oa-wrap" style="display:none;margin-top:10px;"><input type="text" class="fi" id="f-oa" placeholder="Describe tu tipo de academia..."></div>
            <div class="ferr" id="err-ac">Selecciona el tipo de academia</div>
          </div>
        </div>
        <div id="sec-biz" style="display:none;">
          <div class="fg">
            <label class="sh">Tipo de negocio</label>
            <div class="pgrid" id="biz-pills"></div>
            <div id="ob-wrap" style="display:none;margin-top:10px;"><input type="text" class="fi" id="f-ob" placeholder="Describe tu tipo de negocio..."></div>
            <div class="ferr" id="err-biz">Selecciona el tipo de negocio</div>
          </div>
        </div>
        <div class="fg" style="margin-top:4px;">
          <label class="sh" id="slbl">Número de alumnos activos</label>
          <div class="sgrid" id="sgrid"></div>
          <div class="ferr" id="err-size">Selecciona un rango</div>
        </div>
        <div class="mnav">
          <button class="bbk" onclick="goS(1)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Atrás</button>
          <button class="bnx" onclick="goS(3)"><span class="bl">Continuar</span><span class="spin"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></button>
        </div>
      </div>

      <div class="step" id="step-3">
        <div class="fg">
          <label class="sh">¿Cómo nos encontraste?</label>
          <div class="pgrid" id="src-pills"></div>
          <div class="ferr" id="err-src">Selecciona al menos una opción</div>
        </div>
        <div class="mnav">
          <button class="bbk" onclick="goS(2)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Atrás</button>
          <button class="bnx" id="sbtn" onclick="doSubmit()"><span class="bl" id="slbl2">Agendar demo</span><span class="spin"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.63 19.79 19.79 0 01.21 1.05 2 2 0 012.18 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.17a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.11v2.81z"/></svg></button>
        </div>
      </div>

      <div class="succ" id="succ">
        <div class="sico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--ba)"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
        <h2 class="stitle">¡Gracias, <span id="sname"></span>!</h2>
        <p class="smsg">Tu solicitud llegó con éxito. Nuestro equipo revisará tus datos y te contactará muy pronto con información personalizada.</p>
        <div class="scards">
          <div class="sc"><div class="sci"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--ba)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div><div class="scl">Tiempo de respuesta</div><div class="scv">~15 minutos</div></div>
          <div class="sc"><div class="sci"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--ba)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div><div class="scl">Canal principal</div><div class="scv">WhatsApp</div></div>
          <div class="sc"><div class="sci"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--ba)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg></div><div class="scl">Demo personalizada</div><div class="scv">30 min</div></div>
        </div>
        <button class="bwa" onclick="openWA()"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>Escribir por WhatsApp ahora</button>
      </div>

    </div>
  </div>
</div>

    <style is:global>

:root {
  --ak-p:#2563EB;--ak-a:#60A5FA;--ak-g:rgba(37,99,235,0.35);
  --po-p:#2563EB;--po-a:#60A5FA;--po-g:rgba(37,99,235,0.30);
  --bg:#080C14;--sf:rgba(255,255,255,0.04);--sfh:rgba(255,255,255,0.08);
  --bd:rgba(255,255,255,0.08);--bda:rgba(255,255,255,0.22);
  --t1:#F1F5F9;--t2:#94A3B8;--tm:#475569;
  --rs:10px;--tr:0.2s cubic-bezier(0.4,0,0.2,1);
  --bp:var(--ak-p);--ba:var(--ak-a);--bg2:var(--ak-g);
}
/* ── LIGHT THEME (AKDEMIApp) ── */
.light-modal, .light-modal * { font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important; }
.light-modal {
  --bg:#F0F6FF;
  --sf:rgba(0,0,0,0.05);--sfh:rgba(0,0,0,0.09);
  --bd:rgba(0,0,0,0.12);--bda:rgba(0,0,0,0.25);
  --t1:#0F172A;--t2:#334155;--tm:#64748B;
}
.light-modal .modal {
  background:linear-gradient(145deg,rgba(255,255,255,0.95) 0%,rgba(240,246,255,0.98) 100%);
  border-color:rgba(0,0,0,0.08);
  box-shadow:0 40px 80px rgba(0,0,0,0.15),0 0 0 1px rgba(255,255,255,0.8) inset;
}
.light-modal .overlay { background:rgba(15,23,42,0.5); }
.light-modal .fi {
  background:rgba(0,0,0,0.04);border-color:rgba(0,0,0,0.10);color:#0F172A;
}
.light-modal .fi:focus { background:#fff; }
.light-modal .fi::placeholder { color:#94A3B8; }
.light-modal .ccard,.light-modal .pill,.light-modal .scard {
  background:rgba(0,0,0,0.04);border-color:rgba(0,0,0,0.08);
}
.light-modal .ccard:hover,.light-modal .pill:hover,.light-modal .scard:hover {
  background:rgba(0,0,0,0.07);border-color:rgba(0,0,0,0.15);
}
.light-modal .cname { color:#1E293B; font-weight:600; }
.light-modal .cdial { color:#64748B; }
.light-modal .slbl { color:#64748B; }
.light-modal .snum { color:#0F172A; font-weight:700; }
.light-modal .ppre { background:rgba(0,0,0,0.05);border-color:rgba(0,0,0,0.12);color:#334155; }
.light-modal .sh { color:#475569; }
.light-modal .flbl { color:#475569; }
.light-modal .ptxt { color:#64748B; }
.light-modal .msub { color:#334155; }
.light-modal .mdiv { background:rgba(0,0,0,0.08); }
.light-modal .ptrack { background:rgba(0,0,0,0.08); }
.light-modal .cbtn { background:rgba(0,0,0,0.05);border-color:rgba(0,0,0,0.10);color:#475569; }
.light-modal .cbtn:hover { background:rgba(0,0,0,0.1);color:#0F172A; }
.light-modal .bbk { border-color:rgba(0,0,0,0.12);color:#475569; }
.light-modal .bbk:hover { background:rgba(0,0,0,0.05);color:#0F172A; }
.light-modal .sc { background:rgba(0,0,0,0.04);border-color:rgba(0,0,0,0.08); }
.light-modal .scl { color:#94A3B8; }
.light-modal .scv { color:#0F172A; }
.light-modal .smsg { color:#475569; }
.light-modal .ldd { background:#fff;border-color:rgba(0,0,0,0.12); }
.light-modal .litem:hover { background:rgba(0,0,0,0.04); }
.light-modal .ln { color:#0F172A; }
.light-modal .ld { color:#94A3B8; }
.light-modal .badge { background:rgba(37,99,235,0.08);border-color:rgba(37,99,235,0.2); }
.light-modal .ccard div[style*="rgba(0,0,0,0.08)"] { background:#E2E8F0 !important; color:#1E293B !important; font-weight:800 !important; }
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Space Grotesk',sans-serif;background:var(--bg);color:var(--t1);min-height:100vh;overflow-x:hidden}
.scene{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px 16px;
  background:radial-gradient(ellipse 60% 50% at 20% 20%,rgba(37,99,235,.12) 0%,transparent 60%),
             radial-gradient(ellipse 50% 60% at 80% 80%,rgba(5,150,105,.08) 0%,transparent 60%),#080C14}
.slabel{font-size:11px;font-weight:600;letter-spacing:2.5px;text-transform:uppercase;color:var(--tm);margin-bottom:24px}
.sbtns{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-bottom:40px}
.sbtn{display:flex;align-items:center;gap:10px;padding:12px 22px;border-radius:50px;border:1px solid var(--bd);
  background:var(--sf);color:var(--t1);font-family:inherit;font-size:13px;font-weight:600;cursor:pointer;
  transition:all var(--tr);backdrop-filter:blur(12px)}
.sbtn:hover{background:var(--sfh);border-color:var(--bda);transform:translateY(-1px)}
.sbtn.ak{border-color:rgba(37,99,235,.4)}.sbtn.ak:hover{border-color:rgba(37,99,235,.8);box-shadow:0 0 24px rgba(37,99,235,.2)}
.sbtn.po{border-color:rgba(5,150,105,.4)}.sbtn.po:hover{border-color:rgba(5,150,105,.8);box-shadow:0 0 24px rgba(5,150,105,.2)}
.sbtn svg{width:16px;height:16px}
.overlay{position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.7);backdrop-filter:blur(8px);
  display:flex;align-items:center;justify-content:center;padding:16px;
  opacity:0;pointer-events:none;transition:opacity .3s ease}
.overlay.open{opacity:1;pointer-events:all}
.modal{width:100%;max-width:520px;
  background:linear-gradient(145deg,rgba(255,255,255,.06) 0%,rgba(255,255,255,.02) 100%);
  border:1px solid var(--bd);border-radius:24px;backdrop-filter:blur(40px);
  box-shadow:0 40px 80px rgba(0,0,0,.6),0 0 0 1px rgba(255,255,255,.04) inset;
  transform:scale(.95) translateY(16px);transition:transform .35s cubic-bezier(0.34,1.56,0.64,1),opacity .3s ease;
  opacity:0;max-height:92vh;display:flex;flex-direction:column;overflow:hidden}
.overlay.open .modal{transform:scale(1) translateY(0);opacity:1}
.mhdr{padding:28px 28px 0;position:relative;flex-shrink:0}
.badge{display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:50px;border:1px solid var(--bd);background:var(--sf);margin-bottom:20px}
.bdot{width:8px;height:8px;border-radius:50%;background:var(--bp);box-shadow:0 0 8px var(--bg2);animation:pulse 2s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
.bname{font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--ba)}
.mtitle{font-family:'Playfair Display',serif;font-size:28px;font-weight:700;line-height:1.2;margin-bottom:8px}
.msub{font-size:13px;color:var(--t2);line-height:1.5;margin-bottom:22px}
.pwrap{display:flex;align-items:center;gap:8px;margin-bottom:4px}
.ptrack{flex:1;height:3px;background:var(--sfh);border-radius:99px;overflow:hidden}
.pfill{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--bp),var(--ba));transition:width .4s cubic-bezier(0.4,0,0.2,1);box-shadow:0 0 8px var(--bg2)}
.ptxt{font-size:11px;font-weight:600;color:var(--tm);white-space:nowrap}
.mdiv{height:1px;background:var(--bd);margin:18px 0 0}
.cbtn{position:absolute;top:28px;right:28px;width:32px;height:32px;border-radius:50%;border:1px solid var(--bd);
  background:var(--sf);color:var(--t2);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all var(--tr)}
.cbtn:hover{background:var(--sfh);color:var(--t1)}
.cbtn svg{width:14px;height:14px}
.mbody{padding:22px 28px 28px;overflow-y:auto;flex:1}
.mbody::-webkit-scrollbar{width:4px}
.mbody::-webkit-scrollbar-thumb{background:var(--bd);border-radius:99px}
.step{display:none}.step.active{display:block;animation:si .3s cubic-bezier(0.4,0,0.2,1)}
@keyframes si{from{opacity:0;transform:translateX(12px)}to{opacity:1;transform:translateX(0)}}
.fg{margin-bottom:16px}
.flbl{display:block;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--tm);margin-bottom:8px}
.fi{width:100%;padding:13px 16px;background:var(--sf);border:1px solid var(--bd);border-radius:var(--rs);
  color:var(--t1);font-family:inherit;font-size:14px;transition:all var(--tr);outline:none}
.fi:focus{border-color:var(--bp);background:rgba(255,255,255,.06);box-shadow:0 0 0 3px var(--bg2)}
.fi::placeholder{color:var(--tm)}.fi.err{border-color:#F87171}
.ferr{font-size:11px;color:#F87171;margin-top:6px;display:none}
.prow{display:flex;gap:10px}
.ppre{display:flex;align-items:center;gap:8px;padding:13px 14px;background:var(--sf);border:1px solid var(--bd);
  border-radius:var(--rs);font-size:14px;color:var(--t2);white-space:nowrap;min-width:96px}
.ppre img{border-radius:3px}
.prow .fi{flex:1}
.cgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.ccard{display:flex;flex-direction:column;align-items:center;gap:6px;padding:12px 8px;
  background:var(--sf);border:1px solid var(--bd);border-radius:var(--rs);cursor:pointer;transition:all var(--tr);text-align:center}
.ccard:hover{background:var(--sfh);border-color:var(--bda);transform:translateY(-1px)}
.ccard.sel{border-color:var(--bp);background:rgba(37,99,235,.1);box-shadow:0 0 12px var(--bg2)}
.po-brand .ccard.sel{border-color:var(--po-p);background:rgba(5,150,105,.1);box-shadow:0 0 12px var(--po-g)}
.ccard img{width:36px;height:27px;border-radius:4px;object-fit:cover}
.ccard .cflag{width:36px;height:27px;display:flex;align-items:center;justify-content:center}
.cname{font-size:11px;font-weight:600;color:var(--t2);line-height:1.2}
.cdial{font-size:10px;color:var(--tm)}
.lw{display:none;margin-top:10px;position:relative}
.lsbox{position:relative}
.lsbox svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);pointer-events:none}
.lsbox .fi{padding-left:42px}
.ldd{display:none;position:absolute;top:calc(100% + 6px);left:0;right:0;z-index:999;
  background:#111827;border:1px solid var(--bda);border-radius:var(--rs);max-height:220px;overflow-y:auto;
  box-shadow:0 16px 40px rgba(0,0,0,.5)}
.ldd::-webkit-scrollbar{width:4px}
.ldd::-webkit-scrollbar-thumb{background:var(--bd);border-radius:99px}
.litem{display:flex;align-items:center;gap:10px;padding:10px 14px;cursor:pointer;transition:background .15s;font-size:14px}
.litem:hover{background:rgba(255,255,255,.06)}
.litem img{width:28px;height:21px;border-radius:3px;object-fit:cover;flex-shrink:0}
.litem .ln{flex:1;color:var(--t1);font-weight:500}
.litem .ld{color:var(--tm);font-size:12px}
.pgrid{display:flex;flex-wrap:wrap;gap:8px}
.pill{display:flex;align-items:center;gap:6px;padding:8px 14px;background:var(--sf);border:1px solid var(--bd);
  border-radius:50px;cursor:pointer;font-size:13px;font-weight:500;color:var(--t2);transition:all var(--tr);user-select:none}
.pill:hover{background:var(--sfh);color:var(--t1)}
.pill.sel{border-color:var(--bp);background:rgba(37,99,235,.1);color:var(--ba)}
.po-brand .pill.sel{border-color:var(--po-p);background:rgba(5,150,105,.1);color:var(--po-a)}
.chk{width:16px;height:16px;border-radius:50%;border:1.5px solid currentColor;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all var(--tr)}
.pill.sel .chk{background:var(--bp);border-color:var(--bp)}
.po-brand .pill.sel .chk{background:var(--po-p);border-color:var(--po-p)}
.chk svg{display:none;width:10px;height:10px}
.pill.sel .chk svg{display:block}
.sgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}
.scard{padding:14px;background:var(--sf);border:1px solid var(--bd);border-radius:var(--rs);cursor:pointer;transition:all var(--tr)}
.scard:hover{background:var(--sfh);transform:translateY(-1px)}
.scard.sel{border-color:var(--bp);background:rgba(37,99,235,.1)}
.po-brand .scard.sel{border-color:var(--po-p);background:rgba(5,150,105,.1)}
.snum{font-size:22px;font-weight:700;margin-bottom:2px}
.scard.sel .snum{color:var(--ba)}
.po-brand .scard.sel .snum{color:var(--po-a)}
.slbl{font-size:11px;color:var(--tm)}
.sh{font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--tm);margin-bottom:12px}
.mnav{display:flex;gap:10px;margin-top:22px}
.bbk{padding:13px 20px;border-radius:var(--rs);border:1px solid var(--bd);background:transparent;color:var(--t2);
  font-family:inherit;font-size:13px;font-weight:600;cursor:pointer;transition:all var(--tr);display:flex;align-items:center;gap:6px}
.bbk:hover{background:var(--sf);color:var(--t1)}
.bnx{flex:1;padding:13px 20px;border-radius:var(--rs);border:none;
  background:linear-gradient(135deg,var(--bp),var(--ba));color:#fff;
  font-family:inherit;font-size:14px;font-weight:700;cursor:pointer;transition:all var(--tr);
  display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 4px 20px var(--bg2)}
.bnx:hover{transform:translateY(-1px);box-shadow:0 8px 30px var(--bg2);filter:brightness(1.1)}
.bnx svg{width:16px;height:16px}
.spin{width:16px;height:16px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:sp .7s linear infinite;display:none}
@keyframes sp{to{transform:rotate(360deg)}}
.bnx.ld .spin{display:block}.bnx.ld .bl{display:none}.bnx.ld svg{display:none}
.succ{display:none;text-align:center;padding:8px 0 16px}
.succ.show{display:block;animation:si .4s cubic-bezier(0.4,0,0.2,1)}
.sico{width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,rgba(37,99,235,.2),rgba(96,165,250,.1));
  border:1px solid rgba(37,99,235,.3);display:flex;align-items:center;justify-content:center;margin:0 auto 24px;
  box-shadow:0 0 40px rgba(37,99,235,.2);animation:pop .5s cubic-bezier(0.34,1.56,0.64,1)}
.po-brand .sico{background:linear-gradient(135deg,rgba(5,150,105,.2),rgba(52,211,153,.1));border-color:rgba(5,150,105,.3);box-shadow:0 0 40px rgba(5,150,105,.2)}
@keyframes pop{from{transform:scale(0);opacity:0}to{transform:scale(1);opacity:1}}
.sico svg{width:36px;height:36px}
.stitle{font-family:'Playfair Display',serif;font-size:26px;font-weight:700;margin-bottom:10px}
.smsg{font-size:14px;color:var(--t2);line-height:1.6;max-width:380px;margin:0 auto 28px}
.scards{display:flex;gap:10px;margin-bottom:24px}
.sc{flex:1;padding:14px;background:var(--sf);border:1px solid var(--bd);border-radius:var(--rs);text-align:center}
.sci{display:flex;align-items:center;justify-content:center;height:30px;margin-bottom:8px}
.scl{font-size:10px;color:var(--tm);font-weight:600;letter-spacing:.5px}
.scv{font-size:13px;font-weight:700;color:var(--t1);margin-top:2px}
.bwa{width:100%;padding:14px;border-radius:var(--rs);border:none;background:linear-gradient(135deg,#25D366,#128C7E);color:#fff;
  font-family:inherit;font-size:14px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;
  box-shadow:0 4px 20px rgba(37,211,102,.25);transition:all var(--tr)}
.bwa:hover{transform:translateY(-1px);box-shadow:0 8px 30px rgba(37,211,102,.35)}
.bwa svg{width:20px;height:20px}

    </style>

    <script is:inline>
var brand='ak',curStep=1,selC=null,selAc=null,selBz=null,selSz=null,selSrc=[];

var MC=[
  {code:'PA',name:'Panamá',     dial:'+507',digits:8, ph:'6000-0000'},
  {code:'MX',name:'México',     dial:'+52', digits:10,ph:'55 1234 5678'},
  {code:'CO',name:'Colombia',   dial:'+57', digits:10,ph:'310 123 4567'},
  {code:'CR',name:'Costa Rica', dial:'+506',digits:8, ph:'8000-0000'},
  {code:'GT',name:'Guatemala',  dial:'+502',digits:8, ph:'5000-0000'},
  {code:'PE',name:'Perú',       dial:'+51', digits:9, ph:'987 654 321'},
  {code:'CL',name:'Chile',      dial:'+56', digits:9, ph:'9 1234 5678'},
  {code:'AR',name:'Argentina',  dial:'+54', digits:10,ph:'11 1234-5678'},
  {code:'OTHER',name:'Otro',    dial:'+',   digits:0, ph:'Número de teléfono'}
];

var LC=[
  {code:'SV',name:'El Salvador',      dial:'+503',digits:8, ph:'7000-0000'},
  {code:'HN',name:'Honduras',         dial:'+504',digits:8, ph:'9000-0000'},
  {code:'NI',name:'Nicaragua',        dial:'+505',digits:8, ph:'8000-0000'},
  {code:'BZ',name:'Belice',           dial:'+501',digits:7, ph:'600-0000'},
  {code:'VE',name:'Venezuela',        dial:'+58', digits:10,ph:'412 000 0000'},
  {code:'EC',name:'Ecuador',          dial:'+593',digits:9, ph:'99 000 0000'},
  {code:'BO',name:'Bolivia',          dial:'+591',digits:8, ph:'7000 0000'},
  {code:'PY',name:'Paraguay',         dial:'+595',digits:9, ph:'981 000 000'},
  {code:'UY',name:'Uruguay',          dial:'+598',digits:8, ph:'9000 0000'},
  {code:'BR',name:'Brasil',           dial:'+55', digits:11,ph:'11 9 0000-0000'},
  {code:'CU',name:'Cuba',             dial:'+53', digits:8, ph:'5000-0000'},
  {code:'DO',name:'Rep. Dominicana',  dial:'+1',  digits:10,ph:'809 000 0000'},
  {code:'PR',name:'Puerto Rico',      dial:'+1',  digits:10,ph:'787 000 0000'},
  {code:'HT',name:'Haití',            dial:'+509',digits:8, ph:'3000-0000'},
  {code:'JM',name:'Jamaica',          dial:'+1',  digits:10,ph:'876 000 0000'},
  {code:'TT',name:'Trinidad y Tobago',dial:'+1',  digits:10,ph:'868 000 0000'},
  {code:'GY',name:'Guyana',           dial:'+592',digits:7, ph:'600 0000'},
  {code:'SR',name:'Surinam',          dial:'+597',digits:7, ph:'700-0000'},
  {code:'US',name:'Estados Unidos',   dial:'+1',  digits:10,ph:'305 000 0000'},
  {code:'ES',name:'España',           dial:'+34', digits:9, ph:'600 000 000'}
];

var ACS=['Danza','Artes Marciales','Yoga','Pilates','Música','Teatro','Natación','Gimnasia','Crossfit','Idiomas','Deportes','Otra'];
var BZS=['Restaurante','Retail / Tienda','Servicios Profesionales','Logística','Salud / Clínica','Educación','Construcción','Otro'];
var SZS=[{v:'1-30',l:'1 – 30'},{v:'31-80',l:'31 – 80'},{v:'81-200',l:'81 – 200'},{v:'200+',l:'200+'}];
var SRS=['Google','Instagram','WhatsApp','Referido','Facebook','Otro'];

function fi(){ return null; } // not used
function flagBadge(code, size) {
  if (code === 'OTHER') {
    return '<div style="width:'+size+'px;height:'+Math.round(size*0.75)+'px;display:flex;align-items:center;justify-content:center;"><svg width="'+(size-4)+'" height="'+(size-4)+'" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#64748b\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"2\" y1=\"12\" x2=\"22\" y2=\"12\"/><path d=\"M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z\"/></svg></div>';
  }
  var s = size === 36 ? '13px' : '11px';
  var isLight = document.getElementById('overlay').classList.contains('light-modal');
  var bg = isLight ? '#CBD5E1' : 'rgba(255,255,255,0.08)';
  var color = isLight ? '#1E293B' : '#94A3B8';
  return '<div style="width:'+size+'px;height:'+Math.round(size*0.75)+'px;background:'+bg+';border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:'+s+';font-weight:800;letter-spacing:0.5px;color:'+color+';font-family:inherit;">'+code+'</div>';
}

function buildGrid(){
  var g=document.getElementById('cgrid'); g.innerHTML='';
  MC.forEach(function(c){
    var d=document.createElement('div'); d.className='ccard'; d.setAttribute('data-c',c.code);
    d.innerHTML=flagBadge(c.code,36)+'<span class="cname">'+c.name+'</span><span class="cdial">'+c.dial+'</span>';
    d.onclick=function(){ pickC(c); };
    g.appendChild(d);
  });
}

function pickC(c){
  selC=c;
  document.querySelectorAll('.ccard').forEach(function(el){ el.classList.toggle('sel',el.getAttribute('data-c')===c.code); });
  document.getElementById('flag-area').innerHTML=flagBadge(c.code,28);
  document.getElementById('dcode').textContent=c.dial;
  var ph=document.getElementById('fphone');
  ph.placeholder=c.ph;
  ph.maxLength=c.digits>0?c.digits+5:20;
  var lw=document.getElementById('lw');
  lw.style.display=c.code==='OTHER'?'block':'none';
  if(c.code==='OTHER'){ document.getElementById('fsearch').value=''; renderL(''); }
}

function renderL(q){
  var dd=document.getElementById('ldd'); dd.innerHTML='';
  var fl=LC.filter(function(c){ return !q||c.name.toLowerCase().indexOf(q.toLowerCase())>=0; });
  fl.forEach(function(c){
    var it=document.createElement('div'); it.className='litem';
    var u=fi(c.code,'24x18');
    it.innerHTML=flagBadge(c.code,28)+'<span class="ln">'+c.name+'</span><span class="ld">'+c.dial+'</span>';
    it.onclick=function(){
      selC=c;
      document.getElementById('fsearch').value=c.name;
      dd.style.display='none';
      var fa=document.getElementById('flag-area');
      fa.innerHTML=flagBadge(c.code,28);
      document.getElementById('dcode').textContent=c.dial;
      var ph=document.getElementById('fphone'); ph.placeholder=c.ph; ph.maxLength=c.digits+5;
    };
    dd.appendChild(it);
  });
  dd.style.display=fl.length>0?'block':'none';
}

function filterL(v){ renderL(v); }
function showL(){ renderL(document.getElementById('fsearch').value); }

document.addEventListener('click',function(e){
  var lw=document.getElementById('lw');
  if(lw&&!lw.contains(e.target)){ var dd=document.getElementById('ldd'); if(dd) dd.style.display='none'; }
});

function mkPill(label,onTgl){
  var p=document.createElement('div'); p.className='pill';
  p.innerHTML='<div class="chk"><svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>'+label;
  p.onclick=onTgl; return p;
}

function buildAc(){
  var g=document.getElementById('ac-pills'); g.innerHTML='';
  ACS.forEach(function(t){
    var p=mkPill(t,function(){
      document.querySelectorAll('#ac-pills .pill').forEach(function(x){ x.classList.remove('sel'); });
      p.classList.add('sel'); selAc=t;
      document.getElementById('oa-wrap').style.display=t==='Otra'?'block':'none';
    }); g.appendChild(p);
  });
}

function buildBz(){
  var g=document.getElementById('biz-pills'); g.innerHTML='';
  BZS.forEach(function(t){
    var p=mkPill(t,function(){
      document.querySelectorAll('#biz-pills .pill').forEach(function(x){ x.classList.remove('sel'); });
      p.classList.add('sel'); selBz=t;
      document.getElementById('ob-wrap').style.display=t==='Otro'?'block':'none';
    }); g.appendChild(p);
  });
}

function buildSz(){
  var g=document.getElementById('sgrid'); g.innerHTML='';
  SZS.forEach(function(s){
    var d=document.createElement('div'); d.className='scard';
    d.innerHTML='<div class="snum">'+s.l+'</div><div class="slbl">'+(brand==='po'?'Colaboradores':'Alumnos')+'</div>';
    d.onclick=function(){
      document.querySelectorAll('.scard').forEach(function(x){ x.classList.remove('sel'); });
      d.classList.add('sel'); selSz=s.v;
    }; g.appendChild(d);
  });
}

function buildSrc(){
  var g=document.getElementById('src-pills'); g.innerHTML='';
  SRS.forEach(function(s){
    var p=mkPill(s,function(){
      p.classList.toggle('sel');
      if(p.classList.contains('sel')){ if(selSrc.indexOf(s)<0) selSrc.push(s); }
      else { selSrc=selSrc.filter(function(x){ return x!==s; }); }
    }); g.appendChild(p);
  });
}

function clrErr(){
  document.querySelectorAll('.ferr').forEach(function(e){ e.style.display='none'; });
  document.querySelectorAll('.fi').forEach(function(i){ i.classList.remove('err'); });
}
function shErr(id){ var e=document.getElementById(id); if(e) e.style.display='block'; }

function goS(n){
  clrErr();
  if(n>curStep){
    if(curStep===1){
      if(!selC){ shErr('err-phone'); return; }
      if(!document.getElementById('fname').value.trim()){ shErr('err-name'); document.getElementById('fname').classList.add('err'); return; }
      var em=document.getElementById('femail').value.trim();
      if(!em||em.indexOf('@')<0){ shErr('err-email'); document.getElementById('femail').classList.add('err'); return; }
      if(!document.getElementById('fphone').value.trim()){ shErr('err-phone'); document.getElementById('fphone').classList.add('err'); return; }
    }
    if(curStep===2){
      if(brand==='ak'&&!selAc){ shErr('err-ac'); return; }
      if(brand==='po'&&!selBz){ shErr('err-biz'); return; }
      if(!selSz){ shErr('err-size'); return; }
    }
  }
  curStep=n;
  document.querySelectorAll('.step').forEach(function(s){ s.classList.remove('active'); });
  var el=document.getElementById('step-'+n); if(el) el.classList.add('active');
  var p=n===1?33:n===2?66:100;
  document.getElementById('pfill').style.width=p+'%';
  document.getElementById('ptxt').textContent='Paso '+n+' de 3';
  document.getElementById('mbody').scrollTop=0;
}

function doSubmit(){
  clrErr();
  if(selSrc.length===0){ shErr('err-src'); return; }
  var btn=document.getElementById('sbtn');
  btn.classList.add('ld'); btn.disabled=true;
  var payload={
    name:document.getElementById('fname').value.trim(),
    email:document.getElementById('femail').value.trim(),
    phone:(selC?selC.dial:'')+document.getElementById('fphone').value.trim(),
    country:selC?selC.name:'',
    academyType:brand==='ak'?selAc:null,
    businessType:brand==='po'?selBz:null,
    size:selSz,source:selSrc.join(','),
    origin:brand==='ak'?'akdemiapp-web':'procesoptimo-web'
  };
  console.log('CRM Payload:',JSON.stringify(payload,null,2));
  setTimeout(function(){
    btn.classList.remove('ld'); btn.disabled=false;
    document.querySelectorAll('.step').forEach(function(s){ s.classList.remove('active'); });
    document.getElementById('mhdr').style.display='none';
    document.getElementById('sname').textContent=payload.name.split(' ')[0];
    document.getElementById('succ').classList.add('show');
  },1400);
}

function openModal(b){
  brand=b; curStep=1;
  selC=null; selAc=null; selBz=null; selSz=null; selSrc=[];
  var isPO=b==='po';
  document.documentElement.style.setProperty('--bp',isPO?'var(--po-p)':'var(--ak-p)');
  document.documentElement.style.setProperty('--ba',isPO?'var(--po-a)':'var(--ak-a)');
  document.documentElement.style.setProperty('--bg2',isPO?'var(--po-g)':'var(--ak-g)');
  var ov=document.getElementById('overlay');
  if(isPO){ ov.classList.remove('light-modal'); } else { ov.classList.add('light-modal'); }
  document.getElementById('modal').className='modal'+(isPO?' po-brand':'');
  document.getElementById('bname').textContent=isPO?'ProcesOptimo':'AKDEMIApp';
  document.getElementById('mtitle').textContent=isPO?'Solicita tu solución personalizada':'Agenda una demo gratuita';
  document.getElementById('msub').textContent=isPO
    ?'Cuéntanos sobre tu negocio y te presentamos la mejor solución para optimizar tus procesos.'
    :'Descubre cómo academias de toda Latinoamérica gestionan sus alumnos y cobros con AKDEMIApp.';
  document.getElementById('slbl2').textContent=isPO?'Solicitar información':'Agendar demo';
  document.getElementById('sec-ac').style.display=isPO?'none':'block';
  document.getElementById('sec-biz').style.display=isPO?'block':'none';
  document.getElementById('slbl').textContent=isPO?'Número de colaboradores':'Número de alumnos activos';
  document.getElementById('mhdr').style.display='block';
  document.getElementById('succ').classList.remove('show');
  ['fname','femail','fphone'].forEach(function(id){ document.getElementById(id).value=''; });
  document.getElementById('flag-area').innerHTML='<svg width="22" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1 4-10z"/></svg>';
  document.getElementById('dcode').textContent='+';
  document.getElementById('fphone').placeholder='Selecciona país primero';
  document.getElementById('lw').style.display='none';
  buildGrid(); buildAc(); buildBz(); buildSz(); buildSrc();
  goS(1);
  document.getElementById('overlay').classList.add('open');
  document.body.style.overflow='hidden';
}

function closeModal(){ document.getElementById('overlay').classList.remove('open'); document.body.style.overflow=''; }
function ovClick(e){ if(e.target===document.getElementById('overlay')) closeModal(); }
function openWA(){ window.open('https://wa.me/50760000000?text='+encodeURIComponent('Hola, acabo de llenar el formulario de '+(brand==='ak'?'AKDEMIApp':'ProcesOptimo')+'.'), '_blank'); }
document.addEventListener('keydown',function(e){ if(e.key==='Escape') closeModal(); });
      window.openLeadModal = function() { openModal('ak'); };
    </script>
